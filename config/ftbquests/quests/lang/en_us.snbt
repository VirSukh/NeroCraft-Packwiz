	]
	task.1F62C954B39E7A2D.title: "Sezione completata"
	quest.4B5188C019C64243.title: "Cacciatori leggendari"
	quest.4B5188C019C64243.quest_subtitle: "Tutto il bestiario"
	quest.4B5188C019C64243.quest_desc: [
		"Non esiste creatura che la colonia non abbia affrontato."
		"&6Le vostre gesta resteranno negli archivi della colonia."
	]
	task.2035D176C9B364F5.title: "Bestiario completo"
	chapter.5493492EEC039526.title: "Twilight Forest"
	chapter.5493492EEC039526.chapter_subtitle: [
		"Il bosco eterno del crepuscolo e i suoi otto guardiani"
	]
	quest.66589EC2CBA3DCC0.title: "Il portale del Crepuscolo"
	quest.66589EC2CBA3DCC0.quest_subtitle: "Un diamante nell'acqua"
	quest.66589EC2CBA3DCC0.quest_desc: [
		"&7&oUna pozza tra i fiori, un diamante gettato dentro: il bosco si apre.&r"
		"Scavate una pozza d'acqua &e2x2&r circondata da erba, piantate fiori o erba alta tutt'intorno e lanciateci dentro un &6diamante&r."
		"&cOgni zona della Twilight Forest si sblocca battendo il boss precedente&r: seguite l'ordine di questo capitolo."
	]
	quest.24E243C3364B4621.title: "La mappa magica"
	quest.24E243C3364B4621.quest_subtitle: "Dove dormono i boss"
	quest.24E243C3364B4621.quest_desc: [
		"Piuma di corvo, Bacche luminescenti e polvere di luminite danno la &6Messa a fuoco della mappa magica&r."
		"Circondatela di carta: la mappa mostra i biomi e le strutture dei boss attorno a voi."
	]
	quest.6FFD36082FDFC14B.title: "La Naga"
	quest.6FFD36082FDFC14B.quest_subtitle: "Il serpente del cortile"
	quest.6FFD36082FDFC14B.quest_desc: [
		"&7&oNel cortile di pietra serpeggia il primo guardiano.&r"
		"Cercate il cortile di nagapietra e affrontate la &6Naga&r in gruppo: carica in linea retta, schivatela di lato."
		"&eOgnuno colpisca il boss almeno una volta&r: le zone successive si aprono solo a chi ha combattuto."
	]
	quest.7E4FDE0E813775EA.title: "Il Lich"
	quest.7E4FDE0E813775EA.quest_subtitle: "La torre degli inganni"
	quest.7E4FDE0E813775EA.quest_desc: [
		"&7&oIn cima alla torre, uno stregone e le sue copie.&r"
		"Il &6Lich&r si sdoppia in ombre: colpite quella vera, respingete le sfere e abbattete i suoi scudi."
		"Lascia gli &6scettri&r. Battuto il Lich si aprono la &eForesta Oscura&r e la &eForesta Innevata&r."
	]
	quest.60BCEED98FE388BB.title: "Il Labirinto"
	quest.60BCEED98FE388BB.quest_subtitle: "Minotauri e il Fungotauro"
	quest.60BCEED98FE388BB.quest_desc: [
		"&7&oSotto la palude, corridoi di pietra e passi pesanti.&r"
		"Nel Labirinto vivono i &6Minotauri&r; in fondo aspetta il &6Fungotauro&r."
		"Lascia la &6Mistecca Stroganoff&r: &eognuno ne mangi una&r per aprire la Palude di Fuoco."
	]
	quest.13A996519D256597.title: "Squadra contro l'Idra"
	quest.13A996519D256597.quest_subtitle: "Tre teste, tre ruoli"
	quest.13A996519D256597.quest_desc: [
		"&7&oLa palude brucia. Si contano pozioni e frecce.&r"
		"L'&6Idra&r ha tre teste: &adividetevi&r tra chi attira il fuoco, chi cura e chi colpisce le teste aperte."
		"Pozioni di resistenza al fuoco per tutti: la Palude di Fuoco brucia anche fuori dalla tana."
	]
	task.5B761CF2EC830A8E.title: "Ruoli decisi, resistenza al fuoco pronta"
	quest.19733F133E3766CC.title: "L'Idra"
	quest.19733F133E3766CC.quest_subtitle: "La tana nella Palude di Fuoco"
	quest.19733F133E3766CC.quest_desc: [
		"&7&oLe teste ricrescono finché il corpo non cade.&r"
		"Colpite le teste quando aprono la bocca, poi il corpo."
		"Lascia il &6Sangue ardente&r: ferro e sangue danno i &6Lingotti ardenti&r."
	]
	quest.2F27426A38C92198.title: "Il Piedistallo dei Trofei"
	quest.2F27426A38C92198.quest_subtitle: "Le porte della Roccaforte"
	quest.2F27426A38C92198.quest_desc: [
		"&7&oUn trofeo sul piedistallo, e la pietra si apre.&r"
		"Nella &eForesta Oscura&r trovate la Roccaforte dei Cavalieri e posate un &6trofeo di boss&r sul Piedistallo dei Trofei."
		"&cDentro i cavalieri sono duri&r: armature buone e cibo per tutti."
	]
	quest.557BDAA84AE6EAD1.title: "I Cavalieri Fantasma"
	quest.557BDAA84AE6EAD1.quest_subtitle: "Sei spettri in armatura"
	quest.557BDAA84AE6EAD1.quest_desc: [
		"&7&oNella sala più profonda, sei armature si alzano insieme.&r"
		"Abbattete &6tutti i Cavalieri Fantasma&r: girano attorno al gruppo, tenetevi spalla a spalla."
		"Battuti i cavalieri si apre il cuore della Foresta Oscura e la sua Torre."
	]
	quest.57F3A6739914A0B6.title: "L'Ur-Ghast"
	quest.57F3A6739914A0B6.quest_subtitle: "In cima alla Torre Oscura"
	quest.57F3A6739914A0B6.quest_desc: [
		"&7&oIl pianto del Ghast primordiale fa tremare la torre.&r"
		"Salite la &eTorre Oscura&r tra ascensori e golem di carminite. In cima, l'&6Ur-Ghast&r."
		"Colpitelo quando scende sulle trappole per ghast. Lascia le &6Lacrime ardenti&r."
	]
	quest.364D46D5A4463169.title: "Lo Yeti Alfa"
	quest.364D46D5A4463169.quest_subtitle: "La grotta nella Foresta Innevata"
	quest.364D46D5A4463169.quest_desc: [
		"&7&oDal soffitto della grotta cadono stalattiti di ghiaccio.&r"
		"Lo &6Yeti Alfa&r salta e fa crollare il ghiaccio: muovetevi sparpagliati."
		"Lascia la &6Pelliccia di Alpha Yeti&r e apre il &eGhiacciaio&r."
	]
	quest.71E1FE9D19F16052.title: "La Regina delle Nevi"
	quest.71E1FE9D19F16052.quest_subtitle: "Il Palazzo dell'Aurora"
	quest.71E1FE9D19F16052.quest_desc: [
		"&7&oIn cima al palazzo di ghiaccio, la Regina e i suoi cristalli.&r"
		"Distruggete i cristalli che la proteggono, poi colpite la &6Regina delle Nevi&r."
		"&cIl Ghiacciaio congela chi non è pronto&r: vestiti caldi e cibo."
	]
	quest.7A033F97AA773E7B.title: "Gli Altopiani"
	quest.7A033F97AA773E7B.quest_subtitle: "Tre guardiani, una strada"
	quest.7A033F97AA773E7B.quest_desc: [
		"&7&oIdra, Ur-Ghast e Regina sono caduti: la pioggia acida si ritira.&r"
		"Si aprono gli &eAltopiani&r. Nelle grotte dei troll si nasconde la strada per la fine."
	]
	quest.3CBAC7A42AAAE9F5.title: "La Lampada delle Ceneri"
	quest.3CBAC7A42AAAE9F5.quest_subtitle: "Fuoco contro le spine"
	quest.3CBAC7A42AAAE9F5.quest_desc: [
		"Nelle grotte dei troll, sotto gli Altopiani, c'è la &6Lampada delle ceneri&r."
		"Brucia i rovi che sbarrano la strada verso l'altopiano finale."
	]
	quest.2BE5F3526A120E83.title: "Tra i giganti"
	quest.2BE5F3526A120E83.quest_subtitle: "Fagioli magici"
	quest.2BE5F3526A120E83.quest_desc: [
		"I troll lasciano i &6Fagioli magici&r: piantateli e salite fino alle nuvole."
		"Lassù vivono i giganti. Battete un &6Minatore gigante&r."
	]
	quest.1271580A23B689F2.title: "&6&lFine dei Giochi&r"
	quest.1271580A23B689F2.quest_subtitle: "L'altopiano finale"
	quest.1271580A23B689F2.quest_desc: [
		"&7&oIn cima al mondo del crepuscolo, un castello senza re.&r"
		"Raggiungete l'&eAltopiano finale&r e il suo castello: qui finisce la storia della Twilight Forest."
	]
	quest.5FF9AE4AE7F30828.title: "Ferro ligneo"
	quest.5FF9AE4AE7F30828.quest_subtitle: "Radici e ferro"
	quest.5FF9AE4AE7F30828.quest_desc: [
		"&6Radice viva&r, ferro grezzo e una pepita d'oro danno il Ferro ligneo grezzo: fondetelo in lingotti."
		"Attrezzi e armature di ferro ligneo si riparano da soli col tempo."
	]
	quest.449AD9C35B6F0820.title: "Fogliacciaio"
	quest.449AD9C35B6F0820.quest_subtitle: "Foglie dure come l'acciaio"
	quest.449AD9C35B6F0820.quest_desc: [
		"Il &6Fogliacciaio&r si trova nei forzieri delle colline cave e delle strutture del Crepuscolo."
		"Attrezzi leggeri con incantesimi già pronti."
	]
	quest.3B769D6F7070FE58.title: "Armatura di Naga"
	quest.3B769D6F7070FE58.quest_subtitle: "Scaglie che resistono"
	quest.3B769D6F7070FE58.quest_desc: [
		"Con le &6Scaglie di Naga&r si craftano corazza e gambali."
		"Leggeri e resistenti: buoni per chi sta in prima fila."
	]
	quest.6256B2D89475ED20.title: "Pelliccia artica"
	quest.6256B2D89475ED20.quest_subtitle: "Vestiti per la neve"
	quest.6256B2D89475ED20.quest_desc: [
		"Gli Yeti della Foresta Innevata lasciano la &6Pelliccia artica&r."
		"Con la pelliccia si cuce l'armatura artica, comoda nel freddo."
	]
	quest.6D4B56D8F4C18F39.title: "Rompi-labirinto"
	quest.6D4B56D8F4C18F39.quest_subtitle: "Il piccone dei corridoi"
	quest.6D4B56D8F4C18F39.quest_desc: [
		"Nel tesoro del Labirinto si trova il &6Rompi-labirinto&r: spacca la pietra del labirinto in un attimo."
	]
	quest.65ECC1971F2BAF2E.title: "Metallo del cavaliere"
	quest.65ECC1971F2BAF2E.quest_subtitle: "Frammenti d'armatura"
	quest.65ECC1971F2BAF2E.quest_desc: [
		"I mostri della Roccaforte lasciano &6Frammenti d'armatura&r: nove fanno un Ammasso."
		"Fondete l'Ammasso: esce un &6Lingotto di metallo del cavaliere&r."
	]
	quest.13D39D089C19B9E5.title: "Armatura Yeti"
	quest.13D39D089C19B9E5.quest_subtitle: "Il pelo dello Yeti Alfa"
	quest.13D39D089C19B9E5.quest_desc: [
		"La &6Pelliccia di Alpha Yeti&r diventa un'armatura che rallenta chi vi colpisce."
		"Dividete le pellicce: lo Yeti Alfa ne lascia di più se il gruppo è numeroso."
	]
	quest.6A4127FE3F22DF51.title: "Lingotti ardenti"
	quest.6A4127FE3F22DF51.quest_subtitle: "Sangue e lacrime di fuoco"
	quest.6A4127FE3F22DF51.quest_desc: [
		"&6Sangue ardente&r dell'Idra (o &6Lacrime ardenti&r dell'Ur-Ghast) e un lingotto di ferro: un &6Lingotto ardente&r."
	]
	quest.7723D9642610DB22.title: "Equipaggiamento ardente"
	quest.7723D9642610DB22.quest_subtitle: "Forgiato nel fuoco"
	quest.7723D9642610DB22.quest_desc: [
		"Un'arma o un piccone ardente e un pezzo di armatura ardente."
		"Gli attrezzi ardenti fondono ciò che scavano; l'armatura protegge dal fuoco."
	]
	chapter.60EE115275694EA1.title: "Esplorazione"
	chapter.60EE115275694EA1.chapter_subtitle: [
		"Biomi, strutture, Nether, profondità ed End"
	]
	quest.3A382BED9C031243.title: "Terre mai viste"
	quest.3A382BED9C031243.quest_subtitle: "La bussola della natura"
	quest.3A382BED9C031243.quest_desc: [
		"Al primo accesso avete ricevuto la &6Bussola della Natura&r: scegli un bioma e ti indica la strada."
		"Il mondo è pieno di biomi nuovi (&aOh The Biomes We've Gone&r): andate a vederne uno."
	]
	quest.1F3055D27AC5C14E.title: "La mappa di squadra"
	quest.1F3055D27AC5C14E.quest_subtitle: "Carta e bussola"
	quest.1F3055D27AC5C14E.quest_desc: [
		"Una mappa riempita e un tavolo da cartografia per copiarla."
		"Fate una copia per ognuno e segnate la colonia: chi si perde torna a casa."
	]
	quest.140F829A8802C3D6.title: "Villaggi e mercanti"
	quest.140F829A8802C3D6.quest_subtitle: "Smeraldi in cambio di tutto"
	quest.140F829A8802C3D6.quest_desc: [
		"Trovate un villaggio e fate il primo scambio."
		"Il &6Cartografo&r vende mappe del tesoro e delle strutture: utili per le prossime quest."
	]
	quest.2A8E428F3FD6C579.title: "Bottino per tutti"
	quest.2A8E428F3FD6C579.quest_subtitle: "Ognuno il suo forziere"
	quest.2A8E428F3FD6C579.quest_desc: [
		"Con &aLootr&r ogni forziere delle strutture ha un bottino &adiverso per ogni giocatore&r."
		"Non litigate: aprite tutti, ognuno prende il suo."
	]
	quest.29B45C7C5613EBD9.title: "Stanze dei mostri"
	quest.29B45C7C5613EBD9.quest_subtitle: "Dungeon sotterranei"
	quest.29B45C7C5613EBD9.quest_desc: [
		"Sottoterra ci sono dungeon più grandi del solito, con generatori di mostri."
		"Entrate in una stanza dei mostri: torce sui generatori, poi il bottino."
	]
	quest.194AF34EDCEA0863.title: "Miniere abbandonate"
	quest.194AF34EDCEA0863.quest_subtitle: "Binari nel buio"
	quest.194AF34EDCEA0863.quest_desc: [
		"Le miniere abbandonate sono enormi e piene di carrelli con forziere."
		"Aprite un carrello con forziere: anche quelli sono personali."
	]
	quest.20C4106EB3B7114C.title: "Archeologia"
	quest.20C4106EB3B7114C.quest_subtitle: "Spazzola e pazienza"
	quest.20C4106EB3B7114C.quest_desc: [
		"Sabbia e ghiaia sospette nascondono cocci e reperti."
		"Crafta una &6spazzola&r e scava con calma: se premi troppo il blocco si rompe."
	]
	task.1662964F1DA24DCA.title: "Ho spazzolato un blocco sospetto"
	quest.3A79AE7CF3AE966E.title: "Il tempio del deserto"
	quest.3A79AE7CF3AE966E.quest_subtitle: "Trappole e sabbia"
	quest.3A79AE7CF3AE966E.quest_desc: [
		"I templi del deserto sono più grandi e pieni di trappole."
		"Entrate in squadra e guardate dove mettete i piedi."
	]
	quest.57FE2728E3891332.title: "Il Faraone"
	quest.57FE2728E3891332.quest_subtitle: "Il guardiano del tempio"
	quest.57FE2728E3891332.quest_desc: [
		"In fondo al tempio riposa un &cFaraone&r non morto."
		"Sconfiggetelo per ripulire il tempio."
	]
	quest.41F1031A62B9A36F.title: "Le camere della prova"
	quest.41F1031A62B9A36F.quest_subtitle: "Chiavi e casseforti"
	quest.41F1031A62B9A36F.quest_desc: [
		"Sotto il mondo ci sono le &6Camere della Prova&r: generatori a ondate e Breeze."
		"Vincete le ondate, prendete una &6chiave della prova&r e aprite una cassaforte."
		"&cI mostri si rafforzano con le ere&r: andateci almeno in tre."
	]
	quest.6C574AC1A30A9BED.title: "Il monumento oceanico"
	quest.6C574AC1A30A9BED.quest_subtitle: "Il guardiano anziano"
	quest.6C574AC1A30A9BED.quest_desc: [
		"I monumenti oceanici sono stati rifatti e nascondono più stanze."
		"Sconfiggete un &cguardiano anziano&r: servono pozioni di respirazione e un buon piano."
	]
	quest.71224E35886F965B.title: "Villaggi lontani"
	quest.71224E35886F965B.quest_subtitle: "Cinque villaggi da scoprire"
	quest.71224E35886F965B.quest_desc: [
		"Con la &6Bussola dell'Esploratore&r cercate i villaggi abitati dei nuovi biomi."
		"Dividetevi le direzioni: ognuno ne trova uno."
	]
	quest.27D36E017DBC8F6F.title: "La palude pallida"
	quest.27D36E017DBC8F6F.quest_subtitle: "Un posto che non piace a nessuno"
	quest.27D36E017DBC8F6F.quest_desc: [
		"Trovate una &7Palude Pallida&r: nebbia, fango e zucche spente."
	]
	quest.3F6B2AC960B963BE.title: "La strada delle streghe"
	quest.3F6B2AC960B963BE.quest_subtitle: "La prova della palude"
	quest.3F6B2AC960B963BE.quest_desc: [
		"Nella palude pallida c'è una &cprova&r nascosta."
		"Trovatela con la bussola e affrontatela insieme."
	]
	quest.57F32F2020C46E2B.title: "Biomi infuocati"
	quest.57F32F2020C46E2B.quest_subtitle: "Il Nether è cambiato"
	quest.57F32F2020C46E2B.quest_desc: [
		"Il Nether ha nuovi biomi (&aIncendium&r): dune, foreste avvizzite, distese di quarzo."
		"Entratene in uno."
	]
	quest.7DD2624A89669DE5.title: "Il castello proibito"
	quest.7DD2624A89669DE5.quest_subtitle: "La roccaforte dei piglin"
	quest.7DD2624A89669DE5.quest_desc: [
		"Nelle distese di cenere si alza un &cCastello Proibito&r, pieno di piglin armati e sentinelle."
		"Entrate solo in squadra, con armature dell'era 3."
	]
	task.73256F0ECACCC465.title: "Abbiamo ripulito il castello"
	quest.15BB020C5AAAE132.title: "La fortezza del Nether"
	quest.15BB020C5AAAE132.quest_subtitle: "Mattoni neri e blaze"
	quest.15BB020C5AAAE132.quest_desc: [
		"Le fortezze sono più grandi e intricate."
		"Trovatene una: blaze e scheletri wither vi aspettano."
	]
	quest.572C0CD2AEFEBC5A.title: "La cittadella del fuoco"
	quest.572C0CD2AEFEBC5A.quest_subtitle: "Lo Spirito di Fuoco"
	quest.572C0CD2AEFEBC5A.quest_desc: [
		"In alcune zone del Nether c'è una cittadella guardata dallo &cSpirito di Fuoco&r (Wildfire)."
		"Trovatela e abbattetelo: scudi alzati, i suoi colpi bruciano."
	]
	quest.276AA7087AF53F65.title: "Il bastione"
	quest.276AA7087AF53F65.quest_subtitle: "Oro e piglin bruti"
	quest.276AA7087AF53F65.quest_desc: [
		"Trovate un bastione dei piglin."
		"Indossate almeno un pezzo d'oro e attenti ai &cbruti&r: non si lasciano corrompere."
	]
	quest.3CECF2790A580E27.title: "La città antica"
	quest.3CECF2790A580E27.quest_subtitle: "Silenzio assoluto"
	quest.3CECF2790A580E27.quest_desc: [
		"In fondo al mondo, tra lo sculk, dorme una &6Città Antica&r."
		"Camminate accovacciati, niente rumori: gli strilli dello sculk chiamano il &cWarden&r."
	]
	quest.2BC8888A86C55553.title: "Il Warden"
	quest.2BC8888A86C55553.quest_subtitle: "Il cuore delle profondità"
	quest.2BC8888A86C55553.quest_desc: [
		"Il Warden è cieco, ma sente tutto. Con le ere diventa ancora peggio."
		"Abbattetelo in squadra e prendete il suo &6Cuore delle Profondità&r: serve per aprire il passaggio."
		"&cNon è un nemico per la prima volta: serve l'equipaggiamento dell'era 4.&r"
	]
	quest.24CA40CCA277E6E0.title: "L'Altro Lato"
	quest.24CA40CCA277E6E0.quest_subtitle: "Sotto la roccia madre"
	quest.24CA40CCA277E6E0.quest_desc: [
		"Il grande portale della città antica si accende con il &6Cuore delle Profondità&r."
		"Dall'altra parte c'è l'&5Otherside&r: buio, sculk e creature che vi sentono arrivare."
	]
	quest.5A8F7D59086B7DA8.title: "Il tempio antico"
	quest.5A8F7D59086B7DA8.quest_subtitle: "Ancora più giù"
	quest.5A8F7D59086B7DA8.quest_desc: [
		"Nell'Otherside ci sono templi antichi pieni di vasi e forzieri."
		"Trovatene uno ed esploratelo insieme."
	]
	quest.66C8CA9FC24C37FF.title: "Armatura del Warden"
	quest.66C8CA9FC24C37FF.quest_subtitle: "Vestiti di sculk"
	quest.66C8CA9FC24C37FF.quest_desc: [
		"Con i frammenti d'eco rinforzati e i modelli di potenziamento si forgia l'armatura del Warden."
		"Completate un set intero."
	]
	quest.64D7DF72CBC2CAF1.title: "Segui l'occhio"
	quest.64D7DF72CBC2CAF1.quest_subtitle: "La roccaforte"
	quest.64D7DF72CBC2CAF1.quest_desc: [
		"Lanciate un &6occhio di Ender&r e seguitelo fino alla roccaforte."
		"Le roccaforti sono labirinti enormi: segnate la strada."
	]
	quest.450584B4C5665886.title: "Nell'End"
	quest.450584B4C5665886.quest_subtitle: "Il vuoto dall'altra parte"
	quest.450584B4C5665886.quest_desc: [
		"Completate il portale ed entrate tutti insieme."
		"Cadere nel vuoto vuol dire perdere tutto: blocchi e pazienza."
	]
	quest.56504D68223A13C3.title: "Il Drago dell'Ender"
	quest.56504D68223A13C3.quest_subtitle: "La regina del vuoto"
	quest.56504D68223A13C3.quest_desc: [
		"Distruggete i cristalli sulle torri, poi concentratevi sul drago."
		"Arcieri sui cristalli, gli altri sotto: ognuno il suo ruolo."
	]
	quest.5F1A025566FC6932.title: "Oltre il portale"
	quest.5F1A025566FC6932.quest_subtitle: "Le isole esterne"
	quest.5F1A025566FC6932.quest_desc: [
		"Il drago ha aperto un &5portale dell'End&r: lanciateci una perla per attraversarlo."
		"Le isole esterne hanno biomi nuovi (&aNullscape&r): visitatene uno."
	]
	quest.797813F6A5DA5704.title: "La città dell'End"
	quest.797813F6A5DA5704.quest_subtitle: "Torri viola"
	quest.797813F6A5DA5704.quest_desc: [
		"Trovate una città dell'End."
		"Attenti agli &cshulker&r: la levitazione sopra il vuoto è una trappola."
	]
	quest.715E700470912A11.title: "Ali"
	quest.715E700470912A11.quest_subtitle: "Volare senza motore"
	quest.715E700470912A11.quest_desc: [
		"Sulle navi delle città dell'End ci sono le &6elitre&r."
		"Una a testa: le navi sono più d'una."
	]
	chapter.1E417D6C1B96BDC8.title: "Cucina"
	chapter.1E417D6C1B96BDC8.chapter_subtitle: [
		"Orto, fornelli, cantina e un menu sempre vario"
	]
	quest.603CFF33C26A0CD3.title: "Il gusto della varietà"
	quest.603CFF33C26A0CD3.quest_subtitle: "Più cibi diversi, più cuori"
	quest.603CFF33C26A0CD3.quest_desc: [
		"Con &6Spice of Life&r ogni cibo &adiverso&r che mangi per la prima volta viene segnato."
		"A &e5, 10, 15, 20 e 25&r cibi diversi guadagni &acuori in più&r. Mangiare sempre pane non serve."
		"Ognuno ha il suo conto: il &6Libro dei cibi&r (libro + carota) mostra cosa hai già assaggiato."
		"Morire non toglie i cuori guadagnati."
	]
	quest.27EABA58E4B9D27C.title: "Cinque sapori"
	quest.27EABA58E4B9D27C.quest_desc: [
		"Mangia &e5&r cibi diversi. Primo traguardo: cuori in più."
	]
	task.18842C5073818BEA.title: "Il Libro dei cibi conta almeno 5 cibi"
	quest.590CF83E268E95E9.title: "Dieci sapori"
	quest.590CF83E268E95E9.quest_desc: [
		"&e10&r cibi diversi. Zuppe e piatti di Farmer's Delight contano tutti."
	]
	task.1364171B9A1E0C85.title: "Il Libro dei cibi conta almeno 10 cibi"
	quest.37AC7A6EB19213EF.title: "Quindici sapori"
	quest.37AC7A6EB19213EF.quest_desc: [
		"&e15&r cibi diversi. Scambiatevi i piatti: chi cucina sfama tutta la squadra."
	]
	task.27B932972A84F4D2.title: "Il Libro dei cibi conta almeno 15 cibi"
	quest.6471D07EB4965FA8.title: "Venti sapori"
	quest.6471D07EB4965FA8.quest_desc: [
		"&e20&r cibi diversi. Cantina, Nether e colonia offrono piatti nuovi."
	]
	task.101EB086A402B451.title: "Il Libro dei cibi conta almeno 20 cibi"
	quest.49889353D8DEA779.title: "&6Palato d'oro&r"
	quest.49889353D8DEA779.quest_subtitle: "Ultimo traguardo di Spice of Life"
	quest.49889353D8DEA779.quest_desc: [
		"&e25&r cibi diversi: hai tutti i cuori che la varietà può dare."
	]
	task.46E106378B156262.title: "Il Libro dei cibi conta almeno 25 cibi"
	quest.4B65C26B217158FE.title: "Coltello e tagliere"
	quest.4B65C26B217158FE.quest_desc: [
		"Un &6coltello&r e un &6tagliere&r: metti l'ingrediente sul tagliere e colpiscilo col coltello."
		"Così si ottengono fette, tagli di carne e paglia. Il coltello fa anche cadere più carne dagli animali."
	]
	quest.19C9BA137ED61776.title: "L'orto"
	quest.19C9BA137ED61776.quest_desc: [
		"Pomodori, cavoli, cipolle e riso: semi dalla quest &6Dispensa varia&r o dalle piante selvatiche."
		"Il riso va piantato in acqua bassa."
	]
	quest.1FEDD5C5B6F41807.title: "Terra ricca"
	quest.1FEDD5C5B6F41807.quest_desc: [
		"Il &6compost organico&r piazzato a terra matura da solo in &aterra ricca&r: le colture crescono più in fretta."
		"Funghi e luce vicino lo aiutano."
	]
	quest.521C5A5846EB3C6A.title: "Pollice verde"
	quest.521C5A5846EB3C6A.quest_desc: [
		"Raccolto abbondante: casse di verdura e balle di riso per la dispensa comune."
	]
	quest.4FD173EC7A1B28F7.title: "Il fornello"
	quest.4FD173EC7A1B28F7.quest_desc: [
		"Il &6fornello&r cuoce da solo fino a sei cibi sopra di sé."
		"Sotto la &6Pentola&r prende il posto del falò."
	]
	quest.6B50E8D8F12D3786.title: "Zuppe e stufati"
	quest.6B50E8D8F12D3786.quest_desc: [
		"Le zuppe della Pentola danno &aNutrimento&r: niente fame finché dura l'effetto."
		"Servono una ciotola e gli ingredienti giusti: guarda le ricette in JEI."
	]
	quest.207980ED92412586.title: "A tavola!"
	quest.207980ED92412586.quest_subtitle: "Piatti da portata"
	quest.207980ED92412586.quest_desc: [
		"Arrosti, torte e prosciutti glassati si &6piazzano sul tavolo&r."
		"Ognuno prende la sua porzione con una ciotola: un pasto per tutta la squadra."
	]
	quest.44012B4167504889.title: "&6Gran maestro chef&r"
	quest.44012B4167504889.quest_desc: [
		"Assaggia &etutti i 27 piatti&r principali di Farmer's Delight."
		"Basta che ci riesca uno di voi. Vale anche come traguardo di Spice of Life!"
	]
	quest.75CC169973E8E945.title: "La padella"
	quest.75CC169973E8E945.quest_desc: [
		"La &6padella&r cuoce sul fornello o sul falò. Tienila in mano e clicca col cibo crudo nell'altra."
		"In mischia è anche un'arma rispettabile."
	]
	quest.736DA31989703A7F.title: "La botte"
	quest.736DA31989703A7F.quest_desc: [
		"La &6botte&r di Brewin' and Chewin' fa fermentare bevande, formaggi e conserve."
		"La temperatura conta: ghiaccio o fuoco vicino cambiano il risultato."
	]
	quest.6475D0EF4D3758BF.title: "Prima fermentazione"
	quest.6475D0EF4D3758BF.quest_desc: [
		"Riempi la botte e aspetta: esce una bevanda fermentata."
		"Ogni bevanda dà un effetto, ma troppe danno la sbornia."
	]
	quest.366F00CD296E8948.title: "Formaggi stagionati"
	quest.366F00CD296E8948.quest_desc: [
		"Il latte in botte diventa una forma di formaggio &7acerbo&r."
		"Piazzala e lasciala stagionare: poi si taglia a spicchi."
	]
	quest.1664BB688D59E790.title: "Dal boccale al serbatoio"
	quest.1664BB688D59E790.quest_desc: [
		"La &6Centrifuga&r di Modern Industrialization trasforma le bevande fermentate in &aetanolo&r e restituisce il boccale."
		"Il riso nel Miscelatore dà soluzione zuccherina: la cantina diventa carburante."
	]
	quest.3CDC8B23C1AA1F94.title: "Il Ristorante"
	quest.3CDC8B23C1AA1F94.quest_desc: [
		"I coloni affamati lavorano male. Il &6Ristorante&r col suo cuoco li sfama."
		"Tenete il suo magazzino pieno di cibi vari."
	]
	task.119BD8012E051A9E.title: "Il Ristorante è costruito e il cuoco è al lavoro"
	quest.13645D6D974C6E56.title: "La cucina dello Chef"
	quest.13645D6D974C6E56.quest_desc: [
		"Nella &6Cucina&r lo Chef prepara piatti della colonia: tacos, ramen, sushi e altri."
		"Piatti nuovi per il vostro Libro dei cibi."
	]
	task.6FB987A59FE9629A.title: "La Cucina è costruita e lo Chef ha preparato un piatto"
	quest.3BA8F4BA7C8720D0.title: "Il Contadino"
	quest.3BA8F4BA7C8720D0.quest_desc: [
		"Il &6Contadino&r coltiva i campi della colonia al posto vostro."
		"Piazzate un campo, assegnategli i semi e lasciatelo lavorare."
	]
	task.67A6181BA87697A9.title: "Il Contadino è al lavoro su almeno un campo"
	quest.1007D7B8692267B2.title: "Il Fornaio"
	quest.1007D7B8692267B2.quest_desc: [
		"Con il grano del Contadino, il &6Fornaio&r sforna pane per tutta la colonia."
	]
	task.66D10C62A3022F75.title: "Il Fornaio è costruito e sforna pane"
	quest.2559EEACD69FB18B.title: "Banchetto crepuscolare"
	quest.2559EEACD69FB18B.quest_desc: [
		"La &6Twilight Forest&r ha la sua selvaggina: i cervi del crepuscolo."
		"Cuocine la carne e porta in tavola un sapore nuovo per il Libro dei cibi."
	]
	quest.57B3FD275CD3C9E4.title: "Cucina infernale"
	quest.57B3FD275CD3C9E4.quest_desc: [
		"My Nether's Delight: lombo di hoglin, peperoncini proiettile e piatti piccantissimi."
		"Lo stufato di hoglin si cuoce nella Pentola."
	]
	quest.694DD53796863A1E.title: "Sapori dell'End"
	quest.694DD53796863A1E.quest_desc: [
		"End's Delight: frutti di chorus, carne di shulker e altre stranezze."
		"Prima ricetta: la torta di frutti di chorus."
	]
	quest.22D2CE09900ABE3D.title: "La Luna è di formaggio"
	quest.22D2CE09900ABE3D.quest_desc: [
		"Sulla Luna c'è davvero il &6formaggio&r: si estrae dal minerale di formaggio lunare."
	]
	quest.4A5F54C632587A38.title: "Mani in pasta"
	quest.4A5F54C632587A38.quest_subtitle: "Si cucina davvero"
	quest.4A5F54C632587A38.quest_desc: [
		"Con &6Hands-On Delight&r le stazioni di Farmer's Delight si usano con le mani: clic destro sulla pentola e la visuale si avvicina."
		"Mettete gli ingredienti uno alla volta e seguite la cottura da vicino."
		"{@pagebreak}"
		"&7Funziona anche con il tagliere, la padella e la botte della cantina."
	]
	task.1B3F275C90ECF02C.title: "Ho cucinato un piatto a mano nella pentola"
	quest.2522CC2921F79A80.title: "Mescolare la zuppa"
	quest.2522CC2921F79A80.quest_subtitle: "La pentola"
	quest.2522CC2921F79A80.quest_desc: [
		"Nella pentola alcuni ingredienti si sciolgono nel brodo, altri si scolano alla fine."
		"Preparate uno stufato e uno di pesce mescolando voi."
	]
	quest.47557D20AE60406E.title: "In padella"
	quest.47557D20AE60406E.quest_subtitle: "Girare al momento giusto"
	quest.47557D20AE60406E.quest_desc: [
		"Sulla padella si cuoce a vista: alcuni cibi si girano, altri si friggono da un lato solo."
		"Tenete la padella su un fornello acceso."
	]
	quest.31831ECF7B364023.title: "Al tagliere"
	quest.31831ECF7B364023.quest_subtitle: "Fette, spicchi e listarelle"
	quest.31831ECF7B364023.quest_desc: [
		"Sul tagliere ogni cibo si taglia a modo suo: a fette dritte, a spicchi o a listarelle."
		"Tagliate carne e pesce con il coltello in mano."
	]
	quest.2861106CC9A9A46B.title: "Piatti a strati"
	quest.2861106CC9A9A46B.quest_subtitle: "Si monta sul tagliere"
	quest.2861106CC9A9A46B.quest_desc: [
		"Panini, hamburger e involtini si montano sul tagliere un ingrediente alla volta, nell'ordine giusto."
		"&7JEI mostra quale ingrediente va per primo."
	]
	quest.7BDE9DDC49A41527.title: "La botte a mano"
	quest.7BDE9DDC49A41527.quest_subtitle: "Fermentare con calma"
	quest.7BDE9DDC49A41527.quest_desc: [
		"Anche la botte della cantina si apre nel mondo: versate i liquidi e aspettate la fermentazione."
		"&7Serve la botte di Brewin' and Chewin'."
	]
	quest.752F48332C254A3F.title: "Chef con le mani"
	quest.752F48332C254A3F.quest_subtitle: "Un menu fatto da voi"
	quest.752F48332C254A3F.quest_desc: [
		"Pentola, padella e tagliere non hanno più segreti."
		"Preparate un pranzo completo per tutta la colonia."
	]
	chapter.54225A4AB825BB3D.title: "Compagni"
	chapter.54225A4AB825BB3D.chapter_subtitle: [
		"Cani, animali domestici, allevamento e natura selvaggia"
	]
	quest.28569E16671DFE35.title: "Il primo allievo"
	quest.28569E16671DFE35.quest_subtitle: "Da lupo a cane"
	quest.28569E16671DFE35.quest_desc: [
		"Dai un &6Training Treat&r a un lupo addomesticato: diventa un cane di Doggy Talents."
		"Ogni bocconcino in più gli fa guadagnare esperienza e punti talento."
	]
	quest.40BB43424DC04A5F.title: "Primi talenti"
	quest.40BB43424DC04A5F.quest_subtitle: "Ogni cane ha un mestiere"
	quest.40BB43424DC04A5F.quest_desc: [
		"Apri il menu del cane e spendi i punti talento."
		"&6Pack Puppy&r porta oggetti, &6Guard Dog&r para i colpi, &6Hunter Dog&r caccia, &6Rescue Dog&r cura."
		"&aIn squadra, cani con talenti diversi si completano.&r"
	]
	task.1178E7FF7D3FA442.title: "Il mio cane ha il primo talento"
	quest.2356DC16D51B0761.title: "Super bocconcino"
	quest.2356DC16D51B0761.quest_subtitle: "Oltre il primo limite"
	quest.2356DC16D51B0761.quest_desc: [
		"Il &6Super Treat&r (5 Training Treat e una mela d'oro) fa crescere il cane oltre il livello base."
		"Più livelli, più punti talento."
	]
	quest.28C24E5C4F645988.title: "Bocconcino del maestro"
	quest.28C24E5C4F645988.quest_subtitle: "Un cane veterano"
	quest.28C24E5C4F645988.quest_desc: [
		"Il &6Master Treat&r si fa con 5 Super Treat e un diamante."
		"Porta il cane al grado più alto dei talenti."
	]
	quest.7B920A3FCA1E5164.title: "Bocconcino divino"
	quest.7B920A3FCA1E5164.quest_subtitle: "Leggenda a quattro zampe"
	quest.7B920A3FCA1E5164.quest_desc: [
		"Il &6Kami Treat&r chiede 5 Master Treat e una pietra dell'End."
		"&7Facoltativa: un traguardo da veri addestratori.&r"
	]
	quest.7B6B8F309BDF7BEE.title: "Ciotola e cuccia"
	quest.7B6B8F309BDF7BEE.quest_subtitle: "Una casa per il cane"
	quest.7B6B8F309BDF7BEE.quest_desc: [
		"La &6Ciotola&r sfama il cane da sola: riempila di cibo."
		"La &6Cuccia&r è il suo posto: lì torna e lì riposa."
	]
	quest.5A4CBF5A4687AD5C.title: "Il fischietto"
	quest.5A4CBF5A4687AD5C.quest_subtitle: "Seduto, vieni, attacca"
	quest.5A4CBF5A4687AD5C.quest_desc: [
		"Il &6Fischietto&r dà ordini a tutti i tuoi cani insieme."
		"Clic destro per usarlo, accovacciato per cambiare modalità."
	]
	quest.2F74CD1B97694E20.title: "Dov'è finito?"
	quest.2F74CD1B97694E20.quest_subtitle: "Collare radio e localizzatore"
	quest.2F74CD1B97694E20.quest_desc: [
		"Metti un &6Collare radio&r al cane e usa il &6Localizzatore canino&r per ritrovarlo."
		"Utile quando il cane si perde lontano dalla colonia."
	]
	quest.54B9AE937A4BA1BD.title: "Riporta!"
	quest.54B9AE937A4BA1BD.quest_subtitle: "Un po' di gioco"
	quest.54B9AE937A4BA1BD.quest_desc: [
		"Lancia l'&6Osso da lancio&r e il cane te lo riporta."
		"Un cane che gioca è un cane felice."
	]
	quest.20D264481133CAAC.title: "Lupi di tutti i colori"
	quest.20D264481133CAAC.quest_subtitle: "Una tavolozza di zampe"
	quest.20D264481133CAAC.quest_desc: [
		"Nei biomi del mondo vivono lupi dal manto insolito: cappuccino, glassa, corallo, ender..."
		"Addomesticane uno diverso dal lupo grigio."
	]
	task.25219604F2A23F95.title: "Ho addomesticato un lupo dal manto raro"
	quest.47368D26DBBB4661.title: "Amici a quattro zampe"
	quest.47368D26DBBB4661.quest_subtitle: "Il primo animale tutto tuo"
	quest.47368D26DBBB4661.quest_desc: [
		"Addomestica un animale: lupo, gatto, pappagallo, cavallo..."
		"Da qui parte tutto il resto del capitolo."
	]
	quest.22C1C95E2AE37170.title: "Compagni insoliti"
	quest.22C1C95E2AE37170.quest_subtitle: "Anche la mucca vuole un padrone"
	quest.22C1C95E2AE37170.quest_desc: [
		"Con Tameable Animals molti animali vanilla diventano compagni: maiali, pecore, volpi, capre, panda..."
		"Offri più volte il loro cibo preferito finché non compaiono i cuori."
		"Clic destro a mano vuota: resta qui o seguimi."
	]
	task.3B9A9F7678A4349C.title: "Ho un compagno insolito"
	quest.715B1A8B19CCAD89.title: "A cavallo"
	quest.715B1A8B19CCAD89.quest_subtitle: "Più veloce dei piedi"
	quest.715B1A8B19CCAD89.quest_desc: [
		"Doma un cavallo salendoci sopra finché non si calma."
		"La sella non si crafta: cercala nei forzieri dei dungeon e dei villaggi."
		"Un guinzaglio tiene il cavallo legato alla staccionata."
	]
	task.7E0630077A201DFD.title: "Ho cavalcato un cavallo sellato"
	quest.325B6F4F03B19C94.title: "Un muschio volante"
	quest.325B6F4F03B19C94.quest_subtitle: "Il Glare delle caverne"
	quest.325B6F4F03B19C94.quest_desc: [
		"Il &6Glare&r vive nelle caverne rigogliose e ama le bacche luminose."
		"Addomesticalo: ti segnala gli angoli bui dove nascono i mostri."
	]
	quest.38B935560238E500.title: "Il golem di rame"
	quest.38B935560238E500.quest_subtitle: "Un piccolo aiutante"
	quest.38B935560238E500.quest_desc: [
		"Costruisci un &6Golem di rame&r: blocco di rame, zucca intagliata e parafulmine in cima."
		"Gira per la colonia premendo i pulsanti di rame."
	]
	quest.748318CD949A7793.title: "Un amico in secchio"
	quest.748318CD949A7793.quest_subtitle: "Axolotl da guardia"
	quest.748318CD949A7793.quest_desc: [
		"Cattura un axolotl con un secchio d'acqua."
		"Liberato vicino a te, combatte i mostri acquatici al tuo fianco."
	]
	quest.78CBCE2A73584EA9.title: "Il primo allevamento"
	quest.78CBCE2A73584EA9.quest_subtitle: "Due animali, un cucciolo"
	quest.78CBCE2A73584EA9.quest_desc: [
		"Dai da mangiare a due animali della stessa specie: nascerà un cucciolo."
		"Carne, lana e uova non finiscono mai."
	]
	quest.7044A4AA37C2D85C.title: "I recinti della colonia"
	quest.7044A4AA37C2D85C.quest_subtitle: "Allevatori di mestiere"
	quest.7044A4AA37C2D85C.quest_desc: [
		"La colonia ha i suoi allevatori: &6Pastore&r, &6Mandriano&r, &6Porcaro&r, &6Pollaio&r e &6Conigliera&r."
		"Costruitene almeno uno: l'allevamento lo porta avanti un colono, non voi."
	]
	task.3FBE9B0731FD11FE.title: "La colonia ha un allevatore al lavoro"
	quest.558F40F3CE60B9C3.title: "Due di tutto"
	quest.558F40F3CE60B9C3.quest_subtitle: "L'arca della colonia"
	quest.558F40F3CE60B9C3.quest_desc: [
		"Fai nascere un cucciolo di ogni animale allevabile del gioco base."
		"&7Lunga: dividetevi le specie tra compagni.&r"
	]
	quest.1B66D6530DB21153.title: "Miele al sicuro"
	quest.1B66D6530DB21153.quest_subtitle: "Senza punture"
	quest.1B66D6530DB21153.quest_desc: [
		"Metti un falò sotto l'alveare e raccogli il miele senza far arrabbiare le api."
	]
	quest.2F00F9D9A634083D.title: "L'apicoltore"
	quest.2F00F9D9A634083D.quest_subtitle: "Miele per tutta la colonia"
	quest.2F00F9D9A634083D.quest_desc: [
		"Costruisci la capanna dell'&6Apicoltore&r: un colono cura gli alveari e raccoglie miele e favi."
	]
	task.2D75730AA5ADD0D7.title: "L'apicoltore è al lavoro"
	quest.1D2ED08FB63F303C.title: "Rete da cattura"
	quest.1D2ED08FB63F303C.quest_subtitle: "Il kit del naturalista"
	quest.1D2ED08FB63F303C.quest_desc: [
		"La &6Rete da cattura&r si fa con bambù e spago."
		"Serve a prendere farfalle, lucciole e altri piccoli animali."
	]
	quest.63B1AA2B7CDF1171.title: "Ali colorate"
	quest.63B1AA2B7CDF1171.quest_subtitle: "Farfalle nei prati"
	quest.63B1AA2B7CDF1171.quest_desc: [
		"Cattura una farfalla con la rete."
		"Liberata vicino ai fiori, li impollina e li fa crescere."
	]
	quest.59B410E6215191EB.title: "Selvaggina"
	quest.59B410E6215191EB.quest_subtitle: "Dal bosco alla dispensa"
	quest.59B410E6215191EB.quest_desc: [
		"Cervi e cinghiali danno &6cacciagione&r e &6carne selvatica&r."
		"Sul tagliere di Farmer's Delight diventa strisce da cuocere in fornace, affumicatore o sul falò."
	]
	quest.1DC71770F94C9B51.title: "L'orso goloso"
	quest.1DC71770F94C9B51.quest_subtitle: "Un favo per fare pace"
	quest.1DC71770F94C9B51.quest_desc: [
		"Lancia un favo a un orso: lo mangia e si calma."
		"&cGli orsi sono forti: meglio andarci in compagnia.&r"
	]
	quest.3C16ADED5E4F4B5A.title: "Ippopotamo affamato"
	quest.3C16ADED5E4F4B5A.quest_subtitle: "Anguria al fiume"
	quest.3C16ADED5E4F4B5A.quest_desc: [
		"Trova un ippopotamo vicino ai fiumi dei biomi caldi e dagli un'anguria."
	]
	quest.5DD51AC19B87A65B.title: "Panorama dall'alto"
	quest.5DD51AC19B87A65B.quest_subtitle: "In groppa a una giraffa"
	quest.5DD51AC19B87A65B.quest_desc: [
		"Sali su una giraffa nella savana e apri una mappa da lassù."
		"&7Il modo più elegante di esplorare.&r"
	]
	chapter.54C9BE480912D935.title: "Trasporti"
	chapter.54C9BE480912D935.chapter_subtitle: [
		"A cavallo, in barca, in volo e via waystone"
	]
	quest.48DEAF1AA07C04E4.title: "Braccia forti"
	quest.48DEAF1AA07C04E4.quest_subtitle: "Traslochi senza svuotare"
	quest.48DEAF1AA07C04E4.quest_desc: [
		"Con le &6mani vuote&r, accovacciati e clic destro: sollevi un baule pieno, un animale o un compagno di squadra."
		"&7Non funziona su blocchi della colonia, macchine e waystone.&r"
	]
	task.446AD6D438BEDC2C.title: "Ho spostato un baule pieno in braccio"
	quest.1100C51DF532BDCC.title: "In sella"
	quest.1100C51DF532BDCC.quest_subtitle: "Il primo mezzo di trasporto"
	quest.1100C51DF532BDCC.quest_desc: [
		"Doma un cavallo salendoci sopra finché non si calma, poi mettigli una &6sella&r."
		"Le selle si trovano nei forzieri: dungeon, villaggi, templi."
	]
	task.6BB5A6D3677F87F4.title: "Ho domato e sellato un cavallo"
	quest.29306194F3F3BB53.title: "Bardatura"
	quest.29306194F3F3BB53.quest_subtitle: "Un cavallo che sopravvive"
	quest.29306194F3F3BB53.quest_desc: [
		"I mob si rafforzano col tempo: proteggi il cavallo con una &6bardatura di ferro&r."
	]
	quest.1BA99F1AAC801C62.title: "Per fiumi e mari"
	quest.1BA99F1AAC801C62.quest_subtitle: "La barca col baule"
	quest.1BA99F1AAC801C62.quest_desc: [
		"Una &6barca con baule&r porta te e un carico. Sull'acqua è più veloce del cavallo."
		"Va bene qualsiasi legno."
	]
	task.2A1BC91421B60286.title: "Ho attraversato un lago o un mare in barca"
	quest.1188D4C863D7E1C8.title: "Binari per la miniera"
	quest.1188D4C863D7E1C8.quest_subtitle: "Carrelli, non treni"
	quest.1188D4C863D7E1C8.quest_desc: [
		"Un tratto di &6binari alimentati&r dalla colonia alla miniera: carrelli per te e carrelli con baule per il bottino."
	]
	quest.3B25D310073CAF6A.title: "Sul lago di lava"
	quest.3B25D310073CAF6A.quest_subtitle: "Lo strider"
	quest.3B25D310073CAF6A.quest_desc: [
		"Nel Nether lo &6strider&r cammina sulla lava. Sellalo e guidalo con un fungo distorto su un bastone."
	]
	task.7BC5823E1524EAD4.title: "Cavalca uno strider con il fungo distorto"
	quest.1D9C57B123D64483.title: "Pergamene di ritorno"
	quest.1D9C57B123D64483.quest_subtitle: "A casa in un attimo"
	quest.1D9C57B123D64483.quest_desc: [
		"Pepite di bronzo, inchiostro e carta: tre pergamene che ti riportano al tuo letto o al punto di rinascita."
		"Tienine sempre una nello zaino."
	]
	quest.2B0A32667AB94553.title: "Pergamene di curvatura"
	quest.2B0A32667AB94553.quest_subtitle: "Una waystone da ovunque"
	quest.2B0A32667AB94553.quest_desc: [
		"Come le pergamene di ritorno, con una perla di ender in più: scegli una qualsiasi waystone attivata, senza pagare esperienza."
	]
	quest.2662A943A609B3F9.title: "Pergamena vincolata"
	quest.2662A943A609B3F9.quest_subtitle: "Un biglietto di sola andata"
	quest.2662A943A609B3F9.quest_desc: [
		"Usa una &6pergamena vuota&r su una waystone: diventa vincolata a quella pietra."
		"Regalatela a chi arriva dopo: lo porta dritto alla colonia."
	]
	quest.4EBBEFDD3D733A10.title: "Pietre condivise"
	quest.4EBBEFDD3D733A10.quest_subtitle: "Un colore, una linea"
	quest.4EBBEFDD3D733A10.quest_desc: [
		"Le &6sharestone&r dello stesso colore sono collegate tra loro e non vanno attivate: tutta la squadra le usa subito."
		"&aScegliete un colore per la linea colonia - miniere - avamposti.&r"
	]
	task.7BFB31B6807B8374.title: "Abbiamo piazzato due sharestone dello stesso colore"
	quest.2358DD4542DBE9F4.title: "Pietra di partenza"
	quest.2358DD4542DBE9F4.quest_subtitle: "Solo in uscita"
	quest.2358DD4542DBE9F4.quest_desc: [
		"La &6portstone&r porta a qualsiasi waystone, ma nessuno può arrivarci."
		"Mettetela nel cuore della colonia, accanto al magazzino."
	]
	quest.1C29BAFB8C75D6F3.title: "Piastra di curvatura"
	quest.1C29BAFB8C75D6F3.quest_subtitle: "Teletrasporto senza esperienza"
	quest.1C29BAFB8C75D6F3.quest_desc: [
		"Mattoni placcati di bronzo, polvere di curvatura e un frammento dormiente."
		"Due piastre collegate ti spostano solo salendoci sopra: ideale tra fabbrica e colonia."
	]
	quest.534B9197551141A0.title: "Frammento sintonizzato"
	quest.534B9197551141A0.quest_subtitle: "Collegare due piastre"
	quest.534B9197551141A0.quest_desc: [
		"Metti un &6frammento dormiente&r nella prima piastra: diventa sintonizzato."
		"Portalo nella seconda piastra e il collegamento è fatto."
		"&7Ricorda: nessun teletrasporto tra dimensioni, per quello servono portali e razzi.&r"
	]
	quest.44118B58586195DD.title: "Dirigibile"
	quest.44118B58586195DD.quest_subtitle: "Lento ma instancabile"
	quest.44118B58586195DD.quest_desc: [
		"Sei vele, due scafi e un &6motore&r: caldaia di rame, altoforno, pistoni e bronzo."
		"Il motore brucia carbone o legna. Porta due persone."
	]
	quest.285617284ED8F723.title: "Quadricottero"
	quest.285617284ED8F723.quest_subtitle: "Su e giù in verticale"
	quest.285617284ED8F723.quest_desc: [
		"Motore, quattro eliche di bronzo e bambù."
		"Sale e scende dritto: perfetto per cantieri e miniere a cielo aperto."
	]
	quest.4A13196B2CC1984A.title: "Biplano"
	quest.4A13196B2CC1984A.quest_subtitle: "Il più veloce"
	quest.4A13196B2CC1984A.quest_desc: [
		"Tre scafi, motore, elica, piastre e ingranaggio d'&6acciaio&r."
		"Corre tantissimo ma ha bisogno di una pista per decollare."
	]
	quest.323A24848B9D8D76.title: "Bamboo Hopper"
	quest.323A24848B9D8D76.quest_subtitle: "Un biplano più grande"
	quest.323A24848B9D8D76.quest_desc: [
		"Un biplano, uno scafo, un altro motore e blocchi di bambù."
		"Più posti e più spazio: per spedizioni di squadra."
	]
	quest.1FD6E99751995E9A.title: "Dirigibile da carico"
	quest.1FD6E99751995E9A.quest_subtitle: "Un magazzino che vola"
	quest.1FD6E99751995E9A.quest_desc: [
		"Il dirigibile con quattro bauli, uno scafo e piastre d'&6acciaio&r."
		"Ideale per riportare alla colonia il bottino delle spedizioni."
	]
	quest.3531295CE7744A97.title: "Nave da guerra"
	quest.3531295CE7744A97.quest_subtitle: "La fortezza volante"
	quest.3531295CE7744A97.quest_desc: [
		"Dirigibile da carico, due motori, scafi, vele e &6ingranaggi industriali&r d'acciaio."
		"Il velivolo più grande: porta tutta la squadra e monta armi."
	]
	quest.3E173D5F929AB429.title: "Armi di bordo"
	quest.3E173D5F929AB429.quest_subtitle: "Difesa dall'alto"
	quest.3E173D5F929AB429.quest_desc: [
		"Il &6cannone rotante&r usa gli ingranaggi industriali; balestra pesante e vano bombe sono più semplici."
		"Si montano negli slot arma del velivolo. &cAttenti a non colpire la colonia.&r"
	]
	quest.21E26F147A00019A.title: "Potenziamenti di bordo"
	quest.21E26F147A00019A.quest_subtitle: "Atterraggi morbidi"
	quest.21E26F147A00019A.quest_desc: [
		"Carrello d'atterraggio migliorato e tubi robusti: ferro, rame e carbone."
		"Si mettono negli slot potenziamento di qualsiasi velivolo."
	]
	quest.43D2433D009CDE61.title: "Cruscotto"
	quest.43D2433D009CDE61.quest_subtitle: "Strumenti di volo"
	quest.43D2433D009CDE61.quest_desc: [
		"Il &6giroscopio&r stabilizza il volo; con il visore vedi quota e velocità."
		"Un cannocchiale di rame aiuta a cercare strutture dall'alto."
	]
	quest.30D3F077A53440AE.title: "Componenti d'acciaio"
	quest.30D3F077A53440AE.quest_subtitle: "Più spinta, più corazza"
	quest.30D3F077A53440AE.quest_desc: [
		"Con le piastre d'&6acciaio&r: elica potenziata, caldaia d'acciaio e rinforzo dello scafo."
		"Più velocità, meno carburante, più resistenza ai colpi."
	]
	quest.6FB8E10CC7498F1B.title: "Motori speciali"
	quest.6FB8E10CC7498F1B.quest_subtitle: "Eco e Nether"
	quest.6FB8E10CC7498F1B.quest_desc: [
		"Il motore &6eco&r (oro, slime, acciaio) consuma meno."
		"Il motore del &6Nether&r (netherite, blaze, magma, acciaio) è il più potente."
	]
	quest.3ABC9673FDB9CE34.title: "Corazza alata"
	quest.3ABC9673FDB9CE34.quest_subtitle: "Armatura e ali insieme"
	quest.3ABC9673FDB9CE34.quest_desc: [
		"Sull'&6Incudine a Fusione Meccanica&r unisci il pettorale di ignitium alle elitre."
		"Niente più scelta tra protezione e volo."
	]
	quest.7A2B3FDDDFA2844B.title: "Elitre dell'anima"
	quest.7A2B3FDDDFA2844B.quest_subtitle: "Dall'Altro Lato"
	quest.7A2B3FDDDFA2844B.quest_desc: [
		"Elitre, cristalli e polvere d'anima, ossa di sculk: materiali dell'&6Altro Lato&r, oltre il portale delle città antiche."
		"Si ricaricano e danno una spinta senza razzi."
	]
	chapter_group.538E5527864EF186.title: "Le Ere"
	chapter_group.258DA2B8BFDB53BA.title: "Approfondimenti"
}
