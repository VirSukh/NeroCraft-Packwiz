		"&7Ingredienti:&r 4x Filo di stagno, 2x Induttore, 2x Cavo di stagno, 1x Scocca di macchina base"
		"&7Serve per:&r Filo magnetico di cupronichel"
	]
	quest.44608357513E3720.title: "Braccio robotico"
	quest.44608357513E3720.quest_subtitle: "Componente"
	quest.44608357513E3720.quest_desc: [
		"Componente facoltativo per imballatori, cave e assemblatori."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 3x Cavo di stagno, 2x Motore, 2x Asta d'acciaio, 1x Pistone, 1x Circuito analogico"
		"&7Serve per:&r Imballatore elettrico, Cava elettrica, Potenziamento base, Assemblatore"
	]
	quest.1E84C2BAAA678181.title: "Trafilatrice elettrica"
	quest.1E84C2BAAA678181.quest_subtitle: "Macchina"
	quest.1E84C2BAAA678181.quest_desc: [
		"Macchina che produce fili: versione elettrica della trafilatrice d'acciaio."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 4x Motore, 2x Cavo di stagno, 2x Circuito analogico, 1x Scocca di macchina base"
	]
	quest.15C442A72387CC9B.title: "Pannello solare LV"
	quest.15C442A72387CC9B.quest_subtitle: "Macchina"
	quest.15C442A72387CC9B.quest_desc: [
		"Pannello che produce energia: utile come prima fonte elettrica pulita."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 2x Asta di stagno, 1x Circuito analogico, 2x Tubo per fluidi, 1x Scocca di macchina base, 2x Cavo di stagno, 1x Motore"
	]
	quest.30B64A41858963FC.title: "Generatore diesel LV"
	quest.30B64A41858963FC.quest_subtitle: "Macchina"
	quest.30B64A41858963FC.quest_desc: [
		"Generatore che produce energia a partire dal combustibile: va rifornito con regolarità."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 2x Pompa, 1x Circuito analogico, 2x Ingranaggio di stagno, 1x Scocca di macchina base, 3x Cavo di stagno"
	]
	quest.635D020F0F302095.title: "Compressore elettrico"
	quest.635D020F0F302095.quest_subtitle: "Macchina"
	quest.635D020F0F302095.quest_desc: [
		"Macchina che compatta i materiali in lingotti e piastre."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 4x Pistone, 2x Circuito analogico, 2x Cavo di stagno, 1x Scocca di macchina base"
	]
	quest.5B24F0E24E03C86D.title: "Macchina per inscatolamento elettrica"
	quest.5B24F0E24E03C86D.quest_subtitle: "Macchina"
	quest.5B24F0E24E03C86D.quest_desc: [
		"Macchina che inscatola i fluidi: utile su una linea di produzione."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 2x Tubo per fluidi, 1x Rotore di stagno, 2x Pompa, 1x Scocca di macchina base, 2x Circuito analogico, 1x Nastro trasportatore"
	]
	quest.6126B54022E19A6F.title: "Motore grande"
	quest.6126B54022E19A6F.quest_subtitle: "Componente"
	quest.6126B54022E19A6F.quest_desc: [
		"Componente facoltativo per la cava elettrica."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 6x Motore, 1x Circuito elettronico, 2x Asta di alluminio"
		"&7Serve per:&r Cava elettrica"
	]
	quest.1EAF4530AD051006.title: "Disimballatore elettrico"
	quest.1EAF4530AD051006.quest_subtitle: "Macchina"
	quest.1EAF4530AD051006.quest_desc: [
		"Macchina che apre i pacchi: si collega ai nastri trasportatori."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 2x Motore, 2x Circuito analogico, 2x Nastro trasportatore, 1x Scocca di macchina base, 2x Cavo di stagno"
	]
	quest.2567E758D43CEF79.title: "Macchina piegatrice elettrica"
	quest.2567E758D43CEF79.quest_subtitle: "Macchina"
	quest.2567E758D43CEF79.quest_desc: [
		"Macchina che piega le piastre: versione elettrica della piegatrice di bronzo."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 2x Circuito analogico, 2x Pistone, 2x Motore, 1x Scocca di macchina base, 2x Cavo di stagno"
	]
	quest.33FF2B28939A5BEB.title: "Forno elettrico"
	quest.33FF2B28939A5BEB.quest_subtitle: "Macchina"
	quest.33FF2B28939A5BEB.quest_desc: [
		"Forno che fonde i materiali: più veloce della fornace semplice."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 4x Filo magnetico di cupronichel, 2x Circuito analogico, 1x Scocca di macchina base, 2x Cavo di stagno"
	]
	quest.2F236210A75D1D0C.title: "Fonderia di leghe elettrica"
	quest.2F236210A75D1D0C.quest_subtitle: "Macchina"
	quest.2F236210A75D1D0C.quest_desc: [
		"Macchina che produce leghe: conviene automatizzarla con le polveri pronte."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 3x Filo magnetico di cupronichel, 1x Rotore di stagno, 2x Circuito analogico, 1x Scocca di macchina base, 2x Cavo di stagno"
	]
	quest.6B4BFB1DD39DE0D4.title: "Macchina da taglio elettrica"
	quest.6B4BFB1DD39DE0D4.quest_subtitle: "Macchina"
	quest.6B4BFB1DD39DE0D4.quest_desc: [
		"Macchina che taglia i materiali: richiede una lama di invar e un nastro trasportatore."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 2x Vetro, 1x Lama rotante in invar, 2x Motore, 1x Scocca di macchina base, 2x Circuito analogico, 1x Nastro trasportatore"
	]
	quest.418F73A5F088DBF0.title: "Scocca di macchina avanzata"
	quest.418F73A5F088DBF0.quest_subtitle: "Componente"
	quest.418F73A5F088DBF0.quest_desc: [
		"Scocca per le macchine avanzate: serve per la cava elettrica."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 1x Circuito elettronico, 2x Batteria di silicio, 1x Involucro di macchina avanzato, 3x Cavo di elettro"
		"&7Serve per:&r Cava elettrica"
	]
	quest.7C8B25251644F0EC.title: "Assemblatore"
	quest.7C8B25251644F0EC.quest_subtitle: "Macchina"
	quest.7C8B25251644F0EC.quest_desc: [
		"Macchina che assembla i componenti: serve per il potenziamento base."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 4x Braccio robotico, 2x Circuito analogico, 2x Nastro trasportatore, 1x Scocca di macchina base"
		"&7Serve per:&r Potenziamento base"
	]
	quest.7C76062959EDF3AC.title: "Imballatore elettrico"
	quest.7C76062959EDF3AC.quest_subtitle: "Macchina"
	quest.7C76062959EDF3AC.quest_desc: [
		"Macchina che impacchetta gli oggetti sui nastri trasportatori."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 2x Braccio robotico, 2x Circuito analogico, 2x Nastro trasportatore, 1x Scocca di macchina base, 2x Cavo di stagno"
	]
	quest.11EAA934E07FCBA4.title: "Potenziamento base"
	quest.11EAA934E07FCBA4.quest_subtitle: "Macchina"
	quest.11EAA934E07FCBA4.quest_desc: [
		"Potenziamento di base costruito con l'assemblatore."
		"&7Si fa con:&r Assemblatore"
		"&7Ingredienti:&r 2x Nastro trasportatore, 4x Motore, 2x Braccio robotico, 1x Scheda del circuito analogico"
	]
	quest.3E602FA3F3CFE5E5.title: "Cava elettrica"
	quest.3E602FA3F3CFE5E5.quest_subtitle: "Macchina"
	quest.3E602FA3F3CFE5E5.quest_desc: [
		"Macchina che scava automaticamente: il traguardo finale di questa era."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 4x Motore grande, 1x Braccio robotico, 2x Circuito elettronico, 1x Scocca di macchina avanzata, 1x Cava a vapore"
	]
	chapter.212AE40DF433ADB9.title: "Era 4 - Rete Digitale"
	chapter.212AE40DF433ADB9.chapter_subtitle: [
		"Dal Controller ME al Razzo Tier 1"
	]
	quest.619D6D1B2FD73578.title: "La rete si accende"
	quest.619D6D1B2FD73578.quest_subtitle: "Quattro fronti per una squadra"
	quest.619D6D1B2FD73578.quest_desc: [
		"&7&oIl Controller ronza: NeroCraft ha un cervello.&r"
		"Meta dell'Era 4: il &6Razzo Tier 1&r. Si monta nell'&6Assemblatore&r di MI con telaio del motore, 4 piastre d'acciaio, 4 alette e un &cLingotto di Witherite&r dell'Araldo."
		"&aDividetevi: rete ME, industria, colonia e spedizione alla Fabbrica Antica.&r"
	]
	task.6802989431E69701.title: "Abbiamo deciso chi fa cosa"
	quest.2E7B37BBA94B8096.title: "Energia alla rete"
	quest.2E7B37BBA94B8096.quest_subtitle: "Cavi e accettore"
	quest.2E7B37BBA94B8096.quest_desc: [
		"&7&oIl Controller è acceso ma ha fame.&r"
		"&6Accettore d'energia&r: ferro, vetro di quarzo e rame. Collegalo ai cavi di MI: l'energia passa da sola."
		"&6Cavi di vetro di fluix&r per unire Controller e macchine."
	]
	quest.2486BBCEC6EF2362.title: "Incisore e presse"
	quest.2486BBCEC6EF2362.quest_subtitle: "Quattro stampi nei meteoriti"
	quest.2486BBCEC6EF2362.quest_desc: [
		"&7&oDentro ogni meteorite c'è uno scrigno di metallo.&r"
		"&6Incisore&r: ferro, rame e un pistone."
		"Le &6presse&r non si craftano: cercatele nei meteoriti con la bussola dei meteoriti. Ne servono quattro diverse."
	]
	quest.5B2519960D6519F8.title: "Processori"
	quest.5B2519960D6519F8.quest_subtitle: "Logica, calcolo, ingegneria"
	quest.5B2519960D6519F8.quest_desc: [
		"&7&oOro, quarzo e diamante, stampati e incollati.&r"
		"Nell'Incisore: circuito stampato (oro, quarzo certus o diamante) + silicio stampato + redstone."
		"&aScorciatoia:&r anche l'Impacchettatrice e l'Assemblatore di MI li producono, con il silicio dell'Altoforno."
	]
	quest.26607082CDB10471.title: "Il magazzino digitale"
	quest.26607082CDB10471.quest_subtitle: "Drive, celle, terminale"
	quest.26607082CDB10471.quest_desc: [
		"&7&oMille casse in un blocco solo.&r"
		"&6Unità ME&r e &6celle da 1k&r per conservare; un &6Terminale&r per vedere tutto da un posto."
		"Un magazzino comune per tutta la squadra: &aniente più casse sparse&r."
	]
	quest.7F129D285162202A.title: "La rete che crafta"
	quest.7F129D285162202A.quest_subtitle: "Schemi, fornitori, CPU"
	quest.7F129D285162202A.quest_desc: [
		"&7&oChiedi cento piastre e la rete le fa da sola.&r"
		"&6Fornitore di schemi&r collegato all'&6Assemblatore molecolare&r o alle macchine di MI."
		"Una CPU di crafting: almeno un'&6unità di crafting&r e un'archiviazione da 1k. Gli schemi si scrivono al terminale di codifica."
	]
	quest.4790931400CBB3D5.title: "Rete senza fili"
	quest.4790931400CBB3D5.quest_subtitle: "Il magazzino in tasca"
	quest.4790931400CBB3D5.quest_desc: [
		"&7&oDal campo di battaglia al magazzino, senza tornare a casa.&r"
		"&6Punto d'accesso senza fili&r sulla rete e un &6Terminale senza fili&r a testa. Caricalo nel Caricatore."
	]
	quest.1B6B505A6CB17593.title: "Tagliapietre esperto"
	quest.1B6B505A6CB17593.quest_subtitle: "La colonia lavora al caldo"
	quest.1B6B505A6CB17593.quest_desc: [
		"&7&oIl Tagliapietre chiede un forno più grande.&r"
		"Portate il &6Tagliapietre&r al livello 3: solo lui sa fare il Pannello Termoisolante."
	]
	task.11D1E82BF97249E4.title: "Il Tagliapietre è al livello 3"
	quest.547530BB30B72E5C.title: "Pannello Termoisolante"
	quest.547530BB30B72E5C.quest_subtitle: "Lavoro della colonia"
	quest.547530BB30B72E5C.quest_desc: [
		"&7&oCaldo da un lato, freddo dall'altro.&r"
		"Non si fa al banco. Il Tagliapietre usa 6 polveri di quarzo, 2 mattoni d'argilla refrattaria e un blocco di magma."
		"Chiedilo dal Magazzino e metti i materiali negli scaffali."
	]
	quest.480038F922EFB8D8.title: "Terminale della Colonia"
	quest.480038F922EFB8D8.quest_subtitle: "La rete parla con i coloni"
	quest.480038F922EFB8D8.quest_desc: [
		"&7&oI fattorini non devono più cercare: chiedono alla rete.&r"
		"Un Terminale ME, 2 scaffali della colonia, ferro e fluix."
		"Collega la &6rete ME&r alla colonia: le richieste dei coloni si servono dal magazzino digitale."
	]
	quest.625488E684A26288.title: "Taglierina dell'Architetto ME"
	quest.625488E684A26288.quest_subtitle: "Blocchi decorativi dalla rete"
	quest.625488E684A26288.quest_desc: [
		"4 &6Pannelli Termoisolanti&r, una Taglierina dell'Architetto, un processore d'ingegneria, 2 cristalli di fluix e un Circuito Elettronico."
		"Taglia i blocchi di Domum Ornamentum prendendo i materiali dalla rete."
	]
	quest.4BAE9AAA60E29178.title: "Zaino da spedizione"
	quest.4BAE9AAA60E29178.quest_subtitle: "Gettoni dall'Harbinger"
	quest.4BAE9AAA60E29178.quest_desc: [
		"Lo Zaino non si potenzia al banco: slot e alloggiamenti si sbloccano con i &egettoni&r, e i gettoni li lasciano solo i boss."
		"Sconfiggete &6The Harbinger&r: ognuno di voi entro 64 blocchi riceve &e3 gettoni&r la prima volta, &e1&r le successive."
		"&7Costi: &e1 gettone&7 per slot (36 da sbloccare oltre ai 9 iniziali, fino a 9x5); alloggiamenti per potenziamenti &e2/3/4/5&7 gettoni.&r"
		"&7I gettoni sono legati a chi li riceve: non si scambiano.&r"
	]
	quest.13F6C85BC39A2674.title: "Bracci robotici e nastri"
	quest.13F6C85BC39A2674.quest_subtitle: "Mani d'acciaio"
	quest.13F6C85BC39A2674.quest_desc: [
		"&7&oL'officina impara a montare da sola.&r"
		"&6Braccio robotico&r: motori, asta d'acciaio, pistone di MI, cavi di stagno e un Circuito Analogico."
		"&6Nastro trasportatore&r: motori, fogli di gomma e cavo di stagno."
	]
	quest.200B9A098DFBB8D1.title: "Assemblatore"
	quest.200B9A098DFBB8D1.quest_subtitle: "Dove nascerà il razzo"
	quest.200B9A098DFBB8D1.quest_desc: [
		"&7&oUna macchina che costruisce macchine.&r"
		"Scafo di macchina base al centro, 4 bracci robotici negli angoli, 2 nastri e 2 Circuiti Analogici."
		"Va a corrente LV: tenetelo collegato. &aIl razzo si monta solo qui.&r"
	]
	quest.176FF2626132560F.title: "Telaio del motore"
	quest.176FF2626132560F.quest_subtitle: "Lo scheletro della spinta"
	quest.176FF2626132560F.quest_desc: [
		"&7&oAste d'acciaio saldate a croce.&r"
		"Aste d'acciaio di Ad Astra: 2 piastre d'acciaio in colonna danno 4 aste."
		"Telaio: 8 aste attorno a una piastra d'acciaio."
	]
	quest.3811CBFD2283AC90.title: "Alette e piastre"
	quest.3811CBFD2283AC90.quest_subtitle: "Il resto della carcassa"
	quest.3811CBFD2283AC90.quest_desc: [
		"&7&oSul piazzale le alette aspettano in fila.&r"
		"Alette: 6 piastre d'acciaio a forma di freccia danno 4 alette."
		"Tenete da parte anche &64 piastre d'acciaio di MI&r per l'Assemblatore."
	]
	quest.281AA17C55C11494.title: "Occhio Meccanico"
	quest.281AA17C55C11494.quest_subtitle: "Una bussola per la fabbrica"
	quest.281AA17C55C11494.quest_desc: [
		"&7&oSotto terra qualcosa di antico è ancora acceso.&r"
		"4 blocchi di redstone, 4 lingotti di ferro e un occhio di ender."
		"Lanciato come un occhio di ender, indica la &6Fabbrica Antica&r dell'Araldo."
	]
	quest.10929AFB9F7F3715.title: "La Fabbrica Antica"
	quest.10929AFB9F7F3715.quest_subtitle: "Una macchina che dorme"
	quest.10929AFB9F7F3715.quest_desc: [
		"&7&oCorridoi di metallo, torrette, e in fondo un gigante spento.&r"
		"Seguite l'Occhio fino alla Fabbrica e &asegnate la posizione&r: una waystone qui serve a tutti."
	]
	quest.2CAED20CF61D35F0.title: "La Stella del Nether"
	quest.2CAED20CF61D35F0.quest_subtitle: "La chiave per svegliarlo"
	quest.2CAED20CF61D35F0.quest_desc: [
		"&7&oL'Araldo non si sveglia da solo.&r"
		"Va attivato con una &6Stella del Nether&r: serve il &cWither&r. Tre teschi di wither scheletro dalle fortezze del Nether."
		"Evocatelo lontano dalla colonia. &cAnche il Wither cresce con le ere.&r"
		"&7Come ogni boss, il Wither lascia &egettoni dello zaino&7 a chi è entro 64 blocchi: 3 la prima volta, 1 le successive.&r"
	]
	quest.18B3717BD96535CD.title: "Squadra contro l'Araldo"
	quest.18B3717BD96535CD.quest_subtitle: "Laser, missili, cariche"
	quest.18B3717BD96535CD.quest_desc: [
		"&7&oUn colosso di metallo con l'anima di un Wither.&r"
		"L'&cAraldo&r spara laser e missili avvizziti: &adecidete chi lo tiene impegnato, chi cura e chi colpisce da lontano&r."
		"&cÈ più forte del Mostro di Netherite e cresce con le ere e a ogni uccisione.&r Latte contro l'avvizzimento, cibo, armature migliori."
	]
	task.78A2588157FFA5F8.title: "Ruoli decisi, equipaggiamento pronto"
	quest.34FE7375236DEAE6.title: "L'Araldo"
	quest.34FE7375236DEAE6.quest_subtitle: "Il Witherite che apre il cielo"
	quest.34FE7375236DEAE6.quest_desc: [
		"&7&oIl giorno in cui la Fabbrica Antica tacque per sempre.&r"
		"Usate la Stella del Nether sull'&cAraldo&r (The Harbinger) e &acombattete insieme&r."
		"Lascia un &6Blocco di Witherite&r: al banco dà 9 lingotti. Uno serve al razzo, il resto nelle casse comuni."
		"&6Gettoni:&r ogni giocatore entro 64 blocchi riceve &e3 gettoni&r alla prima uccisione di questo boss, &e1&r alle successive."
	]
	quest.6D04C6126C6E2B5E.title: "Tuta spaziale"
	quest.6D04C6126C6E2B5E.quest_subtitle: "Una a testa"
	quest.6D04C6126C6E2B5E.quest_desc: [
		"&7&oLassù non c'è aria. Né caldo.&r"
		"Casco, tuta, pantaloni e stivali spaziali: piastre d'acciaio, lana, vetro. La tuta vuole anche bombole e un ingranaggio dell'ossigeno."
		"&aServe un set per ogni giocatore che parte.&r"
	]
	quest.437F1EB8C8090E30.title: "Pronti al lancio"
	quest.437F1EB8C8090E30.quest_subtitle: "Carburante, ossigeno, rampa"
	quest.437F1EB8C8090E30.quest_desc: [
		"&7&oSul piazzale si prova il conto alla rovescia.&r"
		"&6Raffineria&r: petrolio dai pozzi negli oceani diventa carburante. Va a corrente: i cavi di MI la alimentano."
		"&6Caricatore d'ossigeno&r: dall'acqua riempie le tute. &6Rampa di lancio&r: piastre e aste d'acciaio."
	]
	quest.56A9BCF5A0F629EB.title: "&6&lRazzo Tier 1&r"
	quest.56A9BCF5A0F629EB.quest_subtitle: "Il razzo apre l'Era 5"
	quest.56A9BCF5A0F629EB.quest_desc: [
		"&7&oAcciaio della colonia, ingegno dell'officina, il cuore di un colosso.&r"
		"Nell'&6Assemblatore&r: telaio del motore, 4 piastre d'acciaio di MI, 4 alette e un &cLingotto di Witherite&r."
		"Appena qualcuno lo ottiene, &atutta la squadra entra nell'Era 5&r."
	]
	quest.259864B6F073805F.title: "Torcia di redstone"
	quest.259864B6F073805F.quest_subtitle: "Componente"
	quest.259864B6F073805F.quest_desc: [
		"Piccola sorgente di segnale di redstone, qui serve soprattutto come ingrediente dell'emettitore di pietrarossa ME."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 1x Polvere di redstone, 1x Bastone"
		"&7Serve per:&r Emettitore di pietrarossa ME"
	]
	quest.6FC8757D2E502792.title: "Pistone"
	quest.6FC8757D2E502792.quest_subtitle: "Componente"
	quest.6FC8757D2E502792.quest_desc: [
		"Componente meccanico che serve in diversi bus della rete AE2, da preparare in anticipo in quantita."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 3x Assi di acacia, 4x Pietranera, 1x Lingotto di ferro, 1x Polvere di redstone"
