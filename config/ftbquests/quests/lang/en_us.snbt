	chapter.327AE6C79D3E57CA.title: "Classi"
	chapter.327AE6C79D3E57CA.chapter_subtitle: [
		"Un ruolo per ognuno, una squadra completa"
	]
	quest.7488A0AEECEDC30F.title: "Apri l'albero"
	quest.7488A0AEECEDC30F.quest_subtitle: "Punti abilità e ruoli"
	quest.7488A0AEECEDC30F.quest_desc: [
		"Ogni uccisione dà esperienza e punti abilità. &aL'esperienza si divide con i compagni entro 200 blocchi: cacciate insieme.&r"
		"Apri l'albero con K (tasto di base). Ci sono 8 classi, ma &cognuno ne ha UNA sola&r: la prima radice che sblocchi chiude le altre 7."
		"&aMettetevi d'accordo prima di spendere il primo punto&r: chi cura, chi tiene la prima linea, chi colpisce da lontano."
		"Farmare un solo punto non rende: oltre 15 uccisioni per chunk in 5 minuti non danno più punti."
	]
	task.15D7B79A1E1DDD30.title: "Ho scelto la mia classe con la squadra"
	quest.152FED2C41BCFC5B.title: "Mago arcano"
	quest.152FED2C41BCFC5B.quest_subtitle: "Danno a distanza e mobilità"
	quest.152FED2C41BCFC5B.quest_desc: [
		"Missili e esplosioni arcane, più il teletrasporto breve."
		"Gli incantesimi si lanciano con la bacchetta in mano e consumano &6Rune Arcane&r."
	]
	quest.13B1D5138B9C85F1.title: "Mago del fuoco"
	quest.13B1D5138B9C85F1.quest_subtitle: "Danno ad area"
	quest.13B1D5138B9C85F1.quest_desc: [
		"Soffio di fuoco, meteore e tempeste di fiamme sui gruppi di nemici."
		"La bacchetta da novizio dà potere del fuoco. Gli incantesimi consumano &6Rune di Fuoco&r."
	]
	quest.137D538D620A74C3.title: "Mago del gelo"
	quest.137D538D620A74C3.quest_subtitle: "Controllo e rallentamento"
	quest.137D538D620A74C3.quest_desc: [
		"Rallenta e congela i nemici: &aprotegge la squadra mentre gli altri colpiscono&r."
		"Gli incantesimi consumano &6Rune di Gelo&r."
	]
	quest.6EB373A2331C86FC.title: "Sacerdote"
	quest.6EB373A2331C86FC.quest_subtitle: "Il guaritore della squadra"
	quest.6EB373A2331C86FC.quest_desc: [
		"Cura i compagni e li protegge con barriere. &aContro i boss è il ruolo più prezioso.&r"
		"Gli incantesimi consumano &6Rune di Guarigione&r."
	]
	quest.2DBF8CEBBFA78D61.title: "Paladino"
	quest.2DBF8CEBBFA78D61.quest_subtitle: "Difensore che cura"
	quest.2DBF8CEBBFA78D61.quest_desc: [
		"Regge i colpi in prima linea e &acura chi gli sta vicino&r."
		"Anche i suoi incantesimi consumano &6Rune di Guarigione&r."
	]
	quest.5EFD12F3E012F9AF.title: "Guerriero"
	quest.5EFD12F3E012F9AF.quest_subtitle: "La prima linea"
	quest.5EFD12F3E012F9AF.quest_desc: [
		"Carica, urla di battaglia e colpi pesanti: &aattira i nemici e li tiene lontani dai maghi&r."
		"Si gioca con &6asce doppie&r e &6glaive&r."
	]
	quest.68BB1F4B59054663.title: "Ladro"
	quest.68BB1F4B59054663.quest_subtitle: "Colpi rapidi alle spalle"
	quest.68BB1F4B59054663.quest_desc: [
		"Tanto danno su un bersaglio solo, invisibilità e passi nell'ombra."
		"Si gioca con &6pugnali&r e &6falcetti&r."
	]
	quest.740AB734FA1775FC.title: "Arciere"
	quest.740AB734FA1775FC.quest_subtitle: "Danno costante da lontano"
	quest.740AB734FA1775FC.quest_desc: [
		"Raffiche di frecce e colpi potenti da distanza sicura."
		"Le abilità scagliano &6frecce&r dall'arco: portatene sempre una scorta."
	]
	quest.1643E44103B5D4F1.title: "Il Tavolo degli Incantesimi"
	quest.1643E44103B5D4F1.quest_subtitle: "Libri e pergamene"
	quest.1643E44103B5D4F1.quest_desc: [
		"Il &6Tavolo degli Incantesimi&r crea e riempie i Libri degli Incantesimi, anche con le pergamene trovate in giro."
		"Il libro si indossa nel suo slot (Curios), non in mano: in mano tieni l'arma della classe. &cSe muori, il libro cade con il resto.&r"
	]
	quest.4B31ABED01B2EAB1.title: "Rune"
	quest.4B31ABED01B2EAB1.quest_subtitle: "Le munizioni dei maghi"
	quest.4B31ABED01B2EAB1.quest_desc: [
		"Maghi, sacerdoti e paladini consumano rune a ogni incantesimo: pietra più un reagente (ametista, polvere da sparo, palla di neve, pepita d'oro)."
		"A mano se ne ottengono poche: l'&6Altare delle Rune&r ne dà quattro volte tante. Una &6Borsa delle Rune&r equipaggiata le fornisce da sola."
	]
	quest.2C99ADB5B910E82D.title: "Abilità delle armi"
	quest.2C99ADB5B910E82D.quest_subtitle: "Il secondo albero"
	quest.2C99ADB5B910E82D.quest_desc: [
		"Nell'albero c'è una seconda scheda, &6Weapon Skills&r: abilità legate al tipo d'arma (spada, ascia, arco, pugnale, bastone...)."
		"Ha 9 punti a parte, separati dalla classe e liberi per tutti. Ogni arma ha 3 nodi: bastano per completare 3 armi, quindi scegli quelle che usi davvero."
	]
	task.2299C082A679AB1C.title: "Ho speso un punto in Weapon Skills"
	quest.7D78D9551790F5CE.title: "Sfera dell'Oblio"
	quest.7D78D9551790F5CE.quest_subtitle: "Ricominciare da capo"
	quest.7D78D9551790F5CE.quest_desc: [
		"&cLa classe scelta è definitiva&r, tranne in un caso: la &6Orb of Oblivion&r azzera i punti delle classi e te li restituisce, così puoi scegliere un'altra classe. Le Weapon Skills restano come sono."
		"Costa un diamante e quattro bottiglie d'esperienza: &atenetela per quando la squadra deve davvero riorganizzare i ruoli&r."
	]
	task.505E7459973CF4AB.title: "So come cambiare classe"
	chapter.6903973460DC3206.title: "La Colonia"
	chapter.6903973460DC3206.chapter_subtitle: [
		"Edifici, coloni, difesa, tasse e titoli"
	]
	quest.6FE0333563586619.title: "Il cuore della colonia"
	quest.6FE0333563586619.quest_subtitle: "Tutto passa dal Municipio"
	quest.6FE0333563586619.quest_desc: [
		"&7&oChi vuole finire MineColonies parte da qui.&r"
		"Clic destro sul &6Municipio&r: coloni, edifici, ordini di lavoro e permessi."
		"Siete tutti ufficiali della stessa colonia: chiunque può controllarla e rifornirla."
		"&aLa colonia cresce e si migliora da sola: voi portate materiali e ColonyBucks.&r"
	]
	task.7F925351F0A361BC.title: "Ho aperto il Municipio e visto coloni ed edifici"
	quest.244A8C8175BF2B3B.title: "Il bastone da costruzione"
	quest.244A8C8175BF2B3B.quest_subtitle: "Serve in quasi ogni ricetta della colonia"
	quest.244A8C8175BF2B3B.quest_desc: [
		"Il &6Bastone da costruzione&r dorato di Structurize sta nelle ricette dei capanni e degli strumenti della colonia."
		"Tenetene sempre qualcuno nelle casse comuni."
	]
	quest.1C66DCEFFB777BA7.title: "Il blocco appunti"
	quest.1C66DCEFFB777BA7.quest_subtitle: "Cosa chiedono i coloni"
	quest.1C66DCEFFB777BA7.quest_desc: [
		"Il &6Blocco appunti&r, collegato al Municipio, mostra tutte le richieste aperte dei coloni."
		"Comodo in squadra: chi passa dal villaggio vede subito cosa manca."
	]
	quest.4C39B49F2EB5972D.title: "Le storie dei coloni"
	quest.4C39B49F2EB5972D.quest_subtitle: "Missioni dentro la colonia"
	quest.4C39B49F2EB5972D.quest_desc: [
		"I coloni con un punto esclamativo sulla testa hanno una richiesta o una storia da raccontare."
		"Il &6Registro delle missioni&r tiene traccia di quelle accettate."
	]
	task.6340B155F61EB6A0.title: "Ho completato una missione di un colono"
	quest.4362A427E8C5F53A.title: "La Taverna"
	quest.4362A427E8C5F53A.quest_subtitle: "Nuovi coloni dalla strada"
	quest.4362A427E8C5F53A.quest_desc: [
		"Alla &6Taverna&r arrivano visitatori di passaggio, a volte con abilità alte."
		"Dalla finestra della Taverna potete assumerli pagando quello che chiedono."
	]
	task.5AC4ADB52FB10364.title: "Abbiamo assunto un visitatore della Taverna"
	quest.19285A909AFC7431.title: "Coloni felici"
	quest.19285A909AFC7431.quest_subtitle: "La felicità paga le tasse"
	quest.19285A909AFC7431.quest_desc: [
		"La felicità dipende da cibo vario, case, sicurezza, salute e lavoro."
		"Coloni felici lavorano meglio e &6pagano più tasse&r. I malati vanno all'Ospedale."
		"&cUn tesoro in debito abbassa la felicità di tutti.&r"
	]
	task.27CF4D4BE451937E.title: "La felicità della colonia è almeno 7 su 10"
	quest.49C3AA77D5775509.title: "Un vero villaggio"
	quest.49C3AA77D5775509.quest_subtitle: "Municipio al livello 3"
	quest.49C3AA77D5775509.quest_desc: [
		"Dal livello 3 il Municipio sblocca edifici nuovi e alterna nuove costruzioni e migliorie."
		"Tenete pieni il Magazzino e il tesoro: i Costruttori non aspettano altro."
	]
	task.2EA79613DB7E8766.title: "Il Municipio è al livello 3"
	quest.18801CB53CD4C7C3.title: "Una cittadina"
	quest.18801CB53CD4C7C3.quest_subtitle: "Municipio al livello 4"
	quest.18801CB53CD4C7C3.quest_desc: [
		"La colonia ora è una cittadina: più coloni, più richieste, più tasse."
		"Il livello 5 arriva con lo spazio: lo trovate nell'Era 5."
	]
	task.56E8B4473716A431.title: "Il Municipio è al livello 4"
	quest.54E21A6F60C6D61B.title: "&6&lLa capitale&r"
	quest.54E21A6F60C6D61B.quest_subtitle: "MineColonies al massimo"
	quest.54E21A6F60C6D61B.quest_desc: [
		"&7&oDal primo Capanno a una capitale: la colonia è finita.&r"
		"Ogni edificio principale al livello 5. Un traguardo di tutta la squadra."
	]
	task.5FF8272AD9B0824D.title: "Università, Fabbro, Magazzino e Caserma sono al livello 5"
	quest.61DEB56CC4EC4C4F.title: "L'Università"
	quest.61DEB56CC4EC4C4F.quest_subtitle: "Le ricerche della colonia"
	quest.61DEB56CC4EC4C4F.quest_desc: [
		"L'&6Università&r apre da sola al livello 1 e studia le ricerche una dopo l'altra."
		"Ogni ricerca costa i suoi materiali più qualche ColonyBuck: se il tesoro è vuoto, aspetta."
		"Dalla finestra dell'Università vedete l'albero e cosa sta studiando."
	]
	task.48CC923ECCC82031.title: "Ho visto quale ricerca sta studiando l'Università"
	quest.11B70AE1B17575A6.title: "Scuola e Biblioteca"
	quest.11B70AE1B17575A6.quest_subtitle: "Coloni più bravi"
	quest.11B70AE1B17575A6.quest_desc: [
		"Alla &6Scuola&r i bambini imparano, in &6Biblioteca&r gli adulti alzano le abilità."
		"Coloni più abili lavorano più in fretta in ogni edificio."
	]
	task.22E970823A31CD03.title: "La colonia ha una Scuola e una Biblioteca"
	quest.4F6039AAA31ABDCF.title: "Pergamene di ritorno"
	quest.4F6039AAA31ABDCF.quest_subtitle: "A casa in un attimo"
	quest.4F6039AAA31ABDCF.quest_desc: [
		"L'&6Incantatore&r della colonia scrive pergamene che riportano al Municipio."
		"Si ordinano come il Sigillo: scorta minima nel Magazzino. Servono carta, una bussola e il bastone da costruzione."
	]
	quest.6E6CEC3E423431BF.title: "Torre di guardia"
	quest.6E6CEC3E423431BF.quest_subtitle: "La prima difesa"
	quest.6E6CEC3E423431BF.quest_desc: [
		"Una &6Torre di guardia&r ospita una guardia che pattuglia la colonia."
		"Con almeno una torre le tasse salgono dell'8%. Ma le guardie hanno un mantenimento: occhio al tesoro."
	]
	quest.751999999750C17B.title: "Predoni alle porte"
	quest.751999999750C17B.quest_subtitle: "Il primo raid"
	quest.751999999750C17B.quest_desc: [
		"&7&oUn corno risuona di notte.&r"
		"Quando la colonia cresce arrivano i raid: barbari, pirati, egizi, norreni o amazzoni, secondo il bioma."
		"Ogni raid è più forte del precedente. &cDifendete insieme le case, non solo il Municipio.&r"
	]
	task.57DA1FDBFE170B33.title: "Abbiamo respinto un raid"
	quest.1CA7DE0387BDDEF0.title: "La Caserma"
	quest.1CA7DE0387BDDEF0.quest_subtitle: "Un esercito per la colonia"
	quest.1CA7DE0387BDDEF0.quest_desc: [
		"La &6Caserma&r e le sue torri ospitano molte guardie insieme: la risposta ai raid grossi."
		"Accademia di combattimento e Campo di tiro allenano cavalieri e arcieri."
	]
	task.1D6DB3E1E1D206A4.title: "La Caserma è costruita e ha almeno una torre"
	quest.2A385F06F15171E2.title: "Armatura a piastre"
	quest.2A385F06F15171E2.quest_subtitle: "Il Fabbro arma le guardie"
	quest.2A385F06F15171E2.quest_desc: [
		"Con il Fabbro al livello 4 e la ricerca giusta all'Università, la colonia forgia l'&6Armatura a piastre&r."
		"La indossano le guardie; un pezzo potete ordinarlo anche per voi dalla scorta minima del Magazzino."
	]
	quest.79158481C23D54C5.title: "Le tasse crescono"
	quest.79158481C23D54C5.quest_subtitle: "Smeraldi ogni 20 minuti"
	quest.79158481C23D54C5.quest_desc: [
		"Le tasse dipendono da edifici, felicità e torri di guardia. Ritiratele con &6/wnt claimtax&r."
		"&cLe guardie costano mantenimento: se il tesoro va in debito, la felicità crolla.&r"
	]
	quest.1AFA3D5A74F76D72.title: "Lo Scambio"
	quest.1AFA3D5A74F76D72.quest_subtitle: "Ricchezze in ColonyBucks"
	quest.1AFA3D5A74F76D72.quest_desc: [
		"Nel Municipio, scheda &6Exchange&r (o /colonyautopilot exchange): diamanti, oro, detriti antichi e netherite diventano ColonyBucks."
		"Solo in un verso: i ColonyBucks non tornano indietro."
	]
	task.385694F1591A1DED.title: "Ho usato lo Scambio del Municipio"
	quest.749CF57E603E3843.title: "Un tesoro pieno"
	quest.749CF57E603E3843.quest_subtitle: "Ricerche e costruzioni non aspettano"
	quest.749CF57E603E3843.quest_desc: [
		"Ricerche, consegne e migliorie si pagano in ColonyBucks: con il tesoro vuoto la colonia si ferma."
		"Mettete da parte una bella somma, poi versatela nel Municipio (Shift + clic destro)."
	]
	quest.2158A1B6561BD8A3.title: "Il Tavolo di Cancelleria"
	quest.2158A1B6561BD8A3.quest_subtitle: "I titoli del regno"
	quest.2158A1B6561BD8A3.quest_desc: [
		"Il &6Tavolo di Cancelleria&r mostra il tuo titolo, la scala dei ranghi e i sigilli."
		"Ogni giocatore ha il suo titolo: Popolano, Artigiano, Cavaliere, Barone, poi Conte e Duca."
		"&7Il comando /renounce è disattivato: siete tutti nella stessa colonia.&r"
	]
	quest.3F18385DA65CC3DF.title: "Artigiano"
	quest.3F18385DA65CC3DF.quest_subtitle: "Il primo titolo"
	quest.3F18385DA65CC3DF.quest_desc: [
		"Chi ha portato la squadra nell'Era del Vapore merita il titolo di &6Artigiano&r."
		"Il titolo lo conferisce un operatore con &6/nobility promote&r."
	]
	task.2583F42E79CE343F.title: "Sono Artigiano (o Artigiana)"
	quest.3AE92CB0A2A9B91D.title: "Cavaliere"
	quest.3AE92CB0A2A9B91D.quest_subtitle: "Un boss, un'investitura"
	quest.3AE92CB0A2A9B91D.quest_desc: [
		"Dopo aver abbattuto &cIgnis&r la squadra viene investita: &6Cavaliere&r o Dama."
		"Il titolo lo conferisce un operatore con &6/nobility promote&r."
	]
	task.4E4EAFD8B92BB49E.title: "Sono Cavaliere (o Dama)"
	quest.10B983B156CB6042.title: "Barone"
	quest.10B983B156CB6042.quest_subtitle: "Signori dell'elettricità"
	quest.10B983B156CB6042.quest_desc: [
		"Con l'Altoforno Elettrico la squadra entra nell'Era 3: il titolo è &6Barone&r o Baronessa."
		"Il titolo lo conferisce un operatore con &6/nobility promote&r."
	]
	task.59E35B990151A0F4.title: "Sono Barone (o Baronessa)"
	quest.161A4575268EFC30.title: "Conte"
	quest.161A4575268EFC30.quest_subtitle: "Due sigilli tra compagni"
	quest.161A4575268EFC30.quest_desc: [
		"Per diventare &6Conte&r servono i sigilli di due Baroni, dati dal Tavolo di Cancelleria."
		"Chi dà il sigillo diventa vassallo per qualche giorno: è solo un titolo, la colonia resta di tutti."
		"&7Serve una squadra di almeno tre giocatori.&r"
	]
	task.5020EA9B4E126895.title: "Due Baroni mi hanno dato il sigillo e sono Conte"
	quest.6664756E9978D418.title: "Sigilli in serie"
	quest.6664756E9978D418.quest_subtitle: "Una caldaia, un sigillo"
	quest.6664756E9978D418.quest_desc: [
		"Ogni Caldaia di Bronzo chiede un Sigillo della Gilda."
		"Alzate la scorta minima del Sigillo nel Magazzino: il Fabbro ne terrà sempre qualcuno pronto."
	]
	quest.1EBFF7DD0CF24215.title: "Telai in serie"
	quest.1EBFF7DD0CF24215.quest_subtitle: "Il Falegname non si ferma"
	quest.1EBFF7DD0CF24215.quest_desc: [
		"Ogni Involucro Avanzato chiede un Telaio del Falegname."
		"Scorta minima nel Magazzino, acciaio negli scaffali: la produzione va da sola."
	]
	quest.5494D80D202FA7D6.title: "Pannelli in serie"
	quest.5494D80D202FA7D6.quest_subtitle: "Il Tagliapietre a pieno ritmo"
	quest.5494D80D202FA7D6.quest_desc: [
		"I Pannelli Termoisolanti servono per l'Involucro Termoisolante e per la Taglierina ME."
		"Polvere di quarzo, mattoni refrattari e magma nel Magazzino: il Tagliapietre fa il resto."
	]
	quest.27E415E81572011C.title: "Il Minatore del Nether"
	quest.27E415E81572011C.quest_subtitle: "Un colono oltre il portale"
	quest.27E415E81572011C.quest_desc: [
		"Il &6Minatore del Nether&r parte in spedizione e torna con materiali del Nether."
		"Equipaggiatelo bene: le spedizioni sono pericolose anche per lui."
	]
	task.31196603AB34AABB.title: "Il Minatore del Nether è tornato dalla prima spedizione"
	quest.7B27577041EC8EBA.title: "Coloni in rete"
	quest.7B27577041EC8EBA.quest_subtitle: "Il Magazzino parla con la rete ME"
	quest.7B27577041EC8EBA.quest_desc: [
		"Con il Terminale della Colonia i coloni prendono dalla rete ME quello che chiedono."
		"Controllate che una richiesta venga soddisfatta senza passare dalle casse."
	]
	task.1BA3F5CBD9822B03.title: "Una richiesta di un colono è arrivata dalla rete ME"
	chapter.5B3F1150125E2295.title: "Industria"
	chapter.5B3F1150125E2295.chapter_subtitle: [
		"Modern Industrialization oltre la linea principale"
	]
	quest.3124E26ABC1917FB.title: "Caldaia solare"
	quest.3124E26ABC1917FB.quest_subtitle: "Vapore gratis di giorno"
	quest.3124E26ABC1917FB.quest_desc: [
		"Vetro, piastre d'argento e mattoni refrattari attorno a una &6Caldaia di Bronzo&r."
		"Non brucia nulla: le basta il sole. Mettetene una fila sul tetto dell'officina."
	]
	quest.6D92455970625739.title: "Trivella a vapore"
	quest.6D92455970625739.quest_subtitle: "Scavare senza fatica"
	quest.6D92455970625739.quest_desc: [
		"Una trivella che va ad acqua e combustibile, non a energia."
		"Riempila con un secchio d'acqua e del carbone. Utile a chi fa il minatore della squadra."
	]
	quest.15C35E9673580768.title: "Grande Caldaia a Vapore"
	quest.15C35E9673580768.quest_subtitle: "Il primo multiblocco di energia"
	quest.15C35E9673580768.quest_desc: [
		"Caldaia di Bronzo al centro, piastre curve e mattoni placcati di bronzo, circuiti analogici."
		"La struttura completa è nel &6Manuale&r di Modern Industrialization."
		"Fa molto più vapore della caldaia singola: alimenta tutte le turbine LV."
	]
	quest.43EC0834BD0EBA7B.title: "Accumulatori"
	quest.43EC0834BD0EBA7B.quest_subtitle: "L'energia di notte"
	quest.43EC0834BD0EBA7B.quest_desc: [
		"Un'unità di accumulo LV conserva l'energia quando le macchine sono ferme."
		"Le batterie di redstone si fanno nell'assemblatore o al banco: guarda JEI."
	]
	quest.4467245A965AD7AD.title: "Pannelli solari"
	quest.4467245A965AD7AD.quest_subtitle: "Energia pulita"
	quest.4467245A965AD7AD.quest_desc: [
		"Extended Industrialization aggiunge i pannelli solari LV."
		"Producono poco ma non chiedono niente: buoni per le macchine lontane dalla base."
	]
	quest.19B2948191B2E642.title: "Turbina MV"
	quest.19B2948191B2E642.quest_subtitle: "Media tensione"
	quest.19B2948191B2E642.quest_desc: [
		"Scafo avanzato, rotore d'alluminio, cavi di elettro e un circuito elettronico."
		"Con la turbina MV e un trasformatore LV→MV la fabbrica sale di livello."
	]
	quest.7B047490EE5C8825.title: "Oro nero"
	quest.7B047490EE5C8825.quest_subtitle: "La trivella petrolifera"
	quest.7B047490EE5C8825.quest_desc: [
		"Il &6Trivellatore petrolifero&r è un multiblocco: va messo sopra un giacimento."
		"Consuma lentamente punte di trivella d'alluminio. Il petrolio è la base di plastica e carburanti."
	]
	quest.4E7DCF2B5795FB72.title: "Distilleria"
	quest.4E7DCF2B5795FB72.quest_subtitle: "Una frazione alla volta"
	quest.4E7DCF2B5795FB72.quest_desc: [
		"La distilleria separa il greggio, ma un prodotto per volta: scegli la ricetta."
		"Benzina leggera, pesante e nafta escono ancora solforose: vanno purificate."
	]
	quest.285EE6DAC901EBF0.title: "Reattore chimico"
	quest.285EE6DAC901EBF0.quest_subtitle: "Il cuore della chimica"
	quest.285EE6DAC901EBF0.quest_desc: [
		"Rotore d'alluminio, pompa grande, circuito elettronico."
		"Quasi tutta la petrolchimica e i biocombustibili passano da qui."
	]
	quest.5B84B6EBC4B0DEB4.title: "Plastica"
	quest.5B84B6EBC4B0DEB4.quest_subtitle: "Polietilene"
	quest.5B84B6EBC4B0DEB4.quest_desc: [
		"L'etilene nel reattore chimico, con polvere minuta di cromo o di piombo, diventa &6polietilene&r."
		"L'etilene arriva dal petrolio distillato o dall'etanolo."
	]
	quest.4E429CAD31E5F53A.title: "Circuito Digitale"
	quest.4E429CAD31E5F53A.quest_subtitle: "Il terzo livello di circuiti"
	quest.4E429CAD31E5F53A.quest_desc: [
		"La scheda del circuito digitale si fa con il polietilene."
		"Servono anche le porte logiche AND, OR e NOT: tutto nell'assemblatore."
	]
	quest.6B35117774E42D71.title: "Torre di distillazione"
	quest.6B35117774E42D71.quest_subtitle: "Tutte le frazioni insieme"
	quest.6B35117774E42D71.quest_desc: [
		"Il multiblocco che separa il greggio in tutte le frazioni in un colpo solo."
		"Scafo turbo, pompe avanzate, circuiti digitali e due distillerie."
	]
	quest.257FA4EF2ED101F4.title: "Etanolo dalla taverna"
	quest.257FA4EF2ED101F4.quest_subtitle: "Birra per le macchine"
	quest.257FA4EF2ED101F4.quest_desc: [
		"Una bevanda fermentata di Brewin' and Chewin' nella &6Centrifuga&r dà 250 mB di etanolo e restituisce il boccale."
		"Chi cucina per la colonia può riempire anche i serbatoi. Il riso nel miscelatore dà invece soluzione zuccherina."
	]
	quest.39FF3DB96422E5D5.title: "Biodiesel"
	quest.39FF3DB96422E5D5.quest_subtitle: "Carburante dai campi"
	quest.39FF3DB96422E5D5.quest_desc: [
		"Olio vegetale, etanolo e idrossido di sodio nel reattore chimico danno biodiesel grezzo; con il vapore diventa &6biodiesel&r."
		"Bruciatelo in un generatore diesel."
	]
	quest.527527184F8890B6.title: "Congelatore sottovuoto"
	quest.527527184F8890B6.quest_subtitle: "Raffreddare i lingotti caldi"
	quest.527527184F8890B6.quest_desc: [
		"I metalli più duri escono dall'altoforno come &clingotti caldi&r."
		"Il congelatore sottovuoto è un multiblocco che li raffredda."
	]
	quest.12BB18B17A848199.title: "Bobine di Kanthal"
	quest.12BB18B17A848199.quest_subtitle: "Più calore all'altoforno"
	quest.12BB18B17A848199.quest_desc: [
		"Lingotto caldo di kanthal, poi congelatore, poi cavi e bobine."
		"Sostituisci le bobine di cupronichel: l'altoforno raggiunge temperature più alte."
	]
	quest.20694146CF43B35E.title: "Acciaio inossidabile"
	quest.20694146CF43B35E.quest_subtitle: "Il metallo dell'HV"
	quest.20694146CF43B35E.quest_desc: [
		"Con le bobine di kanthal l'altoforno fonde l'acciaio inossidabile."
		"Esce caldo: anche questo passa dal congelatore."
	]
	quest.45479BA422C31B6C.title: "Alta tensione"
	quest.45479BA422C31B6C.quest_subtitle: "Il livello HV"
	quest.45479BA422C31B6C.quest_desc: [
		"Scafo turbo e unità di accumulo HV con le batterie al sodio."
		"Da qui la fabbrica regge le macchine più affamate."
	]
	quest.18F020038FD97379.title: "Unità di elaborazione"
	quest.18F020038FD97379.quest_subtitle: "Il quarto livello di circuiti"
	quest.18F020038FD97379.quest_desc: [
		"Circuito digitale, ALU, RAM e unità di gestione della memoria."
		"Serve per i multiblocchi grandi e per il nucleare."
	]
	quest.116159B80B7D9B04.title: "Grande turbina a vapore"
	quest.116159B80B7D9B04.quest_subtitle: "Tutto il vapore che vuoi"
	quest.116159B80B7D9B04.quest_desc: [
		"Il multiblocco di turbine più grande: si costruisce su una turbina HV."
		"Abbinatelo alla grande caldaia avanzata per un'intera centrale."
	]
	quest.5AB576933DF053B3.title: "Fabbrica in rete"
	quest.5AB576933DF053B3.quest_subtitle: "AE2 parla con MI"
	quest.5AB576933DF053B3.quest_desc: [
		"Industrialization Overdrive aggiunge portelli ME per i multiblocchi."
		"Il portello d'ingresso ME prende gli ingredienti direttamente dalla rete."
	]
	quest.3966501D650ABD0B.title: "Uranio"
	quest.3966501D650ABD0B.quest_subtitle: "Maneggiare con cura"
	quest.3966501D650ABD0B.quest_desc: [
		"L'uranio si trova in profondità."
		"Va separato in isotopi e chiuso in barre di combustibile."
	]
	quest.2A62635A9FF01274.title: "Reattore nucleare"
	quest.2A62635A9FF01274.quest_subtitle: "Calore senza fine"
	quest.2A62635A9FF01274.quest_desc: [
		"Lega nucleare, scafo altamente avanzato, unità di elaborazione e barre di controllo al cadmio."
		"Le barre esaurite si riprocessano: da lì viene il &6plutonio&r."
	]
	quest.7B26ED5EB881A2DB.title: "Superconduttori"
	quest.7B26ED5EB881A2DB.quest_subtitle: "Zero perdite"
	quest.7B26ED5EB881A2DB.quest_desc: [
		"Rame ricotto, iridio, neodimio e ittrio nel miscelatore danno la polvere superconduttrice."
		"Altoforno, congelatore, poi cavi e bobine superconduttrici."
	]
	quest.7223521DDFEA82B7.title: "Livello EV"
	quest.7223521DDFEA82B7.quest_subtitle: "Tensione estrema"
	quest.7223521DDFEA82B7.quest_desc: [
		"Unità di accumulo EV con batterie al cadmio e scafo altamente avanzato."
		"Con i trasformatori superconduttori la rete elettrica non ha più limiti pratici."
	]
	quest.4F43F9366B41A78F.title: "Circuito quantico"
	quest.4F43F9366B41A78F.quest_subtitle: "L'ultimo circuito"
	quest.4F43F9366B41A78F.quest_desc: [
		"Unità di elaborazione, scheda quantica, qubit e celle di raffreddamento."
		"È il circuito dei macchinari di fine gioco."
	]
	quest.5D1563F3B1D51A7E.title: "Scafo quantico"
	quest.5D1563F3B1D51A7E.quest_subtitle: "La base del fine gioco"
	quest.5D1563F3B1D51A7E.quest_desc: [
		"Involucro quantico, cavi superconduttori, circuito quantico e una batteria al plutonio."
	]
	quest.304831374F5F6E5D.title: "Reattore a fusione"
	quest.304831374F5F6E5D.quest_subtitle: "Una stella in officina"
	quest.304831374F5F6E5D.quest_desc: [
		"Camera di fusione, scafo quantico e circuito quantico."
		"Deuterio e trizio diventano plasma di elio."
	]
	quest.392EB87067084128.title: "Turbina al plasma"
	quest.392EB87067084128.quest_subtitle: "Energia dalle stelle"
	quest.392EB87067084128.quest_desc: [
		"Bobine superconduttrici, rotori di titanio e scafo quantico."
		"Il plasma del reattore a fusione la fa girare."
	]
	quest.20934EFEFCEB33DE.title: "Armatura quantica"
	quest.20934EFEFCEB33DE.quest_subtitle: "Il premio dell'ingegnere"
	quest.20934EFEFCEB33DE.quest_desc: [
		"Un potenziamento quantico su un pezzo di armatura di netherite, nell'impacchettatrice."
		"Basta un pezzo per cominciare: chi la indossa protegge la squadra in prima linea."
	]
	chapter.1D5D892F8C7E856F.title: "Rete Digitale"
	chapter.1D5D892F8C7E856F.chapter_subtitle: [
		"AE2 oltre le basi: canali, memoria, autocrafting e MEGA"
	]
	quest.4532D264481C1E1D.title: "Cavi intelligenti"
	quest.4532D264481C1E1D.quest_subtitle: "Vedere i canali"
	quest.4532D264481C1E1D.quest_desc: [
		"Un cavo normale porta &e8 canali&r: ogni bus, terminale o interfaccia ne usa uno."
		"I cavi intelligenti si illuminano e mostrano quanti ne state usando."
		"La chiave di rete vi dice dove la rete si strozza."
	]
	quest.7C39ECD65126EDE9.title: "Cavi densi"
	quest.7C39ECD65126EDE9.quest_subtitle: "32 canali in un tubo"
	quest.7C39ECD65126EDE9.quest_desc: [
		"Un cavo denso porta &e32 canali&r. Usatelo per la dorsale della base,"
		"i cavi normali solo per le ultime diramazioni."
	]
	quest.16C4716F37B94BE7.title: "Tunnel P2P"
	quest.16C4716F37B94BE7.quest_subtitle: "Canali a distanza"
	quest.16C4716F37B94BE7.quest_desc: [
		"Un tunnel P2P ME porta fino a 32 canali su un solo canale della rete."
		"Si collegano copiando le impostazioni con la scheda di memoria."
		"Con un'altra scheda si trasportano anche oggetti, fluidi e redstone."
	]
	quest.648570B7AAA1D62B.title: "Sottoreti"
	quest.648570B7AAA1D62B.quest_subtitle: "Reti dentro la rete"
	quest.648570B7AAA1D62B.quest_desc: [
		"Una sottorete è una piccola rete separata, collegata alla principale"
		"con un'&einterfaccia&r e un &ebus di stoccaggio&r."
		"Serve per isolare una fabbrica senza consumare i canali della rete grande."
	]
	task.100AFB95B9C42E0C.title: "Una sottorete funziona accanto alla rete principale"
	quest.3D69187F7B38A524.title: "Connettore senza fili"
	quest.3D69187F7B38A524.quest_subtitle: "ExtendedAE"
	quest.3D69187F7B38A524.quest_desc: [
		"Il connettore senza fili di ExtendedAE unisce due punti della rete senza cavi."
		"Si assembla nell'assemblatore di cristalli e si accoppia con il suo attrezzo."
	]
	quest.2B8DB4AD50D4C153.title: "Collegamento quantico"
	quest.2B8DB4AD50D4C153.quest_subtitle: "La rete ovunque"
	quest.2B8DB4AD50D4C153.quest_desc: [
		"Due anelli quantici con una coppia di singolarità entangled uniscono"
		"due reti in qualunque punto del mondo, anche in dimensioni diverse."
		"Entrambi i lati devono restare caricati."
	]
	quest.1D95FF983B60E454.title: "Terminale universale"
	quest.1D95FF983B60E454.quest_subtitle: "Un terminale per tutto"
	quest.1D95FF983B60E454.quest_desc: [
		"Il terminale universale senza fili riunisce crafting, modelli e accesso ai modelli."
		"Con la scheda ponte quantico funziona da qualsiasi distanza e dimensione."
	]
	quest.474000BDCDBE4BF1.title: "Celle di fluidi"
	quest.474000BDCDBE4BF1.quest_subtitle: "Anche i liquidi in rete"
	quest.474000BDCDBE4BF1.quest_desc: [
		"Le celle di fluidi tengono vapore, oli e carburanti di Modern Industrialization."
		"Il serbatoio di pietra celeste è comodo per riempire secchi a mano."
	]
	quest.1943A67336C2BE73.title: "Celle grandi"
	quest.1943A67336C2BE73.quest_subtitle: "Più spazio per tutti"
	quest.1943A67336C2BE73.quest_desc: [
		"Una cella da 64k tiene molto più di quattro celle piccole."
		"Il banco delle celle le partiziona: una cella per i minerali, una per i cibi della colonia..."
	]
	quest.1D251EC103DA4997.title: "Cella da 256k"
	quest.1D251EC103DA4997.quest_subtitle: "Il massimo di AE2"
	quest.1D251EC103DA4997.quest_desc: [
		"La cella più grande di AE2 base. Il suo componente servirà anche per le MEGA Cells."
	]
	quest.56103D7D2C8D98D4.title: "Il condensatore"
	quest.56103D7D2C8D98D4.quest_subtitle: "Dalla spazzatura alla singolarità"
	quest.56103D7D2C8D98D4.quest_desc: [
		"Il condensatore distrugge tutto quello che riceve e accumula energia."
		"Con una cella grande inserita produce le &esingolarità&r."
		"Una singolarità esplosa con polvere di ender dà la coppia entangled."
	]
	quest.700422CBCDD46990.title: "Terminale dei modelli"
	quest.700422CBCDD46990.quest_subtitle: "Scrivere le ricette"
	quest.700422CBCDD46990.quest_desc: [
		"Il terminale di codifica scrive i modelli, quello di accesso li gestisce tutti"
		"da un'unica schermata. Il terminale di crafting vi serve per ExtendedAE."
	]
	quest.23C93CFE7EE50DB0.title: "Co-processori"
	quest.23C93CFE7EE50DB0.quest_subtitle: "CPU più grandi e più veloci"
	quest.23C93CFE7EE50DB0.quest_desc: [
		"Gli acceleratori fanno lavorare la CPU di crafting su più passaggi insieme."
		"Il monitor mostra cosa sta facendo. Più memoria = ordini più grandi."
	]
	quest.16FA931E3E9B2C86.title: "Memorie di crafting"
	quest.16FA931E3E9B2C86.quest_subtitle: "Ordini enormi"
	quest.16FA931E3E9B2C86.quest_desc: [
		"Con 64k e 256k di memoria la rete può pianificare interi lotti di macchine"
		"o i materiali di un edificio della colonia in un solo ordine."
	]
	quest.34D83BA48FE8ED71.title: "Scorte automatiche"
	quest.34D83BA48FE8ED71.quest_subtitle: "La rete si rifornisce da sola"
	quest.34D83BA48FE8ED71.quest_desc: [
		"Un emettitore di livello con una scheda di crafting su un bus di esportazione"
		"fabbrica qualcosa solo quando scende sotto una soglia."
		"Le schede velocità e capacità migliorano bus e interfacce."
	]
	quest.35E2381EEA57D5E6.title: "Assemblatore di cristalli"
	quest.35E2381EEA57D5E6.quest_subtitle: "ExtendedAE"
	quest.35E2381EEA57D5E6.quest_desc: [
		"La macchina di ExtendedAE che fabbrica i suoi pezzi migliori."
		"Il processore concorrente nasce da una pressa nuova nell'incisore."
	]
	quest.13288E54A971D264.title: "Fornitore esteso"
	quest.13288E54A971D264.quest_subtitle: "Più modelli, meno blocchi"
	quest.13288E54A971D264.quest_desc: [
		"Il fornitore di modelli esteso tiene molti più modelli di quello base."
		"Perfetto davanti alle macchine di Modern Industrialization."
	]
	quest.737F1912A2C97665.title: "Matrice assemblatrice"
	quest.737F1912A2C97665.quest_subtitle: "Una fabbrica di crafting"
	quest.737F1912A2C97665.quest_desc: [
		"La matrice è una struttura di ExtendedAE che sostituisce decine di assemblatori"
		"molecolari. Telaio, pareti e vetro chiudono la struttura,"
		"dentro vanno moduli per modelli, crafting e velocità."
	]
	task.580A231A09ACE463.title: "La matrice è formata e lavora"
	quest.2DC606F0BDE1653C.title: "Acciaio celeste"
	quest.2DC606F0BDE1653C.quest_subtitle: "Il metallo di MEGA Cells"
	quest.2DC606F0BDE1653C.quest_desc: [
		"L'acciaio celeste è la base di tutte le MEGA Cells."
		"Si ottiene con una trasformazione nel mondo: guardate la ricetta in JEI."
	]
	quest.27849D93B8A36DDE.title: "Processore di accumulo"
	quest.27849D93B8A36DDE.quest_subtitle: "Una nuova pressa"
	quest.27849D93B8A36DDE.quest_desc: [
		"La pressa di accumulo si fabbrica nell'incisore e stampa il processore"
		"che serve a celle, CPU e interfacce MEGA."
	]
	quest.33DBE6850358F816.title: "Cella da 1M"
	quest.33DBE6850358F816.quest_subtitle: "Un milione di byte"
	quest.33DBE6850358F816.quest_desc: [
		"Il primo gradino di MEGA Cells: quattro volte una 256k."
		"Poi vengono 4M, 16M, 64M e 256M: non c'è fretta."
	]
	quest.689D6A756F568996.title: "CPU MEGA"
	quest.689D6A756F568996.quest_subtitle: "Crafting su larga scala"
	quest.689D6A756F568996.quest_desc: [
		"Le unità MEGA costruiscono CPU di crafting più compatte e potenti."
		"Una memoria da 1M basta per quasi tutto."
	]
	quest.410636AE8DA78965.title: "Cella massiva"
	quest.410636AE8DA78965.quest_subtitle: "Un solo oggetto, quantità infinita"
	quest.410636AE8DA78965.quest_desc: [
		"La cella massiva tiene un solo tipo di oggetto, ma senza limite."
		"Con la scheda di compressione converte da sola lingotti, pepite e blocchi."
		"Ideale per il ciottolo o il minerale principale della colonia."
	]
	quest.6226EFC4572B2C84.title: "Piloni spaziali"
	quest.6226EFC4572B2C84.quest_subtitle: "Impacchettare lo spazio"
	quest.6226EFC4572B2C84.quest_desc: [
		"La porta I/O spaziale, circondata da piloni, salva un intero volume del mondo"
		"dentro una cella spaziale. Blocchi, macchine e contenuto compresi."
	]
	quest.799B9115F28E48EE.title: "Il trasloco"
	quest.799B9115F28E48EE.quest_subtitle: "Una stanza in tasca"
	quest.799B9115F28E48EE.quest_desc: [
		"Con una cella da 16 si sposta una stanza intera: utile per spostare"
		"una fabbrica senza smontarla. &cProvate prima con qualcosa di poco valore.&r"
	]
	task.21918C14FF7F6D0E.title: "Abbiamo spostato una stanza con la porta I/O spaziale"
	quest.68885298D85E71F5.title: "Processori in serie"
	quest.68885298D85E71F5.quest_subtitle: "MI lavora per AE2"
	quest.68885298D85E71F5.quest_desc: [
		"L'assemblatore di Modern Industrialization stampa i processori AE2 senza presse."
		"L'elettrolizzatore carica il certus, il miscelatore fa il fluix."
		"Mettete un fornitore di modelli davanti e la rete li ordina da sola."
	]
	quest.6BD4EA77E58D6DB2.title: "Fili ME e tunnel di energia"
	quest.6BD4EA77E58D6DB2.quest_subtitle: "Una rete, due mod"
	quest.6BD4EA77E58D6DB2.quest_desc: [
		"Il filo ME di Modern Industrialization porta insieme energia EU e canali ME."
		"Il tunnel P2P di energia sposta EU attraverso la rete AE2."
	]
	quest.3A840798F23D9B43.title: "La colonia in rete"
	quest.3A840798F23D9B43.quest_subtitle: "AE2Colonies al lavoro"
	quest.3A840798F23D9B43.quest_desc: [
		"Con il Terminale della Colonia le richieste dei coloni arrivano alla rete."
		"Mettete in rete ciò che chiedono più spesso: cibo, legna, pietra, attrezzi."
	]
	task.12BBD2C028C2BF7C.title: "Un Costruttore ha ricevuto i materiali dalla rete ME"
	quest.4F2373AB5E377A3E.title: "Il Richiedente ME"
	quest.4F2373AB5E377A3E.quest_subtitle: "Scorte sempre piene"
	quest.4F2373AB5E377A3E.quest_desc: [
		"Il Richiedente ordina alla rete di tenere sempre una quantità fissa di un oggetto."
		"Il terminale dei richiedenti li controlla tutti da un posto solo."
	]
	quest.5546640CE590DF15.title: "Scorte della colonia"
	quest.5546640CE590DF15.quest_subtitle: "Nessun colono resta a mani vuote"
	quest.5546640CE590DF15.quest_desc: [
		"Decidete insieme cosa la rete deve tenere sempre pronto per la colonia"
		"e affidatelo ai richiedenti. Chi gestisce la rete tiene d'occhio le CPU."
	]
	task.5A8A2C7B65F7D3F1.title: "La rete tiene in scorta almeno 5 materiali per la colonia"
	quest.5796AFA9C4B61CE6.title: "&6&lLa rete completa&r"
	quest.5796AFA9C4B61CE6.quest_subtitle: "Il cervello della colonia"
	quest.5796AFA9C4B61CE6.quest_desc: [
		"Canali, memoria enorme, crafting automatico e una colonia che si rifornisce da sola."
		"Ora la rete lavora per tutta la squadra."
	]
	task.1B9301560F7E788A.title: "La rete serve tutta la base e tutta la colonia"
	chapter.16B5C62F2C8E25CA.title: "Lo Spazio"
	chapter.16B5C62F2C8E25CA.chapter_subtitle: [
		"Basi, lune minori e la porta di Eris"
	]
	quest.5EAF59D38C54B4FB.title: "Il Rover"
	quest.5EAF59D38C54B4FB.quest_subtitle: "Quattro ruote sulla regolite"
	quest.5EAF59D38C54B4FB.quest_desc: [
		"&7&oA piedi la Luna è grande. In rover un po' meno.&r"
		"Il &6Rover&r si crafta con motore e blocchi di desh, piastre di desh, una bombola grande, una radio e quattro ruote."
		"Va a carburante, come i razzi. &aPorta due persone: uno guida, l'altro scava.&r"
	]
	quest.1C9A52AD92B8BA23.title: "Pannelli solari"
	quest.1C9A52AD92B8BA23.quest_subtitle: "Lassù il sole non tramonta mai del tutto"
	quest.1C9A52AD92B8BA23.quest_desc: [
		"&7&oNiente nuvole, niente atmosfera: solo luce.&r"
		"La &6Cella Fotovoltaica&r (vetro blu, piastre di desh, diamante) va nel &6Pannello Solare&r."
		"Più vicini al sole, più energia: su Mercurio rendono il massimo."
	]
	quest.34F70881DF6674F6.title: "Gravità su misura"
	quest.34F70881DF6674F6.quest_subtitle: "Piedi per terra, anche sulla Luna"
	quest.34F70881DF6674F6.quest_desc: [
		"&7&oSaltare tre metri è divertente. Per dieci minuti.&r"
		"Il &6Normalizzatore di Gravità&r riporta la gravità terrestre nella stanza sigillata. Servono due &6Condensatori Etrionici&r e un blocco di diamante."
		"Va alimentato, come il distributore d'ossigeno."
	]
	quest.1868C136A2D30F4E.title: "Camera stagna"
	quest.1868C136A2D30F4E.quest_subtitle: "Entrare senza perdere l'aria"
	quest.1868C136A2D30F4E.quest_desc: [
		"&7&oUna porta aperta e l'ossigeno della base se ne va.&r"
		"La &6Camera Stagna&r chiude l'ingresso; il &6Sensore d'Ossigeno&r manda un segnale redstone quando la stanza è piena d'aria."
		"&aCollegateli: la porta si apre solo se dentro si respira.&r"
	]
	quest.2C6977EEE5163683.title: "Stazione orbitale"
	quest.2C6977EEE5163683.quest_subtitle: "Una casa sopra le nuvole"
	quest.2C6977EEE5163683.quest_desc: [
		"&7&oDa quassù la colonia è un puntino. Il vostro puntino.&r"
		"In &6orbita terrestre&r, dal menu dei pianeti, si costruisce una &6stazione spaziale&r: 64 piastre di ferro, 32 lingotti d'acciaio, 32 lingotti e 32 piastre di desh."
		"&aMettete i materiali in comune: la stazione è di tutti.&r"
	]
	task.415355D9A86D67F7.title: "Raggiungete l'orbita terrestre"
	task.3440782BDBDCACB7.title: "La stazione spaziale è costruita"
	quest.530C4FAA0693494B.title: "Tuta a reazione"
	quest.530C4FAA0693494B.quest_subtitle: "Volare dove non c'è aria"
	quest.530C4FAA0693494B.quest_desc: [
		"&7&oUn motore sulla schiena. Cosa potrebbe andare storto?&r"
		"La &6Tuta a Reazione&r nasce dalla tuta di netherite: piastre e serbatoi di calorite, un motore di calorite e i condensatori etrionici."
		"Si ricarica come un macchinario. &cNon sostituisce la fodera.&r"
	]
	quest.4E11857437E18D13.title: "Orto spaziale"
	quest.4E11857437E18D13.quest_subtitle: "Senza aria non cresce niente"
	quest.4E11857437E18D13.quest_desc: [
		"&7&oUn seme, un po' di terra portata da casa e tanta pazienza.&r"
		"Le piante muoiono senza ossigeno. Dentro una stanza sigillata con il distributore crescono come a casa."
		"&aTerra, acqua e luce: coltivate qualcosa sulla Luna e portate il raccolto alla taverna.&r"
	]
	task.44EFDCCB58D214CF.title: "Un raccolto cresciuto sulla Luna, sotto ossigeno"
	quest.2CBBA6618AB73270.title: "Ombre sulla Luna"
	quest.2CBBA6618AB73270.quest_subtitle: "Non siamo soli"
	quest.2CBBA6618AB73270.quest_desc: [
		"&7&oQualcosa cammina nella polvere grigia. E qualcosa striscia.&r"
		"Nelle lande lunari girano &cLunariani Corrotti&r e &cStriscianti Stellari&r. Uscite in gruppo."
	]
	quest.25F140B1E6EE827E.title: "Rapaci di Marte"
	quest.25F140B1E6EE827E.quest_subtitle: "Denti nella polvere rossa"
	quest.25F140B1E6EE827E.quest_desc: [
		"&7&oVeloci, affamati, sempre in branco.&r"
		"I &cRapaci Marziani&r cacciano nei canyon e nelle lande di Marte. Chi tiene la linea, chi colpisce da lontano."
	]
	quest.2BE96660FA234EAE.title: "L'inferno di Venere"
	quest.2BE96660FA234EAE.quest_subtitle: "Zolfo, zanne e zombi"
	quest.2BE96660FA234EAE.quest_desc: [
		"&7&oSu Venere anche i creeper sono peggio.&r"
		"&cMogler&r, &cCreeper di Zolfo&r e &cPygro Zombificati&r popolano le lande di Venere. Restate uniti."
	]
	quest.2080B75E896B833F.title: "I Lunariani"
	quest.2080B75E896B833F.quest_subtitle: "Vicini di casa"
	quest.2080B75E896B833F.quest_desc: [
		"&7&oCommerciano come i nostri, ma guardano la Terra dal basso.&r"
		"Sulla Luna ci sono &6villaggi lunariani&r. Trovatene uno e fate almeno uno scambio."
		"&7Trattateli bene: sono gli unici amici quassù.&r"
	]
	task.1B16253862172A62.title: "Villaggio trovato, uno scambio fatto"
	quest.220AE9AA25A22D08.title: "La Fascia degli Asteroidi"
	quest.220AE9AA25A22D08.quest_subtitle: "Sassi che galleggiano"
	quest.220AE9AA25A22D08.quest_desc: [
		"&7&oTra Marte e Giove, un campo di rocce sospese.&r"
		"Con il &6Razzo Tier 2&r si arriva anche alla &6Fascia degli Asteroidi&r. Gravità bassa, freddo forte: fodera addosso."
	]
	task.27327DAF37A2127B.title: "Atterrate sulla Fascia degli Asteroidi"
	quest.7DC5A966D06349C1.title: "Glacio"
	quest.7DC5A966D06349C1.quest_subtitle: "Un'altra stella"
	quest.7DC5A966D06349C1.quest_desc: [
		"&7&oProxima Centauri. Qui si respira, ma si gela.&r"
		"Il &6Razzo Tier 4&r porta fuori dal sistema solare, su &6Glacio&r: ha aria propria."
		"Gli &cArieti Glaciali&r pascolano tra le vette ghiacciate. Non sono pecore docili."
	]
	task.21FCCE543D484021.title: "Atterrate su Glacio"
	quest.2456441A347729FA.title: "Geodi e rovine"
	quest.2456441A347729FA.quest_subtitle: "Chi c'era prima di noi?"
	quest.2456441A347729FA.quest_desc: [
		"&7&oPietre squadrate su lune dove nessuno è mai stato.&r"
		"Su Deimos e Phobos crescono &6geodi di cristallo di brace&r. Le &6Rovine Antiche&r custodiscono &6pietra antica&r."
		"&eOgni sistema ha il suo cristallo:&r i frammenti accendono le prese di cristallo che aprono i cancelli degli Antichi. Tenetene sempre qualcuno."
	]
	quest.7F08272B47631946.title: "Le lune di Giove"
	quest.7F08272B47631946.quest_subtitle: "Callisto, Ganimede, Io, Europa"
	quest.7F08272B47631946.quest_desc: [
		"&7&oQuattro lune, quattro mondi diversi.&r"
		"Mettete piede su tutte e quattro. Nelle geodi crescono i &6cristalli d'ambra&r del sistema gioviano."
	]
	task.292D7F53E524EB5E.title: "Atterrate su Callisto"
	task.5DD00B09595515FB.title: "Atterrate su Ganimede"
	task.3BAF16653C3A688B.title: "Atterrate su Io"
	task.1C19AB2143415EB5.title: "Atterrate su Europa"
	quest.5E3EBD442B676EB2.title: "Il Santuario Sommerso"
	quest.5E3EBD442B676EB2.quest_subtitle: "Sotto il ghiaccio di Europa"
	quest.5E3EBD442B676EB2.quest_desc: [
		"&7&oUn tempio annegato in un oceano che non vede il sole.&r"
		"Su &6Europa&r c'è il &6Santuario Sommerso&r. I cancelli si aprono con i frammenti d'ambra nelle prese di cristallo."
		"In fondo custodisce il &6Nucleo di Luce Ambra&r. &aPozioni di respirazione per tutti.&r"
	]
	quest.661F7D2C81056362.title: "Le lune di Saturno"
	quest.661F7D2C81056362.quest_subtitle: "Rea, Giapeto, Encelado"
	quest.661F7D2C81056362.quest_desc: [
		"&7&oGeyser di ghiaccio e polvere scura.&r"
		"Titano l'avete già visto. Mancano &6Rea&r, &6Giapeto&r ed &6Encelado&r, con i suoi geyser."
		"Qui crescono i &6cristalli d'aureola&r."
	]
	task.2F35E932538ED91E.title: "Atterrate su Rea"
	task.3427311BFF9297E4.title: "Atterrate su Giapeto"
	task.3802958058D061D8.title: "Atterrate su Encelado"
	quest.707BEF090CD17402.title: "Le lune di Urano"
	quest.707BEF090CD17402.quest_subtitle: "Miranda, Oberon, Titania"
	quest.707BEF090CD17402.quest_desc: [
		"&7&oScogliere alte chilometri e ghiaccio a strisce.&r"
		"&6Miranda&r, &6Oberon&r e &6Titania&r: tre lune da visitare. Nelle geodi crescono i &6cristalli di marea&r."
	]
	task.6D048CCE98214382.title: "Atterrate su Miranda"
	task.54E5C261B33E80E0.title: "Atterrate su Oberon"
	task.162E4B0032E4300A.title: "Atterrate su Titania"
	quest.7D70F7C685241C29.title: "L'Osservatorio Inclinato"
	quest.7D70F7C685241C29.quest_subtitle: "Un telescopio storto su Miranda"
	quest.7D70F7C685241C29.quest_desc: [
		"&7&oGuardava le stelle. Poi qualcosa l'ha piegato.&r"
		"Su &6Miranda&r c'è l'&6Osservatorio Inclinato&r. Frammenti di marea nelle prese per aprire i cancelli."
		"In fondo custodisce il &6Nucleo di Luce Marea&r."
	]
	quest.14706B84E017F091.title: "La Forgia Abissale"
	quest.14706B84E017F091.quest_subtitle: "Fuoco sotto l'azoto di Tritone"
	quest.14706B84E017F091.quest_desc: [
		"&7&oSfiati d'azoto e una fucina che non si è mai spenta.&r"
		"Su &6Tritone&r c'è la &6Forgia Abissale&r. I &6cristalli di cobalto&r crescono nelle geodi di Nettuno e Tritone."
		"In fondo custodisce il &6Nucleo di Luce Cobalto&r."
	]
	task.47C4915AE4F1229D.title: "Atterrate su Tritone"
	quest.3C8B1E9DEAA2BE29.title: "Caronte"
	quest.3C8B1E9DEAA2BE29.quest_subtitle: "Il traghettatore di Plutone"
	quest.3C8B1E9DEAA2BE29.quest_desc: [
		"&7&oUna luna grande quasi quanto il suo pianeta.&r"
		"Atterrate su &6Caronte&r. Lì e su Plutone crescono i &6cristalli di rosa&r."
	]
	task.750E16FFD9924CE3.title: "Atterrate su Caronte"
	quest.36F7B27C4F384350.title: "Il Cuore Sigillato"
	quest.36F7B27C4F384350.quest_subtitle: "Dentro il ghiaccio di Plutone"
	quest.36F7B27C4F384350.quest_desc: [
		"&7&oUna porta che chiede un tesserino. Qualcuno l'ha perso qui.&r"
		"Su &6Plutone&r c'è il &6Cuore Sigillato&r. Le porte della spedizione si aprono con la &6Tessera d'Accesso&r, trovata negli scrigni: si passa sul lettore e resta a voi."
		"In fondo custodisce il &6Nucleo di Luce Rosa&r."
	]
	quest.229CE5E1462402DF.title: "Disnomia"
	quest.229CE5E1462402DF.quest_subtitle: "La luna dell'ultimo pianeta"
	quest.229CE5E1462402DF.quest_desc: [
		"&7&oPiù in là non c'è niente. Proprio niente.&r"
		"Eris ha una luna: &6Disnomia&r. Qui e su Eris crescono i &6cristalli di gelo&r, gli ultimi del sistema."
	]
	task.6CA3D724BA5CF870.title: "Atterrate su Disnomia"
	quest.711FADC47A53BA14.title: "La soglia di Eris"
	quest.711FADC47A53BA14.quest_subtitle: "Una porta nel ghiaccio"
	quest.711FADC47A53BA14.quest_desc: [
		"&7&oSette prese vuote attorno a un portale chiuso.&r"
		"Su &6Eris&r c'è l'&6Ultima Porta&r. Davanti alla soglia si trova il &6Nucleo di Luce Gelo&r, il settimo."
		"Contate le prese: ognuna aspetta il nucleo di un sistema."
	]
	quest.10957A5A22AB6C23.title: "I sette nuclei"
	quest.10957A5A22AB6C23.quest_subtitle: "Brace, Ambra, Aureola, Marea, Cobalto, Rosa, Gelo"
	quest.10957A5A22AB6C23.quest_desc: [
		"&7&oSette luci, sette sistemi, un'unica porta.&r"
		"Riunite i sette &6Nuclei di Luce&r. Brace e Aureola li avete già: tornano indietro dopo ogni craft dei banchi NASA."
		"&aChi li ha trovati li porta a Eris: serve tutta la squadra.&r"
	]
	quest.7B755FD7F4D550C0.title: "&6&lL'Ultima Porta&r"
	quest.7B755FD7F4D550C0.quest_subtitle: "Oltre la soglia, l'arca"
	quest.7B755FD7F4D550C0.quest_desc: [
		"&7&oLa porta si apre. Dietro, l'arca di chi c'era prima.&r"
		"Mettete i sette nuclei nelle prese della soglia su &6Eris&r: l'&6Ultima Porta&r si apre."
		"Dentro: l'&6Arsenale&r, l'&6Hangar&r e l'&6Origine&r. Esplorateli insieme."
	]
	task.3356C464F62F2A5C.title: "L'Ultima Porta è aperta"
	quest.6AF981B35C8D2261.title: "L'arca degli Antichi"
	quest.6AF981B35C8D2261.quest_subtitle: "L'armatura e la nave"
	quest.6AF981B35C8D2261.quest_desc: [
		"&7&oNon serve aria, non serve carburante. Servivano solo sette luci.&r"
		"Nell'&6Arsenale&r c'è l'&6Armatura degli Antichi&r: indossata intera non servono ossigeno, fodera né protezione dal clima."
		"Nell'&6Hangar&r c'è la &6Nave degli Antichi&r: raggiunge ogni corpo celeste senza carburante e parte da una piazzola normale."
		"&aIl premio di tutto il viaggio. Decidete insieme chi la indossa.&r"
	]
	chapter.5278FBDBE9CC0114.title: "I Boss"
	chapter.5278FBDBE9CC0114.chapter_subtitle: [
		"Mini-boss, trofei e rivincite"
	]
	quest.37A26EBD485F25C6.title: "Caccia grossa"
	quest.37A26EBD485F25C6.quest_subtitle: "Oltre i boss della linea principale"
	quest.37A26EBD485F25C6.quest_desc: [
		"&7&oOgni bestia abbattuta torna più forte. Anche voi, però.&r"
		"Qui trovate i &6mini-boss&r, l'&6equipaggiamento&r che si forgia con i trofei e le &crivincite&r."
		"&cI boss crescono con le ere e a ogni uccisione&r: il contatore è unico per tutto il server."
		"Tutto facoltativo. Ogni quest si apre quando la linea principale ci arriva."
	]
	task.5CA922ABDB4ECAE4.title: "Abbiamo capito: i boss crescono"
	quest.1456A3DCC929E3FB.title: "Sentinelle della Fabbrica"
	quest.1456A3DCC929E3FB.quest_subtitle: "I guardiani di metallo"
	quest.1456A3DCC929E3FB.quest_desc: [
		"&7&oPrima dell'Araldo, i suoi cani da guardia.&r"
		"Nella &6Fabbrica Antica&r si aggirano il &cPredatore&r (The Prowler) e gli &cOsservatori&r. Puliteli prima di svegliare il boss."
	]
	quest.7B348FC3EFAE7F63.title: "Il Colosso di Corallo"
	quest.7B348FC3EFAE7F63.quest_subtitle: "Il fratello maggiore dei golem"
	quest.7B348FC3EFAE7F63.quest_desc: [
		"&7&oUn mucchio di corallo che si alza in piedi.&r"
		"Il &cCoralssus&r è il gigante dei golem di corallo dei mari di Cataclysm. Lascia &6Pezzi di Corallo&r."
	]
	quest.31354832B2F61076.title: "Guardie della Piramide"
	quest.31354832B2F61076.quest_subtitle: "Gladiatori e serpenti"
	quest.31354832B2F61076.quest_desc: [
		"&7&oLa sabbia nasconde più di un sepolcro.&r"
		"Il &cKobolediator&r e il &cWadjet&r difendono il deserto della &6Piramide Maledetta&r. Lasciano &6Metallo Antico&r."
		"Con 4 lingotti si forgia la &6Lancia Antica&r."
	]
	quest.5E810A3F3E4F4B5E.title: "Acciaio Nero"
	quest.5E810A3F3E4F4B5E.quest_subtitle: "Il re dei Draugr"
	quest.5E810A3F3E4F4B5E.quest_desc: [
		"&7&oNel gelo i morti portano ancora la spada.&r"
		"Nella &6Prigione Gelata&r i &6Draugr&r e il loro capo, l'&cAptrgangr&r, lasciano &6Acciaio Nero&r."
		"Vi servirà per le armi e l'armatura di cursium."
	]
	quest.17E30BA19DE91C6D.title: "Il Golem dell'End"
	quest.17E30BA19DE91C6D.quest_subtitle: "Il cuore del vuoto"
	quest.17E30BA19DE91C6D.quest_desc: [
		"&7&oPietra dell'End che cammina.&r"
		"Nella &6Cittadella in Rovina&r gli &cEnder Golem&r custodiscono il &6Nucleo del Vuoto&r, base delle armi del vuoto."
	]
	quest.261CE1B4278319B6.title: "Custodi dell'Acropoli"
	quest.261CE1B4278319B6.quest_subtitle: "La corte di Scilla"
	quest.261CE1B4278319B6.quest_desc: [
		"&7&oGranchi, cavallucci e meduse. Tutti armati.&r"
		"Nell'&6Acropoli&r il &cClawdian&r, l'&cHippocamtus&r e la &cCindaria&r lasciano &6Lacrima&r: serve alle armi della tempesta."
	]
	quest.659D437166F2FA5F.title: "Armatura di Ignitium"
	quest.659D437166F2FA5F.quest_subtitle: "Il fuoco di Ignis addosso"
	quest.659D437166F2FA5F.quest_desc: [
		"&7&oL'Altoforno è acceso: ora l'ignitium avanzato è vostro.&r"
		"Il &6Modello di Potenziamento all'Ignitium&r nasce da un modello di netherite, polvere di blaze e mattoni del Nether."
		"Al tavolo da forgiatura: pezzo di netherite + modello + &6Lingotto di Ignitium&r."
	]
	quest.375A9B45A199F165.title: "Lame ardenti"
	quest.375A9B45A199F165.quest_subtitle: "Spada, scudo e guanti"
	quest.375A9B45A199F165.quest_desc: [
		"&7&oUn tank col baluardo, un guerriero con l'inceneritore.&r"
		"L'&6Inceneritore&r (spada di netherite, ignitium, verghe di blaze), il &6Baluardo della Fiamma&r (scudo) e le &6Prese Ardenti&r."
		"Divideteli tra i ruoli della squadra."
	]
	quest.7818ABAC4C968187.title: "L'Elmo Mostruoso"
	quest.7818ABAC4C968187.quest_subtitle: "Le corna della Mostruosità"
	quest.7818ABAC4C968187.quest_desc: [
		"&7&oIl Controller ME è acceso: le corna avanzate si indossano.&r"
		"Elmo di netherite + modello di netherite + &6Corno Mostruoso&r al tavolo da forgiatura."
		"Tenete la &6Forgia Infernale&r della Mostruosità: servirà alle fusioni."
	]
	quest.4DD3BECEA6C47122.title: "Arsenale di Witherite"
	quest.4DD3BECEA6C47122.quest_subtitle: "L'incudine della fusione"
	quest.4DD3BECEA6C47122.quest_desc: [
		"&7&oL'Araldo lascia un blocco intero di witherite. Il razzo ne ha preso solo un lingotto.&r"
		"L'&6Incudine a Fusione Meccanica&r unisce armi e trofei. Poi la &6Gatling Laser&r e il &6Lanciamissili Wither&r."
	]
	quest.1F8A648E21A03B15.title: "Ali infuocate"
	quest.1F8A648E21A03B15.quest_subtitle: "Corazza ed elitre in una"
	quest.1F8A648E21A03B15.quest_desc: [
		"&7&oPerché scegliere tra armatura e volo?&r"
		"Nell'&6Incudine a Fusione&r: &6Pettorale di Ignitium&r + &6Elitre&r."
	]
	quest.25647CAAA273716C.title: "Armatura di Cursium"
	quest.25647CAAA273716C.quest_subtitle: "Il gelo di Maledictus"
	quest.25647CAAA273716C.quest_desc: [
		"&7&oIl Razzo Tier 4 è partito: il cursium avanzato è vostro.&r"
		"Modello di cursium: modello di netherite, oro e &6Acciaio Nero&r."
		"Al tavolo da forgiatura: pezzo di netherite + modello + &6Lingotto di Cursium&r."
	]
	quest.6B2A2618524F3052.title: "Armi maledette"
	quest.6B2A2618524F3052.quest_subtitle: "Falce, ascia e arco"
	quest.6B2A2618524F3052.quest_desc: [
		"&7&oCursium e acciaio nero, per chi sta in prima linea e per chi tira da lontano.&r"
		"Lo &6Squarcia-anime&r, l'&6Annientatore&r e l'&6Arco Maledetto&r."
	]
	quest.62BDC16DFAA7A2D5.title: "La Forgia del Vuoto"
	quest.62BDC16DFAA7A2D5.quest_subtitle: "Fusioni col Nucleo"
	quest.62BDC16DFAA7A2D5.quest_desc: [
		"&7&oIl martello infernale assorbe il vuoto.&r"
		"Nell'&6Incudine a Fusione&r: &6Forgia Infernale&r + &6Nucleo del Vuoto&r, e &6Lanciamissili Wither&r + Nucleo."
		"Servono due Nuclei: tornate dagli Ender Golem."
	]
	quest.250AE0076BDBF831.title: "Reliquie della distruzione"
	quest.250AE0076BDBF831.quest_subtitle: "I trofei di Bosses of Mass Destruction"
	quest.250AE0076BDBF831.quest_desc: [
		"&7&oCuori, spine e anime: i resti dei quattro boss si possono lavorare.&r"
		"La &6Lancia Tuffaterra&r (cuore di ossidiana, spina del vuoto), il &6Blocco di Levitazione&r (anima antica, occhio ardente) e la &6Perla di Ender Caricata&r."
		"La &6Guardia dai Mostri&r tiene lontani i mob: piazzatela in colonia."
	]
	quest.3C47599C27C82936.title: "I fulmini di Scilla"
	quest.3C47599C27C82936.quest_subtitle: "Le armi della tempesta"
	quest.3C47599C27C82936.quest_desc: [
		"&7&oIl cielo, chiuso in una lancia.&r"
		"&6Essenza della Tempesta&r e &6Lacrima&r: l'&6Astrape&r e il &6Ceraunus&r."
		"Nell'Incudine a Fusione, Forgia Infernale + Astrape danno il &6Brontes&r."
	]
	quest.668DA6976E89E9AE.title: "Rivincita: Ignis"
	quest.668DA6976E89E9AE.quest_subtitle: "Il fabbro torna in forgia"
	quest.668DA6976E89E9AE.quest_desc: [
		"&7&oL'altare del fuoco aspetta altre ceneri.&r"
		"Evocate di nuovo &cIgnis&r e battetelo. &cOgni uccisione lo rende più forte&r, anche per chi verrà dopo."
		"Ignitium in più per l'armeria."
	]
	quest.6E0702C786A7905C.title: "Rivincita: la Mostruosità"
	quest.6E0702C786A7905C.quest_subtitle: "Di nuovo nel Fabbro dell'anima"
	quest.6E0702C786A7905C.quest_desc: [
		"&7&oLa lava si muove ancora.&r"
		"Affrontate di nuovo la &cMostruosità di Netherite&r, ora più resistente."
	]
	quest.50E1A235E394BCBC.title: "Rivincita: Araldo e Wither"
	quest.50E1A235E394BCBC.quest_subtitle: "Due teschi, due battaglie"
	quest.50E1A235E394BCBC.quest_desc: [
		"&7&oLa fabbrica e il Wither non hanno finito con voi.&r"
		"Battete di nuovo l'&cAraldo&r e un altro &cWither&r. Entrambi crescono a ogni uccisione."
	]
	quest.3B70C0EC47F201A9.title: "Rivincita: abisso, sabbia e gelo"
	quest.3B70C0EC47F201A9.quest_subtitle: "Il giro dei tre dungeon"
	quest.3B70C0EC47F201A9.quest_desc: [
		"&7&oTre viaggi, tre boss, tutti più forti di prima.&r"
		"Di nuovo il &cLeviatano&r, il &cResto Antico&r e &cMaledictus&r."
	]
	quest.481A73FFC67F6958.title: "Rivincita: distruzione di massa"
	quest.481A73FFC67F6958.quest_subtitle: "Lich, Guanto, Fiore, Obsidilith"
	quest.481A73FFC67F6958.quest_desc: [
		"&7&oI quattro boss di Bosses of Mass Destruction, ancora una volta.&r"
		"Ognuno ha il suo modo di essere rievocato: leggete i tooltip dei loro oggetti."
	]
	quest.20E28E0A9D657B31.title: "Rivincita: Guardiano e Scilla"
	quest.20E28E0A9D657B31.quest_subtitle: "Gli ultimi due"
	quest.20E28E0A9D657B31.quest_desc: [
		"&7&oDopo Eris, tornate a casa a regolare i conti.&r"
		"Di nuovo il &cGuardiano dell'End&r e &cScilla&r, alla massima forza dell'Era 5."
	]
	quest.39E32291BA10EE17.title: "Squadra al completo"
	quest.39E32291BA10EE17.quest_subtitle: "Nessuno resta a casa"
	quest.39E32291BA10EE17.quest_desc: [
		"&7&oUn boss è una festa: si viene tutti.&r"
		"Battete un boss di Cataclysm con &atutta la squadra presente&r, ognuno nel suo ruolo: chi para, chi colpisce, chi cura, chi tira."
	]
	task.7E59FAA06726D4A6.title: "Boss battuto con tutta la squadra, ognuno nel suo ruolo"
	quest.7937B4507C3FB59A.title: "Nessun caduto"
	quest.7937B4507C3FB59A.quest_subtitle: "Tutti a casa, tutti in piedi"
	quest.7937B4507C3FB59A.quest_desc: [
		"&7&oVincere è facile. Vincere senza perdere nessuno, meno.&r"
		"Battete una rivincita &csenza che nessuno della squadra muoia&r durante lo scontro."
	]
	task.7018F1DFE9B97873.title: "Rivincita vinta senza morti nella squadra"
	quest.288ACADFEB0E5A96.title: "&6&lLeggende della colonia&r"
	quest.288ACADFEB0E5A96.quest_subtitle: "Tutti i boss, due volte"
	quest.288ACADFEB0E5A96.quest_desc: [
		"&7&oNelle taverne della colonia si racconta di voi.&r"
		"Ogni boss battuto almeno due volte, il drago e il Warden compresi."
		"Esponete i trofei nel Municipio: la colonia deve vedere chi la protegge."
	]
	task.1C2BE230E52E6D89.title: "Trofei esposti nel Municipio"
	chapter.1B0275DDA56004C9.title: "Il Bestiario"
	chapter.1B0275DDA56004C9.chapter_subtitle: [
		"Tutti i boss e i mostri del mondo"
	]
	quest.7534DE150EFEA839.title: "Ignis"
	quest.7534DE150EFEA839.quest_subtitle: "Boss"
	quest.7534DE150EFEA839.quest_desc: [
		"&oNel Nether c'è un'arena dove le fiamme non si spengono mai. Qualcuno, lì, aspetta uno sfidante."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.122C8CFD1C1C0A8F.title: "Mostro di Netherite"
	quest.122C8CFD1C1C0A8F.quest_subtitle: "Boss"
	quest.122C8CFD1C1C0A8F.quest_desc: [
		"&oTra le rocce del Nether, un'antica forgia custodisce qualcosa di enorme che dorme sotto la lava."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.34145579F77F77C2.title: "L'Araldo"
	quest.34145579F77F77C2.quest_subtitle: "Boss"
	quest.34145579F77F77C2.quest_desc: [
		"&oSotto la superficie del mondo, una fabbrica dimenticata non ha mai smesso di lavorare."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.49D69FF33C44A666.title: "Il Leviatano"
	quest.49D69FF33C44A666.quest_subtitle: "Boss"
	quest.49D69FF33C44A666.quest_desc: [
		"&oIn fondo all'oceano riposano le rovine di una città. Qualcosa nuota tra le sue torri."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.7BDACA5374E89202.title: "Antico Rimasuglio"
	quest.7BDACA5374E89202.quest_subtitle: "Boss"
	quest.7BDACA5374E89202.quest_desc: [
		"&oIl deserto nasconde una piramide maledetta: chi entra sente la sabbia muoversi da sola."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.34F1F7731A232E1B.title: "Maledictus"
	quest.34F1F7731A232E1B.quest_subtitle: "Boss"
	quest.34F1F7731A232E1B.quest_desc: [
		"&oTra i ghiacci sorge una prigione congelata. Le catene, dentro, sono ancora tese."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.1A6CB2CB08DD01EA.title: "Guardiano di Ender"
	quest.1A6CB2CB08DD01EA.quest_subtitle: "Boss"
	quest.1A6CB2CB08DD01EA.quest_desc: [
		"&oNelle isole esterne dell'End, una cittadella in rovina è ancora sorvegliata."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.5949C4F7BF2AE088.title: "Scylla"
	quest.5949C4F7BF2AE088.quest_subtitle: "Boss"
	quest.5949C4F7BF2AE088.quest_desc: [
		"&oSopra il mare si alza un'acropoli battuta dai fulmini. La tempesta ha una padrona."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.2DF620D825B1AC74.title: "Naga"
	quest.2DF620D825B1AC74.quest_subtitle: "Boss"
	quest.2DF620D825B1AC74.quest_desc: [
		"&oNella Foresta del Crepuscolo, un cortile di pietra circondato da siepi. Qualcosa striscia al suo interno."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.132C9C1CBD2B8283.title: "Linch"
	quest.132C9C1CBD2B8283.quest_subtitle: "Boss"
	quest.132C9C1CBD2B8283.quest_desc: [
		"&oUna torre altissima domina la Foresta del Crepuscolo. In cima, uno stregone vi aspetta."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.4B4A9EB95A181F02.title: "Fungotauro"
	quest.4B4A9EB95A181F02.quest_subtitle: "Boss"
	quest.4B4A9EB95A181F02.quest_desc: [
		"&oSotto la palude dei funghi si apre un labirinto. Al centro, un guardiano con le corna."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.11A2DF76A92E8F34.title: "Idra"
	quest.11A2DF76A92E8F34.quest_subtitle: "Boss"
	quest.11A2DF76A92E8F34.quest_desc: [
		"&oNella palude di fuoco l'aria brucia. Una tana fumante ospita qualcosa con più di una testa."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.7523999F72F5CA0D.title: "Cavaliere Fanstasma"
	quest.7523999F72F5CA0D.quest_subtitle: "Boss"
	quest.7523999F72F5CA0D.quest_desc: [
		"&oNella foresta oscura, una roccaforte dei goblin nasconde cavalieri che non sono più vivi."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.2CAB0486ED210E81.title: "Ur-Ghast"
	quest.2CAB0486ED210E81.quest_subtitle: "Boss"
	quest.2CAB0486ED210E81.quest_desc: [
		"&oTra gli alberi giganti, torri scure e rosse custodiscono il pianto di una creatura antica."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.1FFEF59BBA815B4C.title: "Alpha Yeti"
	quest.1FFEF59BBA815B4C.quest_subtitle: "Boss"
	quest.1FFEF59BBA815B4C.quest_desc: [
		"&oNella foresta innevata, una grotta di ghiaccio ospita il capo del branco."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.7ABA4DC25CD2EFEB.title: "Regina delle nevi"
	quest.7ABA4DC25CD2EFEB.quest_subtitle: "Boss"
	quest.7ABA4DC25CD2EFEB.quest_desc: [
		"&oIn cima al ghiacciaio brilla un palazzo d'aurora. La sua regina non ama i visitatori."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.704B869603A451E0.title: "Night Lich"
	quest.704B869603A451E0.quest_subtitle: "Boss"
	quest.704B869603A451E0.quest_desc: [
		"&oNelle terre gelate sorge una torre buia. Di notte, le sue finestre si illuminano."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.54AF29075A23D760.title: "Nether Gauntlet"
	quest.54AF29075A23D760.quest_subtitle: "Boss"
	quest.54AF29075A23D760.quest_desc: [
		"&oNel Nether, un'arena di pietra nera custodisce un pugno d'acciaio grande come una casa."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.126D30EA8EE64BF2.title: "Void Blossom"
	quest.126D30EA8EE64BF2.quest_subtitle: "Boss"
	quest.126D30EA8EE64BF2.quest_desc: [
		"&oNelle caverne più rigogliose, una pianta del vuoto ha messo radici."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.17D1E3F0674B4F78.title: "Obsidilith"
	quest.17D1E3F0674B4F78.quest_subtitle: "Boss"
	quest.17D1E3F0674B4F78.quest_desc: [
		"&oNell'End, un monolito di ossidiana resta immobile. Finché qualcuno non lo tocca."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.16591D6971709912.title: "Guardiano antico"
	quest.16591D6971709912.quest_subtitle: "Boss"
	quest.16591D6971709912.quest_desc: [
		"&oNegli oceani profondi sorgono monumenti di prismarino. Il loro custode è il più vecchio di tutti."
	]
	quest.7651C8FBFD8F1D7E.title: "Wither"
	quest.7651C8FBFD8F1D7E.quest_subtitle: "Boss"
	quest.7651C8FBFD8F1D7E.quest_desc: [
		"&oNon si trova: si evoca. Tre teschi e un po' di sabbia delle anime. Fatelo lontano dalla colonia."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.40945FA559881E9F.title: "Sorvegliante"
	quest.40945FA559881E9F.quest_subtitle: "Boss"
	quest.40945FA559881E9F.quest_desc: [
		"&oNelle città antiche del buio profondo si cammina in silenzio. Il guardiano sente tutto."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.779E5EE71494A95B.title: "Enderdrago"
	quest.779E5EE71494A95B.quest_subtitle: "Boss"
	quest.779E5EE71494A95B.quest_desc: [
		"&oOltre il portale dell'End, il drago aspetta da sempre."
		"&7Diventa più forte ogni volta che lo sconfiggete."
	]
	quest.490A9D61C5B947DE.title: "Albo dei boss: completo"
