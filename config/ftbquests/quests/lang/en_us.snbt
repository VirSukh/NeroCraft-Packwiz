{
	chapter.389A79578A10A723.title: "Era 1 - Fondazione"
	chapter.389A79578A10A723.chapter_subtitle: [
		"Dalla prima colonia alla Caldaia di Bronzo"
	]
	quest.2F89153B28E32312.title: "Benvenuti in NeroCraft"
	quest.2F89153B28E32312.quest_subtitle: "Una colonia, un'industria, poi lo spazio"
	quest.2F89153B28E32312.quest_desc: [
		"§7§oCronaca di NeroCraft, giorno uno: pochi coloni, tanta strada davanti.§r"
		"Le quest avanzano per tutta la squadra: §adividetevi i compiti§r."
		"Meta dell'Era 1: la §6Caldaia di Bronzo§r. Per costruirla serve un §6Sigillo§r che solo il Fabbro della colonia sa forgiare."
		"Spunta il compito e ritira cibo, torce e un letto."
	]
	task.36361CB23C029EFB.title: "Ho letto, cominciamo"
	quest.68A60D25485700D5.title: "Primi strumenti"
	quest.68A60D25485700D5.quest_subtitle: "Pietra e legno per cominciare"
	quest.68A60D25485700D5.quest_desc: [
		"§7§oLe mani nude non bastano.§r"
		"Costruisci un §6piccone di pietra§r e un'§6ascia di pietra§r. Serviranno per minare ferro e rame prima del previsto."
		"Se hai già strumenti di ferro puoi completare subito: conta il risultato, non il materiale."
	]
	quest.6B826FAF0938FE1E.title: "Primo rifugio"
	quest.6B826FAF0938FE1E.quest_subtitle: "Un tetto, un letto, un falò"
	quest.6B826FAF0938FE1E.quest_desc: [
		"§7§oLa notte arriva in fretta e porta ospiti.§r"
		"Piazza un §6letto§r per impostare il punto di rinascita. Costruisci un §6falò§r davanti alla base: la luce tiene lontani i mob."
		"Un riparo chiuso con una porta basta per le prime notti."
	]
	quest.6F2100FB25CBC4C3.title: "Sacco a pelo"
	quest.6F2100FB25CBC4C3.quest_subtitle: "Dormire senza cambiare rinascita"
	quest.6F2100FB25CBC4C3.quest_desc: [
		"Tre lane dello stesso colore in riga: ottieni un §6sacco a pelo§r."
		"A differenza del letto, §anon cambia il punto di rinascita§r. Perfetto per le spedizioni lontane."
		"§aBasta che dormano la metà dei giocatori§r per far passare la notte."
	]
	quest.5089C109F4649580.title: "La fornace"
	quest.5089C109F4649580.quest_subtitle: "Fondi il minerale in lingotti"
	quest.5089C109F4649580.quest_desc: [
		"§7§oIl primo fuoco industriale: otto ciottoli in cerchio.§r"
		"La §6fornace§r trasforma il minerale grezzo in lingotti. Brucia carbone, legna o carbonella."
		"Ne serviranno parecchie: il ferro è la base di quasi tutto."
	]
	quest.49A4B20659EB3982.title: "Trucchi di sopravvivenza"
	quest.49A4B20659EB3982.quest_subtitle: "Cadaveri e traslochi"
	quest.49A4B20659EB3982.quest_desc: [
		"§cSe muori§r lasci un cadavere con tutto il tuo inventario: torna lì e aprilo per riprendere le tue cose."
		"Shift + clic destro a mani vuote su una cassa o un animale per prenderlo in braccio, contenuto compreso."
		"Il sacco a pelo del kit fa passare la notte senza spostare il punto di rinascita. §aBasta che dorma metà della squadra.§r"
	]
	task.449F4381B60DDFAF.title: "Ho capito"
	quest.46E35D41CA32E436.title: "Ferro e rame"
	quest.46E35D41CA32E436.quest_subtitle: "La scorta per tutto ciò che segue"
	quest.46E35D41CA32E436.quest_desc: [
		"§7§oLe prime gallerie: la colonia ha fame di metallo.§r"
		"Scendete in miniera e fondete 16 lingotti di ferro e 16 di rame."
		"Il ferro serve per il §6Barile da Compost§r, il §6Martello da Forgia§r e il Sigillo. Il rame diventerà bronzo."
		"Ricompensa: lo &6Zaino&r. Se ne indossa uno solo: per allargarlo servono i &egettoni&r che lasciano i boss."
	]
	quest.5D7CDE36C76B6015.title: "Armatura di ferro"
	quest.5D7CDE36C76B6015.quest_subtitle: "Indispensabile la notte"
	quest.5D7CDE36C76B6015.quest_desc: [
		"§7§oI mob colpiscono duro fin dal primo giorno.§r"
		"Costruisci almeno un §6elmo§r e un §6pettorale di ferro§r. Un set completo protegge molto meglio."
		"La corazza è la priorità: ogni pezzo aggiunge barre di armatura."
	]
	quest.37C6F85F31D4399B.title: "Spada e scudo"
	quest.37C6F85F31D4399B.quest_subtitle: "Per la prima ronda"
	quest.37C6F85F31D4399B.quest_desc: [
		"Costruisci una §6spada di ferro§r e uno §6scudo§r. Lo scudo si alza con il tasto destro e blocca i colpi frontali."
		"La spada di ferro è il minimo indispensabile contro gli scheletri e i creeper notturni."
	]
	quest.618AA7DFBB70AA5B.title: "Piccone di ferro"
	quest.618AA7DFBB70AA5B.quest_subtitle: "Scava più in fretta e più in profondo"
	quest.618AA7DFBB70AA5B.quest_desc: [
		"Il §6piccone di ferro§r è più veloce di quello di pietra e mina tutto tranne l'ossidiana."
		"Ne serviranno tanti: il sottosuolo è ricco di minerali."
	]
	quest.402783E5731E80E7.title: "Secchio d'acqua"
	quest.402783E5731E80E7.quest_subtitle: "Lava, cascate, e la Pentola"
	quest.402783E5731E80E7.quest_desc: [
		"Il §6secchio§r porta acqua e lava, e salva la vita nelle cadute: l'acqua annulla il danno."
		"Ne servirà uno anche per la §6Pentola§r e per riempire la Caldaia di Bronzo."
	]
	quest.1532340EB2C5CF31.title: "La colonia di tutti"
	quest.1532340EB2C5CF31.quest_subtitle: "Un solo Municipio per la squadra"
	quest.1532340EB2C5CF31.quest_desc: [
		"§7§oIl Municipio è la prima pietra: tutto il resto ci crescerà attorno.§r"
		"La colonia è una sola e condivisa. Il primo giocatore entrato nel mondo ha ricevuto il §6Municipio§r: va piazzato su un terreno ampio e pianeggiante."
		"Se la colonia esiste già, la chat ti ha indicato dove si trova: raggiungila."
		"Da qui in poi il villaggio assume coloni, sceglie i terreni e costruisce da solo."
	]
	task.287A78761C66351F.title: "La colonia è fondata e so dove si trova"
	quest.4B07135602E23FDC.title: "Giù le mani"
	quest.4B07135602E23FDC.quest_subtitle: "Proteggi la tua base dai Costruttori"
	quest.4B07135602E23FDC.quest_desc: [
		"La colonia costruisce dove trova spazio, anche sopra casa tua."
		"Con la bacchetta §6Zone Marker§r in mano, clic destro su un angolo e poi sull'angolo opposto: lì dentro (fino a 48 blocchi per lato) il villaggio non costruirà mai."
		"§cSegna la zona PRIMA di costruire vicino al villaggio.§r"
	]
	task.2AAA7CDB9E879A7F.title: "Ho segnato la zona della mia base"
	quest.4329655A64A6D5B2.title: "Costruttori al lavoro"
	quest.4329655A64A6D5B2.quest_subtitle: "Il villaggio prende forma da solo"
	quest.4329655A64A6D5B2.quest_desc: [
		"§7§oSi sentono i primi martelli: il villaggio prende forma.§r"
		"La colonia piazza da sola i §6Capanni del Costruttore§r, le case e i primi edifici: circa uno ogni dieci minuti. La chat annuncia ogni lavoro finito."
		"Non devi assumere nessuno. Nel frattempo sistemati: una base, un letto, qualcosa da mangiare."
	]
	task.20E72E1C9BB25969.title: "I Costruttori hanno finito i primi edifici"
	quest.53B790CE70A7618D.title: "La Fattoria"
	quest.53B790CE70A7618D.quest_subtitle: "Cibo automatico per la colonia"
	quest.53B790CE70A7618D.quest_desc: [
		"§7§oI coloni hanno fame: servono campi.§r"
		"La colonia piazza la §6Fattoria§r da sola. Il contadino semina e raccoglie grano, patate e carote."
		"Porta semi e zappe nel Magazzino per aiutarlo a partire."
	]
	task.711498D613AF1E2E.title: "La Fattoria è costruita e il contadino lavora"
	quest.22AF509013AF526E.title: "Il Pescatore"
	quest.22AF509013AF526E.quest_subtitle: "Pesce fresco ogni giorno"
	quest.22AF509013AF526E.quest_desc: [
		"Il §6Pescatore§r va in acqua e riporta pesce al Magazzino. È uno dei primi edifici che la colonia costruisce."
		"Non ha bisogno di materiali speciali: basta aspettare."
	]
	task.2DD498CC39A00EE5.title: "Il Pescatore è costruito"
	quest.21F3BB7225ED4146.title: "Il Boscaiolo"
	quest.21F3BB7225ED4146.quest_subtitle: "Legna infinita"
	quest.21F3BB7225ED4146.quest_desc: [
		"Il §6Boscaiolo§r taglia alberi e li ripianta. Il legno è il materiale più usato della colonia: tavole, assi, strumenti."
		"Più il suo edificio sale di livello, più è veloce."
	]
	task.22826E139DD14F89.title: "Il Boscaiolo è costruito e al lavoro"
	quest.4C6D68E8728E5B0F.title: "La Miniera"
	quest.4C6D68E8728E5B0F.quest_subtitle: "Ferro, rame e carbone dalla colonia"
	quest.4C6D68E8728E5B0F.quest_desc: [
		"La §6Miniera§r scava gallerie e riporta minerale al Magazzino. Più sale di livello, più in profondo scende."
		"Il minerale va nel Magazzino e la Fonderia (se c'è) lo fonde in lingotti."
	]
	task.2DDD8F765E19FB8D.title: "La Miniera è costruita"
	quest.5AACB9CD4FFF4926.title: "Il Magazzino"
	quest.5AACB9CD4FFF4926.quest_subtitle: "Tutto finisce qui"
	quest.5AACB9CD4FFF4926.quest_desc: [
		"§7§oUn posto per ogni cosa: la colonia non funziona senza un deposito.§r"
		"Il §6Magazzino§r è il cuore logistico. Tutti i lavoratori portano qui i prodotti e prendono i materiali."
		"Nel blocco del Magazzino trovi la scheda §6Scorta minima§r: da lì ordini ciò che serve (come il Sigillo)."
	]
	task.1429435BE7A183A3.title: "Il Magazzino è costruito"
	quest.1989D8B551D833A6.title: "Tasse e casse comuni"
	quest.1989D8B551D833A6.quest_subtitle: "I ColonyBucks pagano ciò che manca"
	quest.1989D8B551D833A6.quest_desc: [
		"§7§oIl tesoriere della colonia apre il primo registro.§r"
		"Quello che la colonia non produce lo paga in §6ColonyBucks§r: senza soldi le richieste restano in attesa."
		"{@pagebreak}"
		"La colonia raccoglie tasse in smeraldi ogni 20 minuti: ritirale con /wnt claimtax. Più i coloni sono felici, più pagano."
		"Al banco 16 smeraldi (un blocco di smeraldo più 7 smeraldi) diventano 1 ColonyBuck; ne cadono anche dai mostri. Shift + clic destro sul Municipio per versarli."
		"Il Fabbro e gli altri artigiani comprano col tesoro quello che non trovano nel Magazzino: §asenza ColonyBucks il Sigillo può restare in attesa§r."
	]
	quest.4CFDF0B6D308A5EB.title: "La Fonderia"
	quest.4CFDF0B6D308A5EB.quest_subtitle: "Lingotti senza fatica"
	quest.4CFDF0B6D308A5EB.quest_desc: [
		"La §6Fonderia§r della colonia fonde il minerale grezzo in lingotti, così non dovete farlo voi in fornace."
		"Più sale di livello, più veloce diventa. Il minerale va nel Magazzino."
	]
	task.3543337411DE884A.title: "La Fonderia è costruita"
	quest.236C37125D227563.title: "Barile da Compost"
	quest.236C37125D227563.quest_subtitle: "Il Sigillo comincia dagli scarti"
	quest.236C37125D227563.quest_desc: [
		"§7§oIl vecchio fabbro giura che il Sigillo nasce dagli scarti. Nessuno ride.§r"
		"Il §6Sigillo della Gilda§r richiede ferro e Compost di MineColonies."
		"Costruisci un Barile da Compost: assi, un blocco di terra, un lingotto di ferro e il bastone da costruzione in alto al centro (non viene consumato)."
	]
	quest.12FBE97520A1F1B4.title: "Compost"
	quest.12FBE97520A1F1B4.quest_subtitle: "Riempi, aspetta, raccogli"
	quest.12FBE97520A1F1B4.quest_desc: [
		"§7§oL'odore arriva fino al Municipio. Si chiama progresso.§r"
		"Clic destro sul Barile con scarti in mano finché è pieno: foglie, semi, fiori, carne marcia, grano, funghi."
		"Aspetta che fermenti, poi clic destro per raccogliere il §6Compost§r. Per un Sigillo ne basta 1."
	]
	quest.44456385C520A284.title: "Un colono al barile"
	quest.44456385C520A284.quest_subtitle: "Il Compostatore lo fa al posto tuo"
	quest.44456385C520A284.quest_desc: [
		"§6Capanno del Compostatore§r: assi, un Barile da Compost al centro e il bastone da costruzione in alto."
		"Piazzalo nel villaggio: un Costruttore lo edifica e un colono riempie i barili al posto tuo."
	]
	quest.647C762709F29279.title: "Il Fabbro"
	quest.647C762709F29279.quest_subtitle: "L'unico che sa forgiare il Sigillo"
	quest.647C762709F29279.quest_desc: [
		"§7§oLa fucina della colonia si accende per la prima volta.§r"
		"Servono tre edifici: il §6Fabbro§r forgia, il §6Magazzino§r conserva, il Corriere trasporta."
		"La colonia li costruisce da sola quando cresce. Avete fretta? Il Capanno del Fabbro potete fabbricarlo e piazzarlo voi: assi, tre lingotti di ferro e il bastone da costruzione."
	]
	task.7C2B76AB4ECD41F5.title: "Fabbro, Magazzino e Corriere sono costruiti e al lavoro"
	quest.32FAA9BAEA6ABE52.title: "Sigillo della Gilda"
	quest.32FAA9BAEA6ABE52.quest_subtitle: "Non si fabbrica al banco: si ordina"
	quest.32FAA9BAEA6ABE52.quest_desc: [
		"§7§oSul Sigillo c'è il marchio della Gilda degli Ingegneri: senza, niente vapore.§r"
		"Il Fabbro conosce già la ricetta: 4 lingotti di ferro e 1 Compost."
		"{@pagebreak}"
		"Nel blocco del Magazzino, scheda §6Scorta minima§r, aggiungi il §6Sigillo della Gilda degli Ingegneri§r: la richiesta arriva al Fabbro."
		"Metti ferro e Compost negli scaffali del Magazzino: il Corriere li porta al Fabbro e riporta il Sigillo finito."
		"La Cassetta Postale non serve: gli ordini dei giocatori sono bloccati."
	]
	quest.396802C903E4181C.title: "Martello da Forgia"
	quest.396802C903E4181C.quest_subtitle: "Il primo banco dell'industria"
	quest.396802C903E4181C.quest_desc: [
		"§7§oNel retro della fucina qualcuno monta un banco tutto suo.§r"
		"Mentre la colonia lavora, prepara l'industria."
		"Al banco: tre piastre a pressione pesanti in alto, un lingotto di ferro al centro, tre in basso."
		"Inserisci un lingotto e scegli cosa ottenere: polvere, piastra, asta. §6Non consuma carburante§r."
	]
	quest.1591B53BA545F75B.title: "Polvere di ferro"
	quest.1591B53BA545F75B.quest_subtitle: "Il Martello macina tutto"
	quest.1591B53BA545F75B.quest_desc: [
		"Nel §6Martello da Forgia§r inserisci un lingotto di ferro e scegli la polvere."
		"La polvere ha molti usi: nelle ere successive servirà per leghe e componenti chimici."
	]
	quest.7214C2C7098DF4AF.title: "Piastre di ferro"
	quest.7214C2C7098DF4AF.quest_subtitle: "Appiattite al Martello"
	quest.7214C2C7098DF4AF.quest_desc: [
		"Nel §6Martello da Forgia§r inserisci un lingotto di ferro e scegli la §6piastra§r."
		"Le piastre sono il componente base di quasi tutte le macchine di Modern Industrialization. §aPrimi passi dell'industria!§r"
	]
	quest.23B673B319080395.title: "Aste di ferro"
	quest.23B673B319080395.quest_subtitle: "Lunghe e sottili"
	quest.23B673B319080395.quest_desc: [
		"Nel §6Martello da Forgia§r, con un lingotto di ferro, scegli l'§6asta§r."
		"Le aste servono come assi per pistoni, supporti e parti meccaniche. Anche il rame e il bronzo hanno le loro."
	]
	quest.79885B76D1339F39.title: "Piastre di rame"
	quest.79885B76D1339F39.quest_subtitle: "Anche il rame si appiattisce"
	quest.79885B76D1339F39.quest_desc: [
		"Nel §6Martello da Forgia§r inserisci un lingotto di rame e scegli la §6piastra§r."
		"Le piastre di rame servono come materiale per componenti dell'era 2. Per ora sono utili per le tubature."
	]
	quest.7CB6AD2F329C6C42.title: "Stagno"
	quest.7CB6AD2F329C6C42.quest_subtitle: "Il metallo che manca"
	quest.7CB6AD2F329C6C42.quest_desc: [
		"§7§oLo stagno non affiora: bisogna scendere.§r"
		"Il minerale di §6stagno§r di Modern Industrialization si trova sottoterra nel mondo normale."
		"Fondi lo stagno grezzo in lingotti, poi nel Martello da Forgia trasformali in polvere."
	]
	quest.11E2F17E77B88261.title: "Lingotti di stagno"
	quest.11E2F17E77B88261.quest_subtitle: "Lo stagno si fonde come il ferro"
	quest.11E2F17E77B88261.quest_desc: [
		"Fondi lo §6stagno grezzo§r in fornace per ottenere i lingotti. Oppure usa la polvere di stagno e fondi quella."
		"I lingotti serviranno per cavi e componenti nelle ere successive."
	]
	quest.6CEF7F8F55B78DBB.title: "Polvere di rame"
	quest.6CEF7F8F55B78DBB.quest_subtitle: "Tre parti della lega"
	quest.6CEF7F8F55B78DBB.quest_desc: [
		"Nel §6Martello da Forgia§r inserisci un lingotto di rame e scegli la polvere."
		"Per la lega di bronzo servono §63 polveri di rame§r + 1 di stagno. Preparane almeno 15 per i primi lingotti di bronzo."
	]
	quest.30B39D7F44A8DB7E.title: "Lega di bronzo"
	quest.30B39D7F44A8DB7E.quest_subtitle: "Tre parti di rame, una di stagno"
	quest.30B39D7F44A8DB7E.quest_desc: [
		"§7§oPrima colata di bronzo: il metallo di tutta l'era che viene.§r"
		"Al banco unisci §63 polveri di rame§r e §61 di stagno§r: ottieni 3 polveri di bronzo."
		"Cuoci la polvere in fornace. Per la caldaia servono §614 lingotti di bronzo§r."
	]
	quest.1D5922277DC8D976.title: "Piastre di bronzo"
	quest.1D5922277DC8D976.quest_subtitle: "Sette piastre per una caldaia"
	quest.1D5922277DC8D976.quest_desc: [
		"§7§oIl martello batte fino a sera.§r"
		"Nel Martello da Forgia metti i lingotti di bronzo e scegli la piastra: 2 lingotti per piastra."
		"La §6Caldaia di Bronzo§r ne chiede 7."
	]
	quest.2FDC0DEC7BD15282.title: "Aste di bronzo"
	quest.2FDC0DEC7BD15282.quest_subtitle: "Rinforzi per le macchine a vapore"
	quest.2FDC0DEC7BD15282.quest_desc: [
		"Nel §6Martello da Forgia§r trasforma i lingotti di bronzo in §6aste§r."
		"Le aste di bronzo servono nelle macchine a vapore dell'Era 2. Preparane qualcuna in anticipo."
	]
	quest.76D8005FD005F6FA.title: "Involucro di macchina in bronzo"
	quest.76D8005FD005F6FA.quest_subtitle: "La corazza delle macchine a vapore"
	quest.76D8005FD005F6FA.quest_desc: [
		"Al banco: 8 §6piastre di bronzo§r in cerchio = 1 §6Bronze Machine Casing§r."
		"È la base di quasi ogni macchina a vapore dell'Era 2. Preparane almeno uno."
	]
	quest.28710DC22E221CEF.title: "§6§lCaldaia di Bronzo§r"
	quest.28710DC22E221CEF.quest_subtitle: "Il vapore apre l'Era 2"
	quest.28710DC22E221CEF.quest_desc: [
		"§7§oIl primo sbuffo di vapore si sente in tutta la colonia.§r"
		"Al banco: un lingotto di rame al centro, il §6Sigillo della Gilda§r sotto, piastre di bronzo nelle altre sette caselle. Il Sigillo viene consumato."
		"Appena qualcuno la ottiene, §atutta la squadra entra nell'Era 2§r e FTB Ultimine si attiva."
		"Riempila d'acqua e brucia carbone o legna: il vapore muove le prime macchine."
	]
	quest.2A772F8746F782C0.title: "Dispensa varia"
	quest.2A772F8746F782C0.quest_subtitle: "Più piatti diversi, più cuori"
	quest.2A772F8746F782C0.quest_desc: [
		"La §6Pentola§r di Farmer's Delight si fa con mattoni, lingotti di ferro, una pala di legno e un secchio d'acqua."
		"Mettila sopra un falò: cuoce zuppe e stufati che saziano molto."
		"Ogni cibo nuovo che assaggi ti avvicina a cuori in più: varia il menu."
	]
	quest.247577BE8F67F5E0.title: "La tua classe"
	quest.247577BE8F67F5E0.quest_subtitle: "Ognuno il suo ruolo"
	quest.247577BE8F67F5E0.quest_desc: [
		"Uccidere mostri dà punti abilità. Apri l'albero (tasto di base K): 8 classi tra maghi (arcano, fuoco, gelo), sacerdote, paladino, guerriero, ladro e arciere."
		"§cUna sola classe a testa§r: la prima scelta esclude le altre. §aDecidete i ruoli in squadra prima di spendere punti.§r Tutto il resto è nel capitolo Classi."
	]
	task.60580691C7679DA8.title: "Ho aperto l'albero delle abilità"
	quest.5FAFA5F462761169.title: "Pietre del viaggio"
	quest.5FAFA5F462761169.quest_subtitle: "Le waystone del mondo"
	quest.5FAFA5F462761169.quest_desc: [
		"Nel mondo e in alcuni villaggi si trovano §6waystone§r già pronte. Clic destro per attivarle: poi puoi teletrasportarti da una all'altra pagando esperienza."
		"Costruirne di nuove richiede il bronzo: arriverà nell'Era 2."
	]
	task.1024138E90454CA1.title: "Ho attivato una waystone"
	quest.6B0E2F03171E1B33.title: "Bussola della Natura"
	quest.6B0E2F03171E1B33.quest_subtitle: "Trova qualsiasi bioma"
	quest.6B0E2F03171E1B33.quest_desc: [
		"La §6Nature's Compass§r ti dice direzione e distanza del bioma che cerchi. Perfetta per trovare una giungla, un deserto o un bioma con risorse specifiche."
		"Al banco: 4 assi di legno intorno a una bussola e 4 semi di grano agli angoli. Ha la ricetta originale, nessun blocco di progressione."
	]
	quest.1E545423D5AF5FB8.title: "Il miglior amico"
	quest.1E545423D5AF5FB8.quest_subtitle: "Un cane che impara"
	quest.1E545423D5AF5FB8.quest_desc: [
		"Addomestica un lupo, poi dagli un §6Training Treat§r: diventa un cane di Doggy Talents, che sale di livello e impara talenti."
		"Il Training Treat si fa con spago, osso, polvere da sparo, zucchero e una ciotola di riso."
	]
	quest.708228784BEBA881.title: "Rete da cattura"
	quest.708228784BEBA881.quest_subtitle: "Cattura animali di Naturalist"
	quest.708228784BEBA881.quest_desc: [
		"La §6Capture Net§r cattura gli animali di Naturalist in un oggetto: rilasciali dove preferisci."
		"Utile per portare animali esotici alla base. Si crafta con spago e bastoni."
	]
	quest.340BF5DAF4DC4748.title: "Polvere di bronzo"
	quest.340BF5DAF4DC4748.quest_subtitle: "La lega prima della fornace"
	quest.340BF5DAF4DC4748.quest_desc: [
		"Al banco: §63 polveri di rame§r + §61 polvere di stagno§r = §63 polveri di bronzo§r."
		"La polvere di bronzo va cotta in fornace per ottenere i lingotti. È l'unico modo per fare il bronzo a mano."
	]
	quest.3E9B7186EF66EBD0.title: "La Taverna"
	quest.3E9B7186EF66EBD0.quest_subtitle: "Nuovi coloni arrivano qui"
	quest.3E9B7186EF66EBD0.quest_desc: [
		"La §6Taverna§r è il punto di arrivo dei nuovi coloni. Senza, la crescita della colonia si ferma."
		"La colonia la costruisce da sola, ma se tarda potete piazzare il blocco voi."
	]
	task.7087A808F27DB297.title: "La Taverna è costruita"
	quest.707EE75EF998E255.title: "Tagliapietre"
	quest.707EE75EF998E255.quest_subtitle: "Pietre decorative per i Costruttori"
	quest.707EE75EF998E255.quest_desc: [
		"Il §6Tagliapietre§r trasforma un blocco di pietra in scalini, lastre e muri con meno sprechi del banco."
		"Utile per decorare la base e per fornire materiale ai Costruttori della colonia."
	]
	quest.7D845773776D9576.title: "Prima scorta di carbone"
	quest.7D845773776D9576.quest_subtitle: "Combustibile per tutto"
	quest.7D845773776D9576.quest_desc: [
		"Il carbone è il combustibile più versatile: fornaci, torce e la futura Caldaia di Bronzo lo bruciano."
		"Raccogline una §6scorta§r: servirà da qui fino alla fine dell'Era 2."
	]
	quest.6679256DA8819BFA.title: "Il Corriere"
	quest.6679256DA8819BFA.quest_subtitle: "Porta e preleva dal Magazzino"
	quest.6679256DA8819BFA.quest_desc: [
		"Il §6Corriere§r trasporta oggetti tra il Magazzino e i lavoratori. Senza di lui, il Fabbro non riceve materiali."
		"La colonia lo costruisce da sola. Puoi averne più d'uno per velocizzare le consegne."
	]
	task.65755B220B0E8666.title: "Almeno un Corriere è al lavoro"
	quest.21C7D4156870616B.title: "Primi piatti"
	quest.21C7D4156870616B.quest_subtitle: "Zuppe e stufati dalla Pentola"
	quest.21C7D4156870616B.quest_desc: [
		"Piazza la §6Pentola§r sopra un §6falò§r: inserisci gli ingredienti e un contenitore (ciotola). Aspetta che cuocia."
		"Prova la §6zuppa di pollo§r: pollo, patata, carota, ciotola. O uno §6stufato di manzo§r: manzo, patata, carota, ciotola."
		"I piatti cucinati saziano molto più degli ingredienti crudi!"
	]
	quest.2ADF10C3A22B33B8.title: "Scorta di bronzo"
	quest.2ADF10C3A22B33B8.quest_subtitle: "L'Era 2 ne mangia parecchio"
	quest.2ADF10C3A22B33B8.quest_desc: [
		"Le macchine a vapore dell'Era 2 richiedono §6molte piastre e aste di bronzo§r."
		"Preparate almeno §632 lingotti in più§r oltre a quelli della caldaia: sarà il materiale base per tutto l'inizio dell'Era 2."
		"Ogni set di 3 polveri di rame + 1 di stagno dà 3 polveri di bronzo. Cuocetele in fornace."
	]
	quest.6F66D200BD2E67A0.title: "Aste di rame"
	quest.6F66D200BD2E67A0.quest_subtitle: "I primi cavi dell'industria"
	quest.6F66D200BD2E67A0.quest_desc: [
		"Nel §6Martello da Forgia§r inserisci un lingotto di rame e scegli l'§6asta§r."
		"Le aste di rame servono nelle ricette di alcune macchine e componenti elettrici."
	]
	quest.1D82B6450E6F3BCD.title: "Stagno grezzo"
	quest.1D82B6450E6F3BCD.quest_subtitle: "Materia prima"
	quest.1D82B6450E6F3BCD.quest_desc: [
		"Lo stagno serve per il bronzo: cercatelo in miniera insieme al rame."
		"&7Si trova nel mondo: scava, esplora o raccogli."
		"&7Serve per:&r Polvere di stagno"
	]
	chapter.12AC10711B34BE70.title: "Era 2 - Vapore"
	chapter.12AC10711B34BE70.chapter_subtitle: [
		"Dalla Caldaia di Bronzo all'Altoforno Elettrico"
	]
	quest.4160DF60E413F3B6.title: "Vapore in pressione"
	quest.4160DF60E413F3B6.quest_subtitle: "Due fronti per una squadra"
	quest.4160DF60E413F3B6.quest_desc: [
		"&7&oLa caldaia fischia: NeroCraft entra nell'età del vapore.&r"
		"Meta dell'Era 2: l'&6Altoforno Elettrico&r. Chiede 4 Involucri d'Acciaio, 4 Mattoni Refrattari e un Lingotto di Ignitium, che lascia solo &cIgnis, boss del Nether&r."
		"&aDividetevi: chi resta all'industria, chi prepara la spedizione nel Nether.&r"
		"FTB Ultimine ora è attivo: tieni premuto il tasto e scava un filone intero."
	]
	task.23AAE81E26A52DB4.title: "Abbiamo deciso chi fa cosa"
	quest.6F1F0AF1A470A309.title: "Involucri e tubi"
	quest.6F1F0AF1A470A309.quest_subtitle: "Lo scheletro di ogni macchina"
	quest.6F1F0AF1A470A309.quest_desc: [
		"&7&oIl cortile della colonia si riempie di tubi che sibilano.&r"
		"&6Involucro di Bronzo&r: 8 piastre di bronzo e un ingranaggio di bronzo al centro. Ne serviranno molti, anche per i portelli delle strutture."
		"Tubi per fluidi: piastre curve di bronzo, rotori di rame e un pannello di vetro. Portano il vapore dalla caldaia alle macchine."
	]
	quest.6DE5A7C69527E278.title: "Macinatore a Vapore"
	quest.6DE5A7C69527E278.quest_subtitle: "Polveri, e minerali raddoppiati"
	quest.6DE5A7C69527E278.quest_desc: [
		"&7&oLa prima macina a vapore gira giorno e notte.&r"
		"Due diamanti, tre ingranaggi di rame, un Involucro di Bronzo e tre tubi per fluidi."
		"Collegalo al vapore: macina il coke in polvere, i mattoni in polvere di mattone e i minerali grezzi con resa maggiore."
		"Senza la &6polvere di coke&r non c'è acciaio."
	]
	quest.280F5B713849B50E.title: "Forno a Coke"
	quest.280F5B713849B50E.quest_subtitle: "La prima struttura multiblocco"
	quest.280F5B713849B50E.quest_desc: [
		"&7&oUn muro di mattoni anneriti: la prima vera fabbrica.&r"
		"Controller: 8 mattoni (blocco) attorno a una fornace. Il resto della struttura è di mattoni: tieni in mano la &6Chiave inglese&r e vedrai l'ologramma."
		"Al posto di alcuni mattoni metti i portelli: un Involucro di Bronzo con una tramoggia per gli oggetti, con un Serbatoio di Bronzo per il vapore."
		"Carbone dentro, coke fuori."
	]
	quest.4710E876D5C59ECC.title: "Argilla refrattaria"
	quest.4710E876D5C59ECC.quest_subtitle: "Mattoni che reggono il calore"
	quest.4710E876D5C59ECC.quest_desc: [
		"&7&oI mattonai della colonia imparano un impasto nuovo.&r"
		"Macina mattoni (anche in blocco) in polvere di mattone. Al banco: 2 palle d'argilla e 2 polveri di mattone danno 3 polveri d'argilla refrattaria."
		"Cuocile in fornace: Mattone Refrattario. Quattro fanno un blocco di Mattoni Refrattari."
		"Tieni da parte &64 Mattoni Refrattari sciolti&r: li chiede l'Altoforno Elettrico."
	]
	quest.29BE0CCAE0381C3B.title: "Altoforno a Vapore"
	quest.29BE0CCAE0381C3B.quest_subtitle: "Dove nasce l'acciaio"
	quest.29BE0CCAE0381C3B.quest_desc: [
		"&7&oLe fiamme dell'altoforno si vedono dal Municipio.&r"
		"Controller: un altoforno circondato da 8 blocchi di &6Mattoni Refrattari&r."
		"La struttura è tutta di Mattoni Refrattari, con i portelli di bronzo per oggetti e vapore. Ne servono molti: l'ologramma della Chiave inglese mostra quanti."
	]
	quest.59E3D73CE3681FEC.title: "Acciaio"
	quest.59E3D73CE3681FEC.quest_subtitle: "Ferro più coke, tanto calore"
	quest.59E3D73CE3681FEC.quest_desc: [
		"&7&oIl primo lingotto d'acciaio passa di mano in mano.&r"
		"Al banco: 7 polveri di ferro e 2 polveri di coke danno 7 Polveri d'Acciaio Grezzo."
		"Cuocile nell'Altoforno a Vapore: ogni polvere diventa un &6lingotto d'acciaio&r."
		"Per l'Altoforno Elettrico ne serviranno una sessantina: &atenete acceso il forno&r."
	]
	quest.7A934BA0F95597D4.title: "Involucri d'Acciaio"
	quest.7A934BA0F95597D4.quest_subtitle: "Quattro per l'Altoforno Elettrico"
	quest.7A934BA0F95597D4.quest_desc: [
		"&7&oL'officina è pronta. Manca solo il fuoco.&r"
		"Come quello di bronzo: 8 piastre d'acciaio e un &6ingranaggio d'acciaio&r al centro."
		"L'ingranaggio chiede 4 piastre, 4 bulloni e un anello: tutto dal Martello da Forgia."
		"Prepara anche i 4 Mattoni Refrattari sciolti. Manca solo l'Ignitium."
	]
	quest.1DB8E3B238387055.title: "&6&lAltoforno Elettrico&r"
	quest.1DB8E3B238387055.quest_subtitle: "Il fuoco di Ignis apre l'Era 3"
	quest.1DB8E3B238387055.quest_desc: [
		"&7&oIl fuoco di Ignis chiuso in un cuore d'acciaio.&r"
		"Al banco: &6Lingotto di Ignitium&r al centro, 4 Involucri d'Acciaio ai lati, 4 Mattoni Refrattari negli angoli."
		"Appena qualcuno lo ottiene, &atutta la squadra entra nell'Era 3&r."
		"Per farlo funzionare servono elettricità e bobine: è il lavoro della prossima era."
	]
	quest.2D15C719B1202F56.title: "Rotta per il Nether"
	quest.2D15C719B1202F56.quest_subtitle: "Il fronte di fuoco"
	quest.2D15C719B1202F56.quest_desc: [
		"&7&oIl portale si accende. Dall'altra parte, caldo e silenzio.&r"
		"Costruite un portale di ossidiana ed &aentrate insieme&r."
		"&cI mostri si rafforzano con le ere e col passare del tempo&r: armature buone, cibo, blocchi da costruzione e pozioni di resistenza al fuoco."
	]
	quest.40794F343F4AC633.title: "L'Arena Ardente"
	quest.40794F343F4AC633.quest_subtitle: "La casa di Ignis"
	quest.40794F343F4AC633.quest_desc: [
		"&7&oGli esploratori tornano parlando di un'arena di pietra nera.&r"
		"Ignis vive in una grande arena di pietra nera, nelle Lande del Nether (Nether Wastes)."
		"&aEsplorate in gruppo e segnate la posizione sulla mappa per chi arriva dopo.&r"
	]
	quest.14E08A28ED56DEC0.title: "Ceneri Ardenti"
	quest.14E08A28ED56DEC0.quest_subtitle: "La chiave per svegliarlo"
	quest.14E08A28ED56DEC0.quest_desc: [
		"&7&oTra le rovine qualcosa brucia ancora.&r"
		"Nell'arena si aggira il &cRevenant Infuocato&r: abbattetelo e lascia le &6Ceneri Ardenti&r."
		"Le Ceneri, posate sull'Altare del Fuoco, risvegliano Ignis. &cNon usatele finché la squadra non è pronta.&r"
	]
	quest.339B1507D1DC54AB.title: "Squadra d'assalto"
	quest.339B1507D1DC54AB.quest_subtitle: "Ignis si batte in gruppo"
	quest.339B1507D1DC54AB.quest_desc: [
		"&7&oSi affilano le armi e si contano le pozioni.&r"
		"Ignis è pensato per tutta la squadra: &adecidete chi lo tiene impegnato, chi cura e chi colpisce da lontano&r."
		"&cDiventa più forte in ogni era e dopo ogni uccisione&r: affrontarlo ora costa meno che dopo."
		"Riparate le armature, portate cibo e pozioni, piazzate un letto o una waystone vicino all'arena."
	]
	task.2CC33D18C1D8EFC3.title: "Ruoli decisi, equipaggiamento pronto"
	quest.520897AAB16FE60F.title: "Ignis"
	quest.520897AAB16FE60F.quest_subtitle: "Il fuoco che forgia l'Ignitium"
	quest.520897AAB16FE60F.quest_desc: [
		"&7&oIl giorno in cui NeroCraft sfidò il fuoco.&r"
		"Posate le Ceneri Ardenti sull'Altare del Fuoco e &acombattete insieme&r."
		"Ignis lascia &6Lingotti di Ignitium&r: per l'Altoforno Elettrico ne basta uno, gli altri conservateli nelle casse comuni."
		"&6Gettoni:&r ogni giocatore entro 64 blocchi riceve &e3 gettoni&r alla prima uccisione di questo boss, &e1&r alle successive."
	]
	quest.6AC504D806BB4133.title: "Falegname e Tagliapietre"
	quest.6AC504D806BB4133.quest_subtitle: "La colonia prepara l'Era 3"
	quest.6AC504D806BB4133.quest_desc: [
		"&7&oLa colonia guarda già oltre il vapore.&r"
		"Nell'Era 3 l'industria avrà bisogno della colonia: il &6Falegname&r (livello 2) farà i Telai Rinforzati, il &6Tagliapietre&r (livello 3) i Pannelli Termoisolanti."
		"Fateli costruire e migliorare adesso: tenete pieno il tesoro di ColonyBucks e il Magazzino di materiali."
	]
	task.2EDBB28F6EF325F0.title: "Il Falegname è al livello 2"
	task.1A51D399FB05A617.title: "Il Tagliapietre è costruito"
	quest.69D32FD2A993AC1D.title: "Gettoni dello Zaino"
	quest.69D32FD2A993AC1D.quest_subtitle: "Il primo spazio in più"
	quest.69D32FD2A993AC1D.quest_desc: [
		"Lo Zaino non si potenzia al banco: slot e alloggiamenti si sbloccano con i &egettoni&r, e i gettoni li lasciano solo i boss."
		"Sconfiggete &6la Naga&r del Bosco del Crepuscolo, il primo boss alla vostra portata: ognuno di voi entro 64 blocchi riceve &e3 gettoni&r la prima volta, &e1&r le successive."
		"&7Costi: &e1 gettone&7 per slot (36 da sbloccare oltre ai 9 iniziali, fino a 9x5); alloggiamenti per potenziamenti &e2/3/4/5&7 gettoni.&r"
		"&7I gettoni sono legati a chi li riceve: non si scambiano.&r"
	]
	quest.69E27EFDA833E830.title: "Una rete di waystone"
	quest.69E27EFDA833E830.quest_subtitle: "Colonia, miniera, portale"
	quest.69E27EFDA833E830.quest_desc: [
		"La &6Pietra di Curvatura&r ora si fa: ametista, piastre di bronzo, perle di ender e uno smeraldo."
		"Waystone: Pietra di Curvatura, mattoni di pietra e ossidiana. &aMettetene una alla colonia e una al portale del Nether.&r"
		"Anche le pergamene di ritorno usano pepite di bronzo."
	]
	quest.298F30E0DDC9A7D4.title: "Compressore a Vapore"
	quest.298F30E0DDC9A7D4.quest_subtitle: "Una piastra per lingotto"
	quest.298F30E0DDC9A7D4.quest_desc: [
		"Il Martello da Forgia chiede 2 lingotti per piastra; il &6Compressore&r solo 1."
		"Con le decine di piastre d'acciaio dell'Altoforno Elettrico, dimezza la fatica."
	]
	quest.3A21B2EB11595CCF.title: "Primo volo"
	quest.3A21B2EB11595CCF.quest_subtitle: "Bronzo che vola"
	quest.3A21B2EB11595CCF.quest_desc: [
		"Gli aerei usano il bronzo: scafo con piastre di bronzo, elica con piastre e rotore di bronzo."
		"Il &6Girodino&r è il più semplice: due vele, due scafi e un'elica, niente motore."
		"Biplano e dirigibile da carico arriveranno con l'acciaio."
	]
	quest.232BDB073C8518B8.title: "Bussola dell'Esploratore"
	quest.232BDB073C8518B8.quest_subtitle: "Trova qualsiasi struttura"
	quest.232BDB073C8518B8.quest_desc: [
		"Piastre d'acciaio, mattoni di pietra crepati e una bussola."
		"Scegli una struttura e la bussola ti guida: funziona anche nel Nether, per esempio per l'&6Arena di Ignis&r."
	]
	quest.39D3FED2C43FAEDD.title: "Il primo alloggiamento"
	quest.39D3FED2C43FAEDD.quest_subtitle: "Gettoni dal fuoco"
	quest.39D3FED2C43FAEDD.quest_desc: [
		"Lo Zaino non si potenzia al banco: slot e alloggiamenti si sbloccano con i &egettoni&r, e i gettoni li lasciano solo i boss."
		"Sconfiggete &6Ignis&r: ognuno di voi entro 64 blocchi riceve &e3 gettoni&r la prima volta, &e1&r le successive."
		"&7Costi: &e1 gettone&7 per slot (36 da sbloccare oltre ai 9 iniziali, fino a 9x5); alloggiamenti per potenziamenti &e2/3/4/5&7 gettoni.&r"
		"&7I gettoni sono legati a chi li riceve: non si scambiano.&r"
	]
	quest.331158139B1824D3.title: "Il primo Telaio"
	quest.331158139B1824D3.quest_subtitle: "Acciaio e legno, lavoro della colonia"
	quest.331158139B1824D3.quest_desc: [
		"Il &6Telaio Strutturale Rinforzato&r non si fa al banco: lo fa il Falegname di livello 2, con 4 piastre d'acciaio e un Timberframe dinamico (Architect's Cutter)."
		"Nel Magazzino, scheda Scorta minima, chiedi il Telaio e metti i materiali negli scaffali. Servirà nell'Era 3."
	]
	quest.2F59137651675CFA.title: "Argento grezzo"
	quest.2F59137651675CFA.quest_subtitle: "Materia prima"
	quest.2F59137651675CFA.quest_desc: [
		"Materia prima da scavare: serve per ottenere i lingotti d'argento, quindi conviene raccoglierne fin da subito."
		"&7Si trova nel mondo: scava, esplora o raccogli."
		"&7Serve per:&r Lingotto d'argento"
	]
	quest.3EF0222290C99FA0.title: "Nichel grezzo"
	quest.3EF0222290C99FA0.quest_subtitle: "Materia prima"
	quest.3EF0222290C99FA0.quest_desc: [
		"Materia prima da scavare: il nichel serve per la polvere di nichel, che entra nella lega invar."
		"&7Si trova nel mondo: scava, esplora o raccogli."
		"&7Serve per:&r Polvere di nichel"
	]
	quest.702B805ABB70918F.title: "Lingotto d'argento"
	quest.702B805ABB70918F.quest_subtitle: "Componente"
	quest.702B805ABB70918F.quest_desc: [
		"Si ottiene fondendo l'argento grezzo in fornace: base per le lastre d'argento."
		"&7Si fa con:&r Fornace"
		"&7Ingredienti:&r 1x Argento grezzo"
		"&7Serve per:&r Lastra d'argento"
	]
	quest.5FFF9BC287BA3C1F.title: "Mattoni"
	quest.5FFF9BC287BA3C1F.quest_subtitle: "Componente"
	quest.5FFF9BC287BA3C1F.quest_desc: [
		"Mattoni di argilla cotta: ne servono in grande quantità per il forno a coke e per la polvere di mattone."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 4x Mattone"
		"&7Serve per:&r Forno a coke"
	]
	quest.5785170EF0AC1F83.title: "Lastra curva di rame"
	quest.5785170EF0AC1F83.quest_subtitle: "Componente"
	quest.5785170EF0AC1F83.quest_desc: [
		"Lastra di rame piegata con il maglio: primo passo per la lama di rame."
		"&7Si fa con:&r Maglio meccanico"
		"&7Ingredienti:&r 1x Lingotto di rame"
		"&7Serve per:&r Lama di rame"
	]
	quest.1FC3887A5FCC3317.title: "Bullone di rame"
	quest.1FC3887A5FCC3317.quest_subtitle: "Componente"
	quest.1FC3887A5FCC3317.quest_desc: [
		"Piccolo componente di rame ricavato al maglio: ne servono parecchi per ingranaggi e rotori."
		"&7Si fa con:&r Maglio meccanico"
		"&7Ingredienti:&r 1x Lingotto di rame"
