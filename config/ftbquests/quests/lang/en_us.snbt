		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 2x Asta di bronzo, 1x Rotore di bronzo, 2x Ingranaggio di bronzo, 1x Carcassa per macchine d'acciaio, 2x Tubo per fluidi, 1x Mattoni di argilla refrattaria"
		"&7Serve per:&r Macinatore d'acciaio, Compressore d'acciaio, Macchina da taglio d'acciaio, Miscelatore d'acciaio"
	]
	quest.624B161AF6A144DD.title: "Bullone di invar"
	quest.624B161AF6A144DD.quest_subtitle: "Componente"
	quest.624B161AF6A144DD.quest_desc: [
		"Bullone di invar tagliato: serve per l'ingranaggio di invar."
		"&7Si fa con:&r Macchina da taglio di bronzo"
		"&7Ingredienti:&r 1x Asta di invar, 1 mB di lubrificante"
		"&7Serve per:&r Ingranaggio di invar"
	]
	quest.60430AA4EAB16A29.title: "Imballatrice d'acciaio"
	quest.60430AA4EAB16A29.quest_subtitle: "Macchina"
	quest.60430AA4EAB16A29.quest_desc: [
		"Macchina che impacchetta i materiali: utile per confezionare le produzioni della linea del vapore."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 2x Tubo per oggetti, 3x Ingranaggio di bronzo, 1x Carcassa per macchine d'acciaio, 3x Tubo per fluidi"
	]
	quest.5B01A22C64B6D4CF.title: "Fonderia di leghe d'acciaio"
	quest.5B01A22C64B6D4CF.quest_subtitle: "Macchina"
	quest.5B01A22C64B6D4CF.quest_desc: [
		"Fonderia per le leghe: serve per le leghe d'acciaio e richiede parecchi componenti, quindi pianificate la costruzione."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 4x Lastra di invar, 1x Rotore di bronzo, 1x Carcassa per macchine d'acciaio, 3x Tubo per fluidi"
	]
	quest.69B96F13AD379C34.title: "Macinatore d'acciaio"
	quest.69B96F13AD379C34.quest_subtitle: "Macchina"
	quest.69B96F13AD379C34.quest_desc: [
		"Versione d'acciaio del macinatore di bronzo, ottenuta potenziandolo."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 1x Macinatore di bronzo, 1x Potenziamento d'acciaio"
	]
	quest.305AA7A157F0B92E.title: "Macchina da taglio d'acciaio"
	quest.305AA7A157F0B92E.quest_subtitle: "Macchina"
	quest.305AA7A157F0B92E.quest_desc: [
		"Versione d'acciaio della macchina da taglio di bronzo, ottenuta potenziandola."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 1x Macchina da taglio di bronzo, 1x Potenziamento d'acciaio"
	]
	quest.2A769DA7AF7B3BA3.title: "Compressore d'acciaio"
	quest.2A769DA7AF7B3BA3.quest_subtitle: "Macchina"
	quest.2A769DA7AF7B3BA3.quest_desc: [
		"Versione d'acciaio del compressore di bronzo, ottenuta potenziandolo."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 1x Compressore di bronzo, 1x Potenziamento d'acciaio"
	]
	quest.618DB4578D6953D4.title: "Miscelatore d'acciaio"
	quest.618DB4578D6953D4.quest_subtitle: "Macchina"
	quest.618DB4578D6953D4.quest_desc: [
		"Versione d'acciaio del miscelatore di bronzo, ottenuta potenziandolo."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 1x Miscelatore di bronzo, 1x Potenziamento d'acciaio"
	]
	quest.1A6350CDEDB8109D.title: "Ingranaggio di invar"
	quest.1A6350CDEDB8109D.quest_subtitle: "Componente"
	quest.1A6350CDEDB8109D.quest_desc: [
		"Ingranaggio di invar: serve per la lama rotante di invar."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 4x Lastra di invar, 4x Bullone di invar, 1x Anello di invar"
		"&7Serve per:&r Lama rotante di invar"
	]
	quest.7BFFF47D9C8F38F4.title: "Lama rotante di invar"
	quest.7BFFF47D9C8F38F4.quest_subtitle: "Componente"
	quest.7BFFF47D9C8F38F4.quest_desc: [
		"Lama rotante per la cava a vapore. Richiede polvere di diamante, quindi preparatela in anticipo."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 4x Polvere di diamante, 1x Ingranaggio di invar"
		"&7Serve per:&r Cava a vapore"
	]
	quest.7D441DA2F7056803.title: "Cava a vapore"
	quest.7D441DA2F7056803.quest_subtitle: "Macchina"
	quest.7D441DA2F7056803.quest_desc: [
		"Cava a vapore: macchina di scavo della linea del vapore, con molti componenti d'acciaio da preparare prima."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 4x Lastra grande d'acciaio, 1x Tubo per oggetti, 2x Ingranaggio d'acciaio, 1x Carcassa per macchine d'acciaio, 1x Lama rotante di invar"
	]
	chapter.516E0B374BDC3226.title: "Era 3 - Elettricità"
	chapter.516E0B374BDC3226.chapter_subtitle: [
		"Dall'Altoforno Elettrico al Controller ME"
	]
	quest.66FAC9B9A5554DA8.title: "La prima scintilla"
	quest.66FAC9B9A5554DA8.quest_subtitle: "Tre fronti per una squadra"
	quest.66FAC9B9A5554DA8.quest_desc: [
		"&7&oL'Altoforno Elettrico è in cortile, ancora spento.&r"
		"Meta dell'Era 3: il &6Controller ME&r. Chiede 2 Circuiti Elettronici, un &6Nucleo Meccanico&r della colonia, pietra celeste, cristalli di fluix e le &cCorna Mostruose&r del Mostro di Netherite."
		"&aDividetevi: industria, colonia e spedizione nel Nether.&r"
	]
	task.23FBAC3DC199D043.title: "Abbiamo deciso chi fa cosa"
	quest.7F84BB50A05831DD.title: "Gomma sintetica"
	quest.7F84BB50A05831DD.quest_subtitle: "Senza isolante niente cavi"
	quest.7F84BB50A05831DD.quest_desc: [
		"&7&oUn odore di catrame invade l'officina.&r"
		"Nel &6Miscelatore di Bronzo&r: polvere di coke e acqua danno olio sintetico grezzo."
		"Raffinalo nell'Altoforno a Vapore, poi di nuovo nel Miscelatore con carta: &6fogli di gomma&r."
	]
	quest.6F65708CBD373438.title: "Fili e cavi"
	quest.6F65708CBD373438.quest_subtitle: "Le vene dell'elettricità"
	quest.6F65708CBD373438.quest_desc: [
		"&7&oMatasse di filo pendono dalle travi del laboratorio.&r"
		"La &6Trafila d'Acciaio&r trasforma piastre di rame e stagno in fili."
		"Cavo di stagno: 3 fili tra 6 fogli di gomma. È il cavo dell'energia a bassa tensione (LV)."
	]
	quest.6F8461DFE14DD3F6.title: "Circuito Analogico"
	quest.6F8461DFE14DD3F6.quest_subtitle: "Il cervello di ogni macchina LV"
	quest.6F8461DFE14DD3F6.quest_desc: [
		"&7&oIl primo circuito si accende al primo colpo. Quasi.&r"
		"Scheda: piastra di rame tra due fogli di gomma."
		"Sopra: 2 resistori (fili sottili di rame, polvere di carbone, carta), 2 condensatori (piastre d'oro, fili, gomma), un induttore (fili attorno a un'asta d'acciaio) e 3 fili di rame."
	]
	quest.75A44004A51143EC.title: "Scafo di macchina base"
	quest.75A44004A51143EC.quest_subtitle: "Batteria, circuito, cavi"
	quest.75A44004A51143EC.quest_desc: [
		"&7&oUn guscio d'acciaio pronto a ricevere corrente.&r"
		"&6Batteria di redstone&r: lega per batterie (piombo e antimonio) e redstone, con un cavo di stagno."
		"Scafo: Involucro d'Acciaio, 2 batterie, un Circuito Analogico e 3 cavi di stagno. &aOgni macchina elettrica ne chiede uno.&r"
	]
	quest.66D9FF9D23CEBC47.title: "Turbina a Vapore"
	quest.66D9FF9D23CEBC47.quest_subtitle: "Il vapore diventa corrente"
	quest.66D9FF9D23CEBC47.quest_desc: [
		"&7&oLa colonia vede la prima lampadina accesa.&r"
		"Motore: asta d'acciaio magnetica (asta e 8 redstone al banco), aste d'acciaio, fili di rame, cavi di stagno."
		"Turbina LV: scafo, circuito, 2 motori, rotori di stagno e tubi. Portale il vapore delle caldaie e collega i cavi."
	]
	quest.4E0B9FF0717EBACE.title: "Macchine elettriche"
	quest.4E0B9FF0717EBACE.quest_subtitle: "Più veloci del vapore"
	quest.4E0B9FF0717EBACE.quest_desc: [
		"&7&oLe macine a vapore vanno in pensione.&r"
		"Ogni macchina elettrica parte da uno scafo: la ricetta è nel libro guida e in JEI."
		"&6Miscelatore&r per invar (ferro e nichel) e cupronichel (rame e nichel), &6Macinatore&r per raddoppiare i minerali."
	]
	quest.59B5F8101D175B7D.title: "Accendere l'Altoforno"
	quest.59B5F8101D175B7D.quest_subtitle: "Bobine, involucri, corrente"
	quest.59B5F8101D175B7D.quest_desc: [
		"&7&oIl cuore di Ignis comincia a scaldarsi.&r"
		"Involucro resistente al calore: 8 piastre d'invar e un ingranaggio d'invar. Bobina: 8 cavi di cupronichel."
		"Serve anche un &6portello d'ingresso energia LV&r. Con la Chiave inglese in mano l'ologramma mostra dove va tutto."
	]
	task.7B29ECD087F69EBE.title: "L'Altoforno Elettrico è formato e acceso"
	quest.2ADD2C6F51DB87DB.title: "Silicio"
	quest.2ADD2C6F51DB87DB.quest_subtitle: "Sabbia di quarzo e coke"
	quest.2ADD2C6F51DB87DB.quest_desc: [
		"&7&oDal forno esce una polvere grigia e lucente.&r"
		"Nell'Altoforno Elettrico: polvere di quarzo e polvere di coke danno polvere di silicio."
		"Cuocila in fornace e pressala in &6piastre di silicio&r."
	]
	quest.140BEE1022271C78.title: "Alluminio"
	quest.140BEE1022271C78.quest_subtitle: "Il metallo leggero"
	quest.140BEE1022271C78.quest_desc: [
		"&7&oI minatori tornano con sacchi di terra rossa.&r"
		"La &6bauxite&r si trova in profondità. Macinala, compatta la polvere in blocchi e cuocili nell'Altoforno Elettrico."
		"Il forno è lento: &atenetelo sempre acceso&r."
	]
	quest.77C578BF67610D90.title: "Scheda Elettronica"
	quest.77C578BF67610D90.quest_subtitle: "Alluminio ed elettro"
	quest.77C578BF67610D90.quest_desc: [
		"&7&oLa scheda nuova pesa la metà e conduce il doppio.&r"
		"3 piastre d'alluminio, 4 cavi d'elettro (oro e argento nel Miscelatore), una scheda analogica e una batteria di redstone."
	]
	quest.5B9B3EAF057F2658.title: "Transistor e diodi"
	quest.5B9B3EAF057F2658.quest_subtitle: "Silicio, acciaio ed elettro"
	quest.5B9B3EAF057F2658.quest_desc: [
		"&7&oPezzi minuscoli, mani ferme.&r"
		"Transistor: filo sottile d'elettro, 3 piastre d'acciaio e 3 di silicio."
		"Diodo: fili sottili d'elettro, piastre d'acciaio, una di silicio e vetro."
	]
	quest.4C739B46BF475458.title: "Circuito Elettronico"
	quest.4C739B46BF475458.quest_subtitle: "Due per il Controller"
	quest.4C739B46BF475458.quest_desc: [
		"&7&oIl circuito più complesso mai visto a NeroCraft.&r"
		"Scheda elettronica, 4 Circuiti Analogici, 2 transistor e 2 diodi."
		"Al Controller ME ne servono &62&r."
	]
	quest.1CAD9E4040BBE0AD.title: "Officina del Meccanico"
	quest.1CAD9E4040BBE0AD.quest_subtitle: "La colonia entra nell'era elettrica"
	quest.1CAD9E4040BBE0AD.quest_desc: [
		"&7&oUn colono chiede una chiave inglese e un grembiule.&r"
		"Il &6Meccanico&r di livello 3 è l'unico che sa montare il Nucleo Meccanico, pezzo del Controller ME."
		"Costruitelo e migliorateci sopra: tenete pieno il Magazzino."
	]
	task.21A5E4CF9702B4B3.title: "Il Meccanico è al livello 3"
	quest.73A94075A948BE02.title: "Nucleo Meccanico"
	quest.73A94075A948BE02.quest_subtitle: "Lavoro della colonia"
	quest.73A94075A948BE02.quest_desc: [
		"&7&oIl Meccanico lo gira tra le mani: funziona.&r"
		"Non si fa al banco. Il Meccanico usa 2 motori, 2 ingranaggi d'acciaio, 2 Circuiti Analogici e 4 redstone."
		"Nel Magazzino, scheda Scorta minima, chiedi il Nucleo e metti i materiali negli scaffali."
	]
	quest.31C6971FAEFC2A7C.title: "Involucro Avanzato"
	quest.31C6971FAEFC2A7C.quest_subtitle: "Il Telaio della colonia serve qui"
	quest.31C6971FAEFC2A7C.quest_desc: [
		"Piastre d'acciaio, 2 Circuiti Analogici, 2 cavi di stagno e un &6Telaio Strutturale Rinforzato&r del Falegname."
		"Base delle macchine a media tensione (MV)."
	]
	quest.7A4B189F9B9CA173.title: "Pietra celeste"
	quest.7A4B189F9B9CA173.quest_subtitle: "Un meteorite nella foresta"
	quest.7A4B189F9B9CA173.quest_desc: [
		"&7&oUn cratere fumante a nord della colonia.&r"
		"Metti una bussola nel &6Caricatore&r di AE2 (girando la manovella): diventa una bussola dei meteoriti."
		"Nel meteorite: &6pietra celeste&r e quarzo certus. Cuoci la pietra: il Controller chiede 4 blocchi lisci."
	]
	quest.47EA1246C253207E.title: "Cristalli di fluix"
	quest.47EA1246C253207E.quest_subtitle: "Quarzo, redstone e acqua"
	quest.47EA1246C253207E.quest_desc: [
		"&7&oL'acqua della fontana brilla di viola.&r"
		"Carica il quarzo certus nel Caricatore. Gettalo in acqua con redstone e quarzo del Nether: &6cristalli di fluix&r."
		"Ne basta uno per il Controller, ma la rete ME ne mangerà molti."
	]
	quest.1D4227297404A6F2.title: "Occhio del Mostruoso"
	quest.1D4227297404A6F2.quest_subtitle: "Una bussola per la fucina"
	quest.1D4227297404A6F2.quest_desc: [
		"&7&oDi nuovo nel Nether, stavolta per qualcosa di peggio.&r"
		"4 secchi di lava, 2 frammenti di netherite, 2 pietre nere e un occhio di ender."
		"Lanciato come un occhio di ender, indica il &6Fabbro dell'anima&r, la fucina del Mostro di Netherite."
	]
	quest.277087AF85AEED7F.title: "Il Fabbro dell'anima"
	quest.277087AF85AEED7F.quest_subtitle: "Dove il mostro viene forgiato"
	quest.277087AF85AEED7F.quest_desc: [
		"&7&oUna fucina enorme, ancora calda, in fondo a una valle di anime.&r"
		"Seguite l'Occhio fino alla struttura e &asegnate la posizione&r: una waystone qui risparmia lunghe camminate."
	]
	quest.6E230D7DA65B6855.title: "Squadra contro il Mostro"
	quest.6E230D7DA65B6855.quest_subtitle: "Netherite contro netherite"
	quest.6E230D7DA65B6855.quest_desc: [
		"&7&oPiù grosso di Ignis, più duro, più arrabbiato.&r"
		"Il &cMostro di Netherite&r è pensato per tutta la squadra: &adecidete chi incassa, chi cura e chi colpisce da lontano&r."
		"&cÈ più forte di Ignis e cresce con le ere e a ogni uccisione.&r Armature rinforzate, cibo, pozioni di resistenza al fuoco."
	]
	task.4899F75143EAC3BD.title: "Ruoli decisi, equipaggiamento pronto"
	quest.107C693EA8ECA022.title: "Il Mostro di Netherite"
	quest.107C693EA8ECA022.quest_subtitle: "Le corna che aprono la rete"
	quest.107C693EA8ECA022.quest_desc: [
		"&7&oIl giorno in cui NeroCraft spense la fucina.&r"
		"Il Mostro fa la guardia al Fabbro dell'anima: &acombattete insieme&r."
		"Lascia le &6Corna Mostruose&r: una serve al Controller ME, il resto nelle casse comuni."
		"&6Gettoni:&r ogni giocatore entro 64 blocchi riceve &e3 gettoni&r alla prima uccisione di questo boss, &e1&r alle successive."
	]
	quest.749332DA6AB9A38D.title: "&6&lController ME&r"
	quest.749332DA6AB9A38D.quest_subtitle: "Il cuore della rete apre l'Era 4"
	quest.749332DA6AB9A38D.quest_desc: [
		"&7&oCorna di un mostro, un nucleo della colonia, circuiti dell'officina.&r"
		"Al banco: &6Corna Mostruose&r al centro, 2 Circuiti Elettronici ai lati, Nucleo Meccanico sotto, cristallo di fluix sopra, 4 blocchi lisci di pietra celeste negli angoli."
		"Appena qualcuno lo ottiene, &atutta la squadra entra nell'Era 4&r."
	]
	quest.165D937B42D83BF6.title: "Zaino più capiente"
	quest.165D937B42D83BF6.quest_subtitle: "Gettoni dal Nether"
	quest.165D937B42D83BF6.quest_desc: [
		"Lo Zaino non si potenzia al banco: slot e alloggiamenti si sbloccano con i &egettoni&r, e i gettoni li lasciano solo i boss."
		"Sconfiggete &6la Netherite Monstrosity&r: ognuno di voi entro 64 blocchi riceve &e3 gettoni&r la prima volta, &e1&r le successive."
		"&7Costi: &e1 gettone&7 per slot (36 da sbloccare oltre ai 9 iniziali, fino a 9x5); alloggiamenti per potenziamenti &e2/3/4/5&7 gettoni.&r"
		"&7I gettoni sono legati a chi li riceve: non si scambiano.&r"
	]
	quest.29F80C1B18FA9C3E.title: "Roccia del cielo"
	quest.29F80C1B18FA9C3E.quest_subtitle: "Materia prima"
	quest.29F80C1B18FA9C3E.quest_desc: [
		"Blocco da costruzione che trovate nel mondo."
		"&7Si trova nel mondo: scava, esplora o raccogli."
		"&7Serve per:&r Blocco di roccia del cielo"
	]
	quest.163195142809C021.title: "Piombo grezzo"
	quest.163195142809C021.quest_subtitle: "Materia prima"
	quest.163195142809C021.quest_desc: [
		"Minerale da raccogliere e poi macinare in polvere."
		"&7Si trova nel mondo: scava, esplora o raccogli."
		"&7Serve per:&r Polvere di piombo"
	]
	quest.40C04CEA21633275.title: "Antimonio grezzo"
	quest.40C04CEA21633275.quest_subtitle: "Materia prima"
	quest.40C04CEA21633275.quest_desc: [
		"Minerale da raccogliere e poi macinare in polvere."
		"&7Si trova nel mondo: scava, esplora o raccogli."
		"&7Serve per:&r Polvere di antimonio"
	]
	quest.1FEE245063A6C7B2.title: "Minerale di bauxite"
	quest.1FEE245063A6C7B2.quest_subtitle: "Materia prima"
	quest.1FEE245063A6C7B2.quest_desc: [
		"Minerale dell'alluminio: va macinato prima di essere lavorato."
		"&7Si trova nel mondo: scava, esplora o raccogli."
		"&7Serve per:&r Polvere di bauxite frantumata"
	]
	quest.2EA9CD73742A530B.title: "Caricatore"
	quest.2EA9CD73742A530B.quest_subtitle: "Macchina"
	quest.2EA9CD73742A530B.quest_desc: [
		"Macchina che carica il cristallo di quarzo certus per la strada verso AE2."
		"&7Si fa con:&r Banco da lavoro"
		"&7Ingredienti:&r 5x Lingotto di ferro, 2x Lingotto di rame"
		"&7Serve per:&r Cristallo di quarzo certus carico"
	]
	quest.2AE5F8B106C58A7E.title: "Cristallo di quarzo certus carico"
	quest.2AE5F8B106C58A7E.quest_subtitle: "Componente"
	quest.2AE5F8B106C58A7E.quest_desc: [
		"Cristallo caricato nel Caricatore: serve per il cristallo di Fluix di AE2."
		"&7Si fa con:&r Caricatore"
		"&7Ingredienti:&r 1x Cristallo di quarzo certus"
		"&7Serve per:&r Cristallo di Fluix"
	]
	quest.15B124ECFC684F24.title: "Polvere d'oro"
	quest.15B124ECFC684F24.quest_subtitle: "Componente"
	quest.15B124ECFC684F24.quest_desc: [
		"Polvere ottenuta battendo l'oro grezzo."
		"&7Si fa con:&r Martello da fucina"
		"&7Ingredienti:&r 1x Oro grezzo"
		"&7Serve per:&r Polvere di elettro"
	]
	quest.6EFE2E9D8ACF67AF.title: "Piastra d'oro"
	quest.6EFE2E9D8ACF67AF.quest_subtitle: "Componente"
	quest.6EFE2E9D8ACF67AF.quest_desc: [
		"Lamina d'oro ricavata dal lingotto, usata nei condensatori."
		"&7Si fa con:&r Martello da fucina"
		"&7Ingredienti:&r 1x Lingotto d'oro"
		"&7Serve per:&r Condensatore"
	]
	quest.257EAA29A716B903.title: "Anello di stagno"
	quest.257EAA29A716B903.quest_subtitle: "Componente"
	quest.257EAA29A716B903.quest_desc: [
		"Componente facoltativo per rotori e ingranaggi di stagno."
		"&7Si fa con:&r Martello da fucina"
		"&7Ingredienti:&r 1x Lingotto di stagno"
		"&7Serve per:&r Rotore di stagno, Ingranaggio di stagno"
	]
	quest.4018A93A3519B371.title: "Asta di stagno"
	quest.4018A93A3519B371.quest_subtitle: "Componente"
